<%- include('../../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-[#F0ECE1] shadow-lg space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mx-auto shadow-xs">
        <i data-lucide="key-round" class="w-6 h-6"></i>
      </div>
      <h1 class="font-display text-2xl font-bold text-gray-900">Reset Password</h1>
      <p class="text-xs sm:text-sm text-gray-500">Enter your registered email address to receive password recovery instructions.</p>
    </div>

    <form action="/auth/forgot-password" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Email Address</label>
        <div class="relative">
          <input 
            type="email" 
            name="email" 
            required 
            placeholder="you@domain.com"
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"
          >
          <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <button type="submit" class="w-full py-3.5 rounded-2xl btn-gold text-sm font-bold shadow-md hover:shadow-lg transition-all">
        Send Reset Link
      </button>
    </form>

    <div class="pt-4 border-t border-gray-100 text-center text-xs text-gray-500">
      Remembered your password? 
      <a href="/auth/login" class="font-bold text-amber-700 hover:text-amber-800 ml-1">Return to login</a>
    </div>

  </div>
</div>

<%- include('../../partials/footer') %>
