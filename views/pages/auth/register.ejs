<%- include('../../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-[#F0ECE1] shadow-lg space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mx-auto shadow-xs">
        <i data-lucide="sparkles" class="w-6 h-6"></i>
      </div>
      <h1 class="font-display text-2xl font-bold text-gray-900">Create Member Account</h1>
      <p class="text-xs sm:text-sm text-gray-500">Join the Thai Wares & Fashion Exchange Community</p>
    </div>

    <form action="/auth/register" method="POST" enctype="multipart/form-data" class="space-y-4">
      
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Full Name <span class="text-rose-500">*</span></label>
        <div class="relative">
          <input 
            type="text" 
            name="name" 
            required 
            placeholder="Somchai Prasert"
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"
          >
          <i data-lucide="user" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Email Address <span class="text-rose-500">*</span></label>
        <div class="relative">
          <input 
            type="email" 
            name="email" 
            required 
            placeholder="somchai@example.com"
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"
          >
          <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Phone Number</label>
        <div class="relative">
          <input 
            type="tel" 
            name="phone" 
            placeholder="+66 81 234 5678"
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900"
          >
          <i data-lucide="phone" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Password <span class="text-rose-500">*</span></label>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            required 
            minlength="6"
            placeholder="Minimum 6 characters"
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"
          >
          <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Profile Photo (Optional)</label>
        <input 
          type="file" 
          name="profileImage" 
          accept="image/*"
          class="w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800"
        >
      </div>

      <button type="submit" class="w-full py-3.5 rounded-2xl btn-gold text-sm font-bold shadow-md hover:shadow-lg transition-all mt-2">
        Create Account
      </button>
    </form>

    <div class="pt-4 border-t border-gray-100 text-center text-xs text-gray-500">
      Already have an account? 
      <a href="/auth/login" class="font-bold text-amber-700 hover:text-amber-800 ml-1">Sign in here</a>
    </div>

  </div>
</div>

<%- include('../../partials/footer') %>
