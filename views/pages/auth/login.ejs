<%- include('../../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200 shadow-lg space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-gray-100 text-gray-900 flex items-center justify-center mx-auto shadow-xs">
        <i data-lucide="lock" class="w-6 h-6"></i>
      </div>
      <h1 class="font-display text-2xl font-extrabold text-gray-900">Welcome Back</h1>
      <p class="text-xs sm:text-sm text-gray-500">Sign in to Styleswap</p>
    </div>

    <form action="/auth/login" method="POST" class="space-y-4">
      <% if (typeof redirect !== 'undefined' && redirect) { %>
        <input type="hidden" name="redirect" value="<%= redirect %>">
      <% } %>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Email Address</label>
        <div class="relative">
          <input 
            type="email" 
            name="email" 
            id="login-email"
            required 
            placeholder="you@domain.com"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
          >
          <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Password</label>
          <a href="/auth/forgot-password" class="text-xs font-bold text-gray-600 hover:text-black">Forgot?</a>
        </div>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            id="login-password"
            required 
            placeholder="••••••••"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
          >
          <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <button type="submit" class="w-full py-3.5 rounded-2xl bg-gray-900 hover:bg-black text-white text-sm font-bold shadow-md hover:shadow-lg transition-all mt-2">
        Sign In
      </button>
    </form>

    <div class="pt-4 border-t border-gray-100 text-center text-xs text-gray-500">
      Don't have an account yet? 
      <a href="/auth/register" class="font-bold text-gray-900 hover:underline ml-1">Create free account</a>
    </div>

  </div>
</div>

<%- include('../../partials/footer') %>
