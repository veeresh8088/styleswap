<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Dashboard Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between pb-8 mb-8 border-b border-gray-200 gap-4">
    <div class="flex items-center space-x-4">
      <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="<%= user.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-300 shadow-xs">
      <div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900"><%= user.name %>'s Wardrobe</h1>
        <p class="text-xs sm:text-sm text-gray-500"><%= user.email %> • <%= user.address && user.address.city ? user.address.city + ', ' + user.address.province : 'India' %> • Member since <%= new Date(user.createdAt).getFullYear() %></p>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <a href="/user/profile" class="px-4 py-2.5 rounded-full bg-white border border-gray-300 text-xs font-bold text-gray-700 hover:bg-gray-50 shadow-xs flex items-center gap-1.5">
        <i data-lucide="user-cog" class="w-4 h-4 text-gray-500"></i> Profile & Address
      </a>
      <a href="/listings/create" class="px-5 py-2.5 rounded-full bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-xs flex items-center gap-1.5">
        <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i> + Post New Item
      </a>
    </div>
  </div>

  <!-- Metric Counters Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-8">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Total Listed</span>
      <span class="text-2xl font-extrabold font-display text-gray-900"><%= stats.totalListings %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider block">Active Online</span>
      <span class="text-2xl font-extrabold font-display text-emerald-700"><%= stats.activeListings %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider block">Swap Requests</span>
      <span class="text-2xl font-extrabold font-display text-indigo-700"><%= stats.pendingIncomingExchanges %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-gray-600 uppercase tracking-wider block">Sold Items</span>
      <span class="text-2xl font-extrabold font-display text-gray-800"><%= stats.soldItems %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-purple-600 uppercase tracking-wider block">Swapped</span>
      <span class="text-2xl font-extrabold font-display text-purple-700"><%= stats.exchangedItems %></span>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="flex items-center space-x-2 border-b border-gray-200 mb-8 overflow-x-auto pb-1">
    <a href="#listings" data-tab="listings" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="tag" class="w-4 h-4"></i> My Listings (<%= myListings.length %>)
    </a>
    <a href="#exchanges" data-tab="exchanges" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="repeat" class="w-4 h-4"></i> Swap Proposals 
      <% if (stats.pendingIncomingExchanges > 0) { %>
        <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-[10px] flex items-center justify-center font-mono">
          <%= stats.pendingIncomingExchanges %>
        </span>
      <% } %>
    </a>
    <a href="#orders" data-tab="orders" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="shopping-bag" class="w-4 h-4"></i> Purchases in ₹ (<%= purchases.length %>)
    </a>
    <a href="#sales" data-tab="sales" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="receipt" class="w-4 h-4"></i> Sales in ₹ (<%= sales.length %>)
    </a>
  </div>

  <!-- Tab 1: My Listings Pane -->
  <div id="tab-listings" class="dashboard-tab-pane space-y-6">
    <% if (myListings && myListings.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% myListings.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden flex flex-col justify-between shadow-xs">
            <div>
              <div class="relative aspect-[4/3] bg-gray-100">
                <img src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" alt="<%= item.title %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-xs
                    <%= item.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : '' %>
                    <%= item.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                    <%= item.status === 'sold' ? 'bg-gray-800 text-white' : '' %>
                    <%= item.status === 'exchanged' ? 'bg-purple-100 text-purple-800' : '' %>
                    <%= item.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                  ">
                    <%= item.status %>
                  </span>
                </div>
              </div>
              <div class="p-4 space-y-2">
                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider"><%= item.category ? item.category.name : 'Thrift' %></span>
                <h3 class="font-bold text-gray-900 text-sm line-clamp-1"><%= item.title %></h3>
                <p class="text-xs font-extrabold text-gray-900">
                  <% if (item.type === 'exchange') { %>
                    <span class="text-indigo-700">Swap Only</span>
                  <% } else { %>
                    ₹<%= Number(item.price).toLocaleString('en-IN') %>
                  <% } %>
                </p>
              </div>
            </div>
            <div class="p-4 pt-0 border-t border-gray-100 flex items-center justify-between gap-2 mt-2">
              <a href="/listings/<%= item._id %>" class="text-xs font-bold text-gray-600 hover:text-black">View</a>
              <div class="flex items-center space-x-2">
                <a href="/listings/<%= item._id %>/edit" class="text-xs font-bold text-gray-900 bg-gray-100 px-2.5 py-1.5 rounded-lg hover:bg-gray-200">Edit</a>
                <form action="/listings/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this listing?');">
                  <button type="submit" class="text-xs font-bold text-rose-600 bg-rose-50 px-2.5 py-1.5 rounded-lg hover:bg-rose-100">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl p-12 text-center border border-gray-200 shadow-xs">
        <p class="text-sm font-bold text-gray-700">You haven't listed any items from your wardrobe yet.</p>
        <a href="/listings/create" class="inline-flex items-center px-6 py-2.5 rounded-full bg-gray-900 text-white text-xs font-bold mt-4">
          + Post Your First Item
        </a>
      </div>
    <% } %>
  </div>

  <!-- Tab 2: Exchange Proposals Pane -->
  <div id="tab-exchanges" class="dashboard-tab-pane hidden space-y-10">
    
    <!-- Incoming Exchange Proposals -->
    <div class="space-y-4">
      <h2 class="font-display text-xl font-extrabold text-gray-900 flex items-center gap-2">
        <i data-lucide="inbox" class="w-5 h-5 text-indigo-600"></i>
        Incoming Swap Offers (For Your Items)
      </h2>

      <% if (incomingExchanges && incomingExchanges.length > 0) { %>
        <div class="space-y-4">
          <% incomingExchanges.forEach(exch => { %>
            <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-2">
                <div class="flex items-center space-x-3">
                  <img src="<%= exch.buyerId ? (exch.buyerId.profileImage || '/images/default-avatar.png') : '/images/default-avatar.png' %>" alt="" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                  <div>
                    <p class="text-sm font-bold text-gray-900"><%= exch.buyerId ? exch.buyerId.name : 'Member' %> proposed an item swap</p>
                    <p class="text-xs text-gray-400"><%= new Date(exch.createdAt).toLocaleString('en-IN') %></p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <% if (exch.cashTopUp && exch.cashTopUp > 0) { %>
                    <span class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-800 flex items-center gap-1 shadow-xs">
                      <i data-lucide="banknote" class="w-3.5 h-3.5 text-emerald-600"></i>
                      + ₹<%= Number(exch.cashTopUp).toLocaleString('en-IN') %> Cash Top-Up
                    </span>
                  <% } %>
                  <span class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider
                    <%= exch.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                    <%= exch.status === 'completed' || exch.status === 'accepted' ? 'bg-emerald-100 text-emerald-800' : '' %>
                    <%= exch.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                  ">
                    <%= exch.status %>
                  </span>
                </div>
              </div>

              <!-- Trade Comparison Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-2xl border border-gray-200 items-center">
                <!-- Offered Item -->
                <div class="flex items-center space-x-3">
                  <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                    <img src="<%= exch.exchangeItemId && exch.exchangeItemId.images ? exch.exchangeItemId.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  </div>
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 block">Offered to you</span>
                    <p class="text-xs font-bold text-gray-900"><%= exch.exchangeItemId ? exch.exchangeItemId.title : 'Listing removed' %></p>
                    <p class="text-[11px] text-gray-500">Condition: <%= exch.exchangeItemId ? exch.exchangeItemId.condition : 'N/A' %></p>
                    <% if (exch.cashTopUp && exch.cashTopUp > 0) { %>
                      <p class="text-[11px] font-bold text-emerald-700 mt-0.5">+ Extra Cash: ₹<%= Number(exch.cashTopUp).toLocaleString('en-IN') %></p>
                    <% } %>
                  </div>
                </div>

                <!-- Your Item -->
                <div class="flex items-center space-x-3 sm:border-l sm:border-gray-200 sm:pl-4">
                  <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                    <img src="<%= exch.listingId && exch.listingId.images ? exch.listingId.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  </div>
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-600 block">In exchange for your item</span>
                    <p class="text-xs font-bold text-gray-900"><%= exch.listingId ? exch.listingId.title : 'Listing removed' %></p>
                  </div>
                </div>
              </div>

              <% if (exch.notes) { %>
                <p class="text-xs text-gray-600 italic bg-white p-3 rounded-xl border border-gray-100">
                  "<%= exch.notes %>"
                </p>
              <% } %>

              <!-- Response Actions -->
              <div class="pt-2 flex items-center justify-end space-x-3">
                <% if (exch.status === 'pending') { %>
                  <form action="/transactions/<%= exch._id %>/respond" method="POST">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-colors">
                      Decline Swap
                    </button>
                  </form>

                  <form action="/transactions/<%= exch._id %>/respond" method="POST">
                    <input type="hidden" name="action" value="accept">
                    <button type="submit" class="px-5 py-2 rounded-xl bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-xs">
                      Accept & Confirm Swap
                    </button>
                  </form>
                <% } else if (exch.status === 'completed' || exch.status === 'accepted') { %>
                  <a href="/checkout/success/<%= exch._id %>" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-900 text-xs font-bold flex items-center gap-1.5 transition-colors">
                    <i data-lucide="receipt" class="w-3.5 h-3.5 text-gray-600"></i> View Swap Receipt
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-3xl p-8 text-center border border-gray-200">
          <p class="text-xs font-semibold text-gray-500">No incoming swap offers yet.</p>
        </div>
      <% } %>
    </div>

    <!-- Outgoing Exchange Proposals -->
    <div class="space-y-4 pt-6 border-t border-gray-200">
      <h2 class="font-display text-xl font-extrabold text-gray-900 flex items-center gap-2">
        <i data-lucide="send" class="w-5 h-5 text-indigo-600"></i>
        Outgoing Swap Offers (You Proposed)
      </h2>

      <% if (outgoingExchanges && outgoingExchanges.length > 0) { %>
        <div class="space-y-4">
          <% outgoingExchanges.forEach(exch => { %>
            <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center space-x-4">
                <div class="w-14 h-14 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                  <img src="<%= exch.listingId && exch.listingId.images ? exch.listingId.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                </div>
                <div>
                  <p class="text-xs text-gray-400">Target Item: <span class="font-bold text-gray-900"><%= exch.listingId ? exch.listingId.title : 'Removed' %></span></p>
                  <p class="text-xs text-gray-500">You offered: <span class="font-semibold text-indigo-700"><%= exch.exchangeItemId ? exch.exchangeItemId.title : 'Removed' %></span></p>
                </div>
              </div>
              <div class="flex items-center gap-2.5">
                <% if (exch.cashTopUp && exch.cashTopUp > 0) { %>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800">
                    + ₹<%= Number(exch.cashTopUp).toLocaleString('en-IN') %> Top-up
                  </span>
                <% } %>
                <span class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider
                  <%= exch.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                  <%= exch.status === 'completed' || exch.status === 'accepted' ? 'bg-emerald-100 text-emerald-800' : '' %>
                  <%= exch.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                ">
                  <%= exch.status %>
                </span>
                <% if (exch.status === 'accepted') { %>
                  <a href="/checkout/swap/<%= exch._id %>" class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1 shadow-xs transition-colors">
                    <i data-lucide="truck" class="w-3.5 h-3.5"></i> Pay Courier
                  </a>
                <% } else if (exch.status === 'completed') { %>
                  <a href="/checkout/success/<%= exch._id %>" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold flex items-center gap-1 transition-colors">
                    <i data-lucide="receipt" class="w-3.5 h-3.5"></i> Receipt
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-3xl p-8 text-center border border-gray-200">
          <p class="text-xs font-semibold text-gray-500">You haven't sent any swap proposals yet.</p>
        </div>
      <% } %>
    </div>

  </div>

  <!-- Tab 3: Purchases (Orders in ₹) Pane -->
  <div id="tab-orders" class="dashboard-tab-pane hidden space-y-4">
    <% if (purchases && purchases.length > 0) { %>
      <div class="space-y-4">
        <% purchases.forEach(order => { %>
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-2xl overflow-hidden bg-gray-100 flex-shrink-0">
                <img src="<%= order.listingId && order.listingId.images ? order.listingId.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
              </div>
              <div>
                <div class="flex items-center space-x-2 mb-1">
                  <span class="text-xs font-bold text-gray-900 bg-gray-100 px-2.5 py-0.5 rounded">Order #<%= order._id.toString().slice(-6).toUpperCase() %></span>
                  <span class="text-xs text-gray-400"><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></span>
                </div>
                <h3 class="font-bold text-gray-900 text-sm"><%= order.listingId ? order.listingId.title : 'Item no longer active' %></h3>
                <p class="text-xs text-gray-500">Seller: <%= order.sellerId ? order.sellerId.name : 'Unknown' %></p>
              </div>
            </div>
            <div class="text-right space-y-1.5">
              <span class="text-lg font-extrabold text-gray-900 block">₹<%= Number(order.totalPaid || order.amount).toLocaleString('en-IN') %></span>
              <div class="flex items-center justify-end gap-2">
                <span class="inline-block text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
                  <%= order.paymentMethod || 'UPI' %>
                </span>
                <a href="/checkout/success/<%= order._id %>" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-0.5 rounded-full transition-colors">
                  <i data-lucide="receipt" class="w-3 h-3"></i> Receipt
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl p-12 text-center border border-gray-200">
        <p class="text-xs font-semibold text-gray-500">You have not purchased any items yet.</p>
        <a href="/listings" class="inline-flex items-center px-6 py-2.5 rounded-full bg-gray-900 text-white text-xs font-bold mt-4">
          Browse Thrift Collection
        </a>
      </div>
    <% } %>
  </div>

  <!-- Tab 4: Sales in ₹ Pane -->
  <div id="tab-sales" class="dashboard-tab-pane hidden space-y-4">
    <% if (sales && sales.length > 0) { %>
      <div class="space-y-4">
        <% sales.forEach(sale => { %>
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-2xl overflow-hidden bg-gray-100 flex-shrink-0">
                <img src="<%= sale.listingId && sale.listingId.images ? sale.listingId.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
              </div>
              <div>
                <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded mb-1 inline-block">Sold</span>
                <h3 class="font-bold text-gray-900 text-sm"><%= sale.listingId ? sale.listingId.title : 'Item' %></h3>
                <p class="text-xs text-gray-500">Buyer: <%= sale.buyerId ? sale.buyerId.name : 'Unknown' %> (<%= sale.buyerId ? sale.buyerId.email : '' %>)</p>
                <% if (sale.deliveryAddress) { %>
                  <p class="text-xs text-gray-400 mt-1">Ship to: <%= sale.deliveryAddress %></p>
                <% } %>
              </div>
            </div>
            <div class="text-right">
              <span class="text-lg font-extrabold text-emerald-700 block">+₹<%= Number(sale.amount).toLocaleString('en-IN') %></span>
              <span class="text-xs text-gray-400"><%= new Date(sale.createdAt).toLocaleDateString('en-IN') %></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl p-12 text-center border border-gray-200">
        <p class="text-xs font-semibold text-gray-500">No sales completed yet.</p>
      </div>
    <% } %>
  </div>

</div>

<%- include('../../partials/footer') %>
