<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Dashboard Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between pb-8 mb-8 border-b border-gray-200 gap-4">
    <div class="flex items-center space-x-4">
      <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="<%= user.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-300 shadow-xs">
      <div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900"><%= user.name %>'s Wardrobe</h1>
        <p class="text-xs sm:text-sm text-gray-500"><%= user.email %> • <%= user.address && user.address.city ? user.address.city + ', ' + user.address.province : 'India' %> • Member since <%= new Date(user.createdAt).getFullYear() %></p>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <a href="/user/profile" class="px-4 py-2.5 rounded-full bg-white border border-gray-300 text-xs font-bold text-gray-700 hover:bg-gray-50 shadow-xs flex items-center gap-1.5">
        <i data-lucide="user-cog" class="w-4 h-4 text-gray-500"></i> Profile & Address
      </a>
      <a href="/listings/create" class="px-5 py-2.5 rounded-full bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-xs flex items-center gap-1.5">
        <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i> + Post New Item
      </a>
    </div>
  </div>

  <!-- Metric Counters Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-8">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Total Listed</span>
      <span class="text-2xl font-extrabold font-display text-gray-900"><%= stats.totalListings %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider block">Active Online</span>
      <span class="text-2xl font-extrabold font-display text-emerald-700"><%= stats.activeListings %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider block">Swap Requests</span>
      <span class="text-2xl font-extrabold font-display text-indigo-700"><%= stats.pendingIncomingExchanges %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-gray-600 uppercase tracking-wider block">Sold Items</span>
      <span class="text-2xl font-extrabold font-display text-gray-800"><%= stats.soldItems %></span>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-xs text-center">
      <span class="text-xs font-bold text-purple-600 uppercase tracking-wider block">Swapped</span>
      <span class="text-2xl font-extrabold font-display text-purple-700"><%= stats.exchangedItems %></span>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="flex items-center space-x-2 border-b border-gray-200 mb-8 overflow-x-auto pb-1">
    <a href="#listings" data-tab="listings" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="tag" class="w-4 h-4"></i> My Listings (<%= myListings.length %>)
    </a>
    <a href="#exchanges" data-tab="exchanges" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="repeat" class="w-4 h-4"></i> Swap Proposals 
      <% if (stats.pendingIncomingExchanges > 0) { %>
        <span id="badge-pending-exchanges" class="w-5 h-5 rounded-full bg-indigo-600 text-white text-[10px] flex items-center justify-center font-mono">
          <%= stats.pendingIncomingExchanges %>
        </span>
      <% } %>
    </a>
    <a href="#offers" data-tab="offers" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="badge-percent" class="w-4 h-4"></i> Price Offers
      <% if (stats.pendingIncomingOffers > 0) { %>
        <span id="badge-pending-offers" class="w-5 h-5 rounded-full bg-amber-500 text-white text-[10px] flex items-center justify-center font-mono">
          <%= stats.pendingIncomingOffers %>
        </span>
      <% } %>
    </a>
    <a href="#orders" data-tab="orders" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="shopping-bag" class="w-4 h-4"></i> Purchases in ₹ (<%= purchases.length %>)
    </a>
    <a href="#sales" data-tab="sales" class="dashboard-tab-btn px-4 py-3 border-b-2 text-sm font-bold flex items-center gap-2 rounded-t-xl transition-all">
      <i data-lucide="receipt" class="w-4 h-4"></i> Sales in ₹ (<%= sales.length %>)
    </a>
  </div>

  <!-- Tab 1: My Listings Pane -->
  <div id="tab-listings" class="dashboard-tab-pane space-y-6">
    <% if (myListings && myListings.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% myListings.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden flex flex-col justify-between shadow-xs">
            <div>
              <div class="relative aspect-[4/3] bg-gray-100">
                <img src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" alt="<%= item.title %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-xs
                    <%= item.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : '' %>
                    <%= item.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                    <%= item.status === 'sold' ? 'bg-gray-800 text-white' : '' %>
                    <%= item.status === 'exchanged' ? 'bg-purple-100 text-purple-800' : '' %>
                    <%= item.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                  ">
                    <%= item.status %>
                  </span>
                </div>
              </div>
              <div class="p-4 space-y-2">
                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider"><%= item.category ? item.category.name : 'Thrift' %></span>
                <h3 class="font-bold text-gray-900 text-sm line-clamp-1"><%= item.title %></h3>
                <p class="text-xs font-extrabold text-gray-900">
                  <% if (item.type === 'exchange') { %>
                    <span class="text-indigo-700">Swap Only</span>
                  <% } else { %>
                    ₹<%= Number(item.price).toLocaleString('en-IN') %>
                  <% } %>
                </p>
              </div>
            </div>
            <div class="p-4 pt-0 border-t border-gray-100 flex items-center justify-between gap-2 mt-2">
              <a href="/listings/<%= item._id %>" class="text-xs font-bold text-gray-600 hover:text-black">View</a>
              <div class="flex items-center space-x-2">
                <a href="/listings/<%= item._id %>/edit" class="text-xs font-bold text-gray-900 bg-gray-100 px-2.5 py-1.5 rounded-lg hover:bg-gray-200">Edit</a>
                <form action="/listings/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this listing?');">
                  <button type="submit" class="text-xs font-bold text-rose-600 bg-rose-50 px-2.5 py-1.5 rounded-lg hover:bg-rose-100">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl p-12 text-center border border-gray-200 shadow-xs">
        <p class="text-sm font-bold text-gray-700">You haven't listed any items from your wardrobe yet.</p>
        <a href="/listings/create" class="inline-flex items-center px-6 py-2.5 rounded-full bg-gray-900 text-white text-xs font-bold mt-4">
          + Post Your First Item
        </a>
      </div>
    <% } %>
  </div>

  <!-- Tab 2: Exchange Proposals Pane -->
  <div id="tab-exchanges" class="dashboard-tab-pane hidden space-y-10">
    
    <!-- Incoming Exchange Proposals -->
    <div class="space-y-4">
      <h2 class="font-display text-xl font-extrabold text-gray-900 flex items-center gap-2">
        <i data-lucide="inbox" class="w-5 h-5 text-indigo-600"></i>
        Incoming Swap Offers (For Your Items)
      </h2>

      <% const allIncoming = [...(typeof incomingSwapRequests !== 'undefined' ? incomingSwapRequests : []), ...(typeof incomingExchanges !== 'undefined' ? incomingExchanges : [])]; %>
      <% if (allIncoming && allIncoming.length > 0) { %>
        <div class="space-y-4">
          <% allIncoming.forEach(item => { 
               const isSwapReq = !!item.targetListingId;
               const targetItem = isSwapReq ? item.targetListingId : item.listingId;
               const offeredItem = isSwapReq ? item.offeredListingId : item.exchangeItemId;
               const proposer = isSwapReq ? item.proposerId : item.buyerId;
               const topUp = isSwapReq ? item.cashTopUp : item.cashTopUp;
               const reqStatus = item.status;
               const tx = isSwapReq ? (typeof item.transactionId === 'object' ? item.transactionId : null) : item;
               const hasShipments = tx && tx.shipments && tx.shipments.length >= 2;
               const isComplete = reqStatus === 'completed' || (hasShipments && tx.shipments[0].status === 'Delivered' && tx.shipments[1].status === 'Delivered');
          %>
            <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-2">
                <div class="flex items-center space-x-3">
                  <img src="<%= proposer ? (proposer.profileImage || '/images/default-avatar.png') : '/images/default-avatar.png' %>" alt="" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                  <div>
                    <p class="text-sm font-bold text-gray-900"><%= proposer ? proposer.name : 'Member' %> proposed an item swap</p>
                    <p class="text-xs text-gray-400"><%= new Date(item.createdAt).toLocaleString('en-IN') %></p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <% if (topUp && topUp > 0) { %>
                    <span class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-800 flex items-center gap-1 shadow-xs">
                      <i data-lucide="banknote" class="w-3.5 h-3.5 text-emerald-600"></i>
                      + ₹<%= Number(topUp).toLocaleString('en-IN') %> Cash Top-Up
                    </span>
                  <% } %>
                  <span id="swap-status-badge-<%= item._id %>" class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider
                    <%= reqStatus === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                    <%= isComplete ? 'bg-emerald-100 text-emerald-800' : (reqStatus === 'accepted' ? 'bg-indigo-100 text-indigo-800' : '') %>
                    <%= reqStatus === 'countered' ? 'bg-purple-100 text-purple-800' : '' %>
                    <%= reqStatus === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                  ">
                    <%= isComplete ? '🎉 Swap Completed' : (reqStatus === 'accepted' ? '🔄 Swap In Progress' : (reqStatus === 'rejected' ? '✕ Declined' : '⏳ Pending')) %>
                  </span>
                </div>
              </div>

              <!-- Trade Comparison Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-2xl border border-gray-200 items-center">
                <!-- Offered Item -->
                <div class="flex items-center space-x-3">
                  <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                    <img src="<%= offeredItem && offeredItem.images ? offeredItem.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  </div>
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 block">Offered to you</span>
                    <p class="text-xs font-bold text-gray-900"><%= offeredItem ? offeredItem.title : 'Listing removed' %></p>
                    <p class="text-[11px] text-gray-500">Condition: <%= offeredItem ? offeredItem.condition : 'N/A' %></p>
                    <% if (topUp && topUp > 0) { %>
                      <p class="text-[11px] font-bold text-emerald-700 mt-0.5">+ Extra Cash: ₹<%= Number(topUp).toLocaleString('en-IN') %></p>
                    <% } %>
                  </div>
                </div>

                <!-- Your Item -->
                <div class="flex items-center space-x-3 sm:border-l sm:border-gray-200 sm:pl-4">
                  <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                    <img src="<%= targetItem && targetItem.images ? targetItem.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  </div>
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-600 block">In exchange for your item</span>
                    <p class="text-xs font-bold text-gray-900"><%= targetItem ? targetItem.title : 'Listing removed' %></p>
                  </div>
                </div>
              </div>

              <% if (item.notes) { %>
                <p class="text-xs text-gray-600 italic bg-white p-3 rounded-xl border border-gray-100">
                  "<%= item.notes %>"
                </p>
              <% } %>

              <!-- 2 Physical Shipments Tracker (When Accepted or Completed) -->
              <% if (hasShipments && (reqStatus === 'accepted' || reqStatus === 'completed')) { %>
                <div class="pt-4 border-t border-gray-100 space-y-4">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-900 flex items-center gap-1.5">
                      <i data-lucide="truck" class="w-4 h-4 text-indigo-600"></i>
                      2-Way Courier Shipments & Live Milestones
                    </span>
                    <span class="text-[11px] font-bold font-mono text-gray-500">Both parcels trackable independently</span>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% tx.shipments.forEach((s, sIdx) => { 
                         const milestones = ['Order Placed', 'Confirmed', 'Dispatched', 'Out for Delivery', 'Delivered'];
                         const mIdx = milestones.indexOf(s.status);
                         const isDelivered = s.status === 'Delivered';
                         const isS1 = sIdx === 0;
                    %>
                      <div class="p-4 rounded-2xl bg-gray-50/70 border border-gray-200 space-y-3">
                        <div class="flex items-center justify-between">
                          <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider <%= isS1 ? 'text-indigo-700' : 'text-purple-700' %> block">
                              <%= isS1 ? 'Shipment 1' : 'Shipment 2' %>: <%= s.item ? s.item.title : (isS1 ? (offeredItem ? offeredItem.title : 'Product A') : (targetItem ? targetItem.title : 'Product B')) %>
                            </span>
                            <p class="text-xs font-semibold text-gray-800">
                              <%= (s.sender && s.sender._id && s.sender._id.toString() === user._id.toString()) ? 'You' : (s.sender ? s.sender.name : 'Sender') %> → 
                              <%= (s.receiver && s.receiver._id && s.receiver._id.toString() === user._id.toString()) ? 'You' : (s.receiver ? s.receiver.name : 'Receiver') %>
                            </p>
                          </div>
                          <div class="text-right">
                            <span class="text-[10px] font-mono font-bold text-gray-700 block"><%= s.trackingNumber %></span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= isDelivered ? 'bg-emerald-100 text-emerald-800' : 'bg-indigo-100 text-indigo-800' %>">
                              <%= s.status %>
                            </span>
                          </div>
                        </div>

                        <!-- 5-Step Tracker Bar -->
                        <div class="grid grid-cols-5 gap-1 pt-1">
                          <% milestones.forEach((m, idx) => { 
                               const isPassed = mIdx >= idx;
                               const isCur = mIdx === idx;
                          %>
                            <div class="flex flex-col items-center text-center">
                              <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold mb-1 <%= isCur ? (isS1 ? 'bg-indigo-600 text-white animate-pulse' : 'bg-purple-600 text-white animate-pulse') : (isPassed ? 'bg-emerald-600 text-white' : 'bg-gray-200 text-gray-500') %>">
                                <%= isPassed && !isCur ? '✓' : (idx + 1) %>
                              </div>
                              <span class="text-[9px] leading-tight <%= isCur ? 'font-extrabold text-gray-900' : (isPassed ? 'font-semibold text-gray-700' : 'text-gray-400') %>">
                                <%= m === 'Out for Delivery' ? 'Out for Deliv.' : m %>
                              </span>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>

              <!-- Response Actions -->
              <div class="pt-2 flex items-center justify-end space-x-3" id="swap-actions-<%= item._id %>">
                <% if (reqStatus === 'pending') { %>
                  <button onclick="handleDashboardSwapAction('<%= item._id %>', 'reject', this)" class="px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-colors cursor-pointer">
                    Decline Swap
                  </button>
                  <button onclick="handleDashboardSwapAction('<%= item._id %>', 'accept', this)" class="px-5 py-2 rounded-xl bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-xs cursor-pointer">
                    Accept & Confirm Swap
                  </button>
                <% } else if (reqStatus === 'completed' || reqStatus === 'accepted') { %>
                  <% const transId = isSwapReq ? (item.transactionId ? (item.transactionId._id || item.transactionId) : null) : item._id; %>
                  <% if (transId) { %>
                    <a href="/checkout/success/<%= transId %>" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-900 text-xs font-bold flex items-center gap-1.5 transition-colors">
                      <i data-lucide="receipt" class="w-3.5 h-3.5 text-gray-600"></i> View Swap Tracking & Receipt
                    </a>
                  <% } else { %>
                    <span class="text-xs font-semibold text-emerald-700">Swap confirmed</span>
                  <% } %>
                <% } else if (reqStatus === 'rejected') { %>
                  <span class="text-xs font-medium text-rose-600">Swap proposal declined</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-3xl p-8 text-center border border-gray-200">
          <p class="text-xs font-semibold text-gray-500">No incoming swap offers yet.</p>
        </div>
      <% } %>
    </div>

    <!-- Outgoing Exchange Proposals -->
    <div class="space-y-4 pt-6 border-t border-gray-200">
      <h2 class="font-display text-xl font-extrabold text-gray-900 flex items-center gap-2">
        <i data-lucide="send" class="w-5 h-5 text-indigo-600"></i>
        Outgoing Swap Offers (You Proposed)
      </h2>

      <% const allOutgoing = [...(typeof outgoingSwapRequests !== 'undefined' ? outgoingSwapRequests : []), ...(typeof outgoingExchanges !== 'undefined' ? outgoingExchanges : [])]; %>
      <% if (allOutgoing && allOutgoing.length > 0) { %>
        <div class="space-y-4">
          <% allOutgoing.forEach(item => { 
               const isSwapReq = !!item.targetListingId;
               const targetItem = isSwapReq ? item.targetListingId : item.listingId;
               const offeredItem = isSwapReq ? item.offeredListingId : item.exchangeItemId;
               const topUp = isSwapReq ? item.cashTopUp : item.cashTopUp;
               const reqStatus = item.status;
               const tx = isSwapReq ? (typeof item.transactionId === 'object' ? item.transactionId : null) : item;
               const hasShipments = tx && tx.shipments && tx.shipments.length >= 2;
               const isComplete = reqStatus === 'completed' || (hasShipments && tx.shipments[0].status === 'Delivered' && tx.shipments[1].status === 'Delivered');
          %>
            <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-14 rounded-xl overflow-hidden bg-gray-200 flex-shrink-0">
                    <img src="<%= targetItem && targetItem.images ? targetItem.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  </div>
                  <div>
                    <p class="text-xs text-gray-400">Target Item: <span class="font-bold text-gray-900"><%= targetItem ? targetItem.title : 'Removed' %></span></p>
                    <p class="text-xs text-gray-500">You offered: <span class="font-semibold text-indigo-700"><%= offeredItem ? offeredItem.title : 'Removed' %></span></p>
                    <% if (reqStatus === 'countered' && item.counterOffer) { %>
                      <div class="mt-1.5 p-2 bg-purple-50 border border-purple-200 rounded-lg text-xs text-purple-900">
                        <strong>Seller Counter-Offered:</strong> <%= item.counterOffer.note || 'Updated terms' %>
                        <% if (item.counterOffer.cashTopUp) { %> (Counter Cash: ₹<%= item.counterOffer.cashTopUp %>)<% } %>
                      </div>
                    <% } %>
                  </div>
                </div>
                <div class="flex items-center gap-2.5" id="swap-actions-<%= item._id %>">
                  <% if (topUp && topUp > 0) { %>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800">
                      + ₹<%= Number(topUp).toLocaleString('en-IN') %> Top-up
                    </span>
                  <% } %>
                  <span id="swap-status-badge-<%= item._id %>" class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider
                    <%= reqStatus === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                    <%= reqStatus === 'countered' ? 'bg-purple-100 text-purple-800' : '' %>
                    <%= isComplete ? 'bg-emerald-100 text-emerald-800' : (reqStatus === 'accepted' ? 'bg-indigo-100 text-indigo-800' : '') %>
                    <%= reqStatus === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                  ">
                    <%= isComplete ? '🎉 Swap Completed' : (reqStatus === 'accepted' ? '🔄 Swap In Progress' : (reqStatus === 'rejected' ? '✕ Declined' : reqStatus)) %>
                  </span>
                  <% if (reqStatus === 'pending') { %>
                    <button onclick="handleDashboardSwapAction('<%= item._id %>', 'cancel', this)" class="px-3 py-1.5 rounded-lg bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 text-xs font-bold transition-colors cursor-pointer">
                      Withdraw Swap
                    </button>
                  <% } else if (reqStatus === 'countered') { %>
                    <button onclick="handleCounterAction('<%= item._id %>', 'accept')" class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors">
                      Accept Counter
                    </button>
                    <button onclick="handleCounterAction('<%= item._id %>', 'reject')" class="px-3 py-1.5 rounded-lg bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold transition-colors">
                      Decline
                    </button>
                  <% } else if (reqStatus === 'accepted' || reqStatus === 'completed') { %>
                    <% const transId = isSwapReq ? (item.transactionId ? (item.transactionId._id || item.transactionId) : null) : item._id; %>
                    <% if (transId) { %>
                      <a href="/checkout/success/<%= transId %>" class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1 shadow-xs transition-colors">
                        <i data-lucide="truck" class="w-3.5 h-3.5"></i> Track Couriers
                      </a>
                    <% } %>
                  <% } %>
                </div>
              </div>

              <!-- 2 Physical Shipments Tracker for Outgoing (When Accepted or Completed) -->
              <% if (hasShipments && (reqStatus === 'accepted' || reqStatus === 'completed')) { %>
                <div class="pt-4 border-t border-gray-100 space-y-4">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-gray-900 flex items-center gap-1.5">
                      <i data-lucide="truck" class="w-4 h-4 text-indigo-600"></i>
                      2-Way Courier Shipments & Live Milestones
                    </span>
                    <span class="text-[11px] font-bold font-mono text-gray-500">Both parcels trackable independently</span>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% tx.shipments.forEach((s, sIdx) => { 
                         const milestones = ['Order Placed', 'Confirmed', 'Dispatched', 'Out for Delivery', 'Delivered'];
                         const mIdx = milestones.indexOf(s.status);
                         const isDelivered = s.status === 'Delivered';
                         const isS1 = sIdx === 0;
                    %>
                      <div class="p-4 rounded-2xl bg-gray-50/70 border border-gray-200 space-y-3">
                        <div class="flex items-center justify-between">
                          <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider <%= isS1 ? 'text-indigo-700' : 'text-purple-700' %> block">
                              <%= isS1 ? 'Shipment 1' : 'Shipment 2' %>: <%= s.item ? s.item.title : (isS1 ? (offeredItem ? offeredItem.title : 'Product A') : (targetItem ? targetItem.title : 'Product B')) %>
                            </span>
                            <p class="text-xs font-semibold text-gray-800">
                              <%= (s.sender && s.sender._id && s.sender._id.toString() === user._id.toString()) ? 'You' : (s.sender ? s.sender.name : 'Sender') %> → 
                              <%= (s.receiver && s.receiver._id && s.receiver._id.toString() === user._id.toString()) ? 'You' : (s.receiver ? s.receiver.name : 'Receiver') %>
                            </p>
                          </div>
                          <div class="text-right">
                            <span class="text-[10px] font-mono font-bold text-gray-700 block"><%= s.trackingNumber %></span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= isDelivered ? 'bg-emerald-100 text-emerald-800' : 'bg-indigo-100 text-indigo-800' %>">
                              <%= s.status %>
                            </span>
                          </div>
                        </div>

                        <!-- 5-Step Tracker Bar -->
                        <div class="grid grid-cols-5 gap-1 pt-1">
                          <% milestones.forEach((m, idx) => { 
                               const isPassed = mIdx >= idx;
                               const isCur = mIdx === idx;
                          %>
                            <div class="flex flex-col items-center text-center">
                              <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold mb-1 <%= isCur ? (isS1 ? 'bg-indigo-600 text-white animate-pulse' : 'bg-purple-600 text-white animate-pulse') : (isPassed ? 'bg-emerald-600 text-white' : 'bg-gray-200 text-gray-500') %>">
                                <%= isPassed && !isCur ? '✓' : (idx + 1) %>
                              </div>
                              <span class="text-[9px] leading-tight <%= isCur ? 'font-extrabold text-gray-900' : (isPassed ? 'font-semibold text-gray-700' : 'text-gray-400') %>">
                                <%= m === 'Out for Delivery' ? 'Out for Deliv.' : m %>
                              </span>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-3xl p-8 text-center border border-gray-200">
          <p class="text-xs font-semibold text-gray-500">You haven't sent any swap proposals yet.</p>
        </div>
