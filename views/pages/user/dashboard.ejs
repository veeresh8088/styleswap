<script>
function showStyleswapToast(message, type = 'success') {
  let container = document.getElementById('styleswap-toast-container');
  if (!container) {
    container = document.createElement('div');
    container.id = 'styleswap-toast-container';
    container.className = 'fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4';
    document.body.appendChild(container);
  }

  const toast = document.createElement('div');
  const isSuccess = type === 'success';
  toast.className = `pointer-events-auto transform transition-all duration-300 ease-out translate-y-2 opacity-0 flex items-center gap-3 p-4 rounded-2xl shadow-xl text-xs font-bold ${
    isSuccess ? 'bg-gray-900 text-white border border-emerald-500/30' : 'bg-rose-900 text-white border border-rose-500/30'
  }`;
  
  const icon = isSuccess 
    ? `<span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 font-extrabold text-sm">✓</span>`
    : `<span class="w-6 h-6 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center flex-shrink-0 font-extrabold text-sm">✕</span>`;

  toast.innerHTML = `
    ${icon}
    <div class="flex-1">${message}</div>
  `;

  container.appendChild(toast);
  requestAnimationFrame(() => {
    toast.classList.remove('translate-y-2', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
  });

  setTimeout(() => {
    toast.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

async function handleDashboardSwapAction(swapId, action, btn) {
  const container = document.getElementById('swap-actions-' + swapId) || (btn ? btn.closest('#swap-actions-' + swapId) : null);
  const buttons = container ? Array.from(container.querySelectorAll('button')) : (btn ? [btn] : []);

  // Prevent duplicate clicks immediately
  buttons.forEach(b => {
    b.disabled = true;
    b.style.pointerEvents = 'none';
    b.classList.add('opacity-50');
  });

  if (btn) {
    btn.dataset.originalHtml = btn.innerHTML;
    btn.textContent = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Withdrawing...' : 'Declining...');
  }

  try {
    let res = await fetch(`/api/swaps/${swapId}/respond`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
    });
    let data = await res.json();

    if (!res.ok) {
      // Fallback to /transactions/:id/respond if swap was stored as exchange transaction
      res = await fetch(`/transactions/${swapId}/respond`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
      });
      data = await res.json();
    }

    if (res.ok && data.success) {
      showStyleswapToast(data.message || (action === 'accept' ? 'Swap request accepted successfully!' : 'Swap request declined.'), 'success');
      
      // Update status badge immediately
      const badge = document.getElementById('swap-status-badge-' + swapId);
      if (badge) {
        if (action === 'accept') {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badge.textContent = '✓ Accepted';
        } else {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-rose-100 text-rose-800';
          badge.textContent = action === 'cancel' ? '✕ Withdrawn' : '✕ Declined';
        }
      }

      // Update action container immediately
      if (container) {
        if (action === 'accept') {
          const transId = data.data?.transactionId || data.transactionId || (data.data && data.data._id);
          if (transId) {
            container.innerHTML = `
              <a href="/checkout/success/${transId}" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-900 text-xs font-bold flex items-center gap-1.5 transition-colors">
                <i data-lucide="receipt" class="w-3.5 h-3.5 text-gray-600"></i> View Swap Tracking & Receipt
              </a>
            `;
          } else {
            container.innerHTML = `<span class="text-xs font-semibold text-emerald-700">✓ Swap confirmed</span>`;
          }
        } else {
          container.innerHTML = `<span class="text-xs font-medium text-rose-600">${action === 'cancel' ? 'Swap proposal withdrawn' : '✕ Swap proposal declined'}</span>`;
        }
      }

      // Update tab counter badge if present
      const badgeCount = document.getElementById('badge-pending-exchanges');
      if (badgeCount) {
        let currentCount = parseInt(badgeCount.textContent.trim(), 10) || 0;
        currentCount = Math.max(0, currentCount - 1);
        if (currentCount === 0) {
          badgeCount.style.display = 'none';
        } else {
          badgeCount.textContent = currentCount;
        }
      }

      if (window.lucide) window.lucide.createIcons();
    } else {
      showStyleswapToast(data.message || `Failed to ${action} swap`, 'error');
      buttons.forEach(b => {
        b.disabled = false;
        b.style.pointerEvents = '';
        b.classList.remove('opacity-50');
        if (b.dataset.originalHtml) b.innerHTML = b.dataset.originalHtml;
      });
    }
  } catch (err) {
    showStyleswapToast('Network error while processing swap request', 'error');
    buttons.forEach(b => {
      b.disabled = false;
      b.style.pointerEvents = '';
      b.classList.remove('opacity-50');
      if (b.dataset.originalHtml) b.innerHTML = b.dataset.originalHtml;
    });
  }
}

async function handleCounterAction(swapId, action) {
  if (!confirm(`Are you sure you want to ${action} this counter offer?`)) return;
  try {
    const res = await fetch(`/api/swaps/${swapId}/counter-respond`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ action })
    });
    const data = await res.json();
    if (data.success) {
      showStyleswapToast(data.message || `Counter offer ${action}ed successfully!`, 'success');
      setTimeout(() => window.location.reload(), 1000);
    } else {
      showStyleswapToast(data.message || `Failed to ${action} counter offer`, 'error');
    }
  } catch (err) {
    showStyleswapToast('Network error while responding to counter offer', 'error');
  }
}

async function handleDashboardOfferAction(offerId, action, btn) {
  const container = document.getElementById('offer-actions-' + offerId) || (btn ? btn.closest('#offer-actions-' + offerId) : null);
  const buttons = container ? Array.from(container.querySelectorAll('button')) : (btn ? [btn] : []);

  // Prevent duplicate clicks immediately
  buttons.forEach(b => {
    b.disabled = true;
    b.style.pointerEvents = 'none';
    b.classList.add('opacity-50');
  });

  if (btn) {
    btn.dataset.originalHtml = btn.innerHTML;
    btn.textContent = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Cancelling...' : 'Declining...');
  }

  try {
    const res = await fetch(`/api/offers/${offerId}/respond`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showStyleswapToast(data.message || (action === 'accept' ? 'Offer accepted successfully!' : 'Offer declined.'), 'success');
      
      // Update status badge immediately
      const badge = document.getElementById('offer-status-badge-' + offerId);
      if (badge) {
        if (action === 'accept') {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badge.textContent = '✓ Accepted';
        } else {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-rose-100 text-rose-800';
          badge.textContent = action === 'cancel' ? '✕ Cancelled' : '✕ Declined';
        }
      }

      // Update action container immediately
      if (container) {
        if (action === 'accept') {
          container.innerHTML = `<span class="text-xs font-semibold text-emerald-700">✓ Awaiting buyer checkout</span>`;
        } else {
          container.innerHTML = `<span class="text-xs font-medium text-rose-600">${action === 'cancel' ? 'Offer cancelled' : '✕ Offer closed'}</span>`;
        }
      }

      // Update tab counter badge if present
      const badgeCount = document.getElementById('badge-pending-offers');
      if (badgeCount) {
        let currentCount = parseInt(badgeCount.textContent.trim(), 10) || 0;
        currentCount = Math.max(0, currentCount - 1);
        if (currentCount === 0) {
          badgeCount.style.display = 'none';
        } else {
          badgeCount.textContent = currentCount;
        }
      }

      if (window.lucide) window.lucide.createIcons();
    } else {
      showStyleswapToast(data.message || `Failed to ${action} offer`, 'error');
      buttons.forEach(b => {
        b.disabled = false;
        b.style.pointerEvents = '';
        b.classList.remove('opacity-50');
        if (b.dataset.originalHtml) b.innerHTML = b.dataset.originalHtml;
      });
    }
  } catch (err) {
    showStyleswapToast('Network error while processing offer', 'error');
    buttons.forEach(b => {
      b.disabled = false;
      b.style.pointerEvents = '';
      b.classList.remove('opacity-50');
      if (b.dataset.originalHtml) b.innerHTML = b.dataset.originalHtml;
    });
  }
}
</script>

