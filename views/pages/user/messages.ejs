<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-200 gap-4 mb-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Buyer & Seller Communication</span>
      <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900">Messages & Inquiries</h1>
    </div>

    <a href="/listings" class="px-4 py-2 rounded-xl bg-gray-900 text-white text-xs font-bold hover:bg-black transition-colors flex items-center gap-1.5 self-start sm:self-auto">
      <i data-lucide="shopping-bag" class="w-3.5 h-3.5"></i> Browse Thrift Collection
    </a>
  </div>

  <% if (conversations && conversations.length > 0) { %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 bg-white rounded-3xl border border-gray-200 shadow-xs overflow-hidden min-h-[560px]">
      
      <!-- Conversation List (Left) -->
      <div class="lg:col-span-4 border-r border-gray-100 divide-y divide-gray-100 overflow-y-auto max-h-[600px]" id="conv-list-container">
        <% conversations.forEach(conv => { %>
          <% 
            const buyerIdStr = conv.buyerId ? (conv.buyerId._id || conv.buyerId).toString() : '';
            const currentUserIdStr = currentUser._id ? currentUser._id.toString() : '';
            const isBuyer = buyerIdStr === currentUserIdStr;
            const otherUser = isBuyer ? conv.sellerId : conv.buyerId;
            const otherName = otherUser ? (otherUser.name || 'Member') : 'Styleswap Member';
            const otherAvatar = (otherUser && otherUser.profileImage) ? otherUser.profileImage : '/images/default-avatar.png';
            const itemTitle = (conv.listingId && conv.listingId.title) ? conv.listingId.title : 'Thrift Listing';
            const listingId = (conv.listingId && (conv.listingId._id || conv.listingId)) ? (conv.listingId._id || conv.listingId).toString() : '';
            const lastMsg = conv.messages && conv.messages.length > 0 ? conv.messages[conv.messages.length - 1] : null;
            const isActive = activeConversationId && activeConversationId.toString() === conv._id.toString();
          %>
          <div 
            class="conv-item p-4 hover:bg-gray-50 cursor-pointer transition-all flex items-start space-x-3 <%= isActive ? 'bg-indigo-50/70 border-l-4 border-indigo-600' : '' %>"
            id="conv-item-<%= conv._id %>"
            data-conv-id="<%= conv._id %>"
            data-listing-id="<%= listingId %>"
            data-item-title="<%= itemTitle.replace(/"/g, '&quot;') %>"
            data-other-name="<%= otherName.replace(/"/g, '&quot;') %>"
            data-other-avatar="<%= otherAvatar %>"
          >
            <img src="<%= otherAvatar %>" class="w-11 h-11 rounded-full object-cover border border-gray-200 flex-shrink-0" alt="">
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-gray-900 truncate"><%= otherName %></h4>
                <span class="text-[10px] text-gray-400"><%= lastMsg ? new Date(lastMsg.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' }) : '' %></span>
              </div>
              <p class="text-[11px] font-semibold text-indigo-700 truncate mt-0.5">
                <%= itemTitle %>
              </p>
              <p class="text-xs text-gray-500 truncate mt-0.5 conv-preview-text">
                <%= lastMsg ? lastMsg.text : 'Start conversation...' %>
              </p>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Active Chat Window (Right) -->
      <div class="lg:col-span-8 flex flex-col h-full bg-gray-50/40">
        
        <!-- Chat Header -->
        <div class="p-4 bg-white border-b border-gray-200 flex items-center justify-between flex-shrink-0" id="inbox-chat-header">
          <div class="flex items-center space-x-3">
            <img id="inbox-header-avatar" src="/images/default-avatar.png" class="w-10 h-10 rounded-full object-cover border border-gray-200" alt="">
            <div>
              <h3 class="font-bold text-sm text-gray-900" id="inbox-header-name">Conversation</h3>
              <a href="#" id="inbox-header-item-link" class="text-xs text-indigo-600 hover:underline flex items-center gap-1 font-semibold">
                <i data-lucide="external-link" class="w-3 h-3"></i>
                <span id="inbox-header-item-title">Product Details</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Messages Area -->
        <div id="inbox-messages-container" class="flex-1 p-6 overflow-y-auto space-y-3.5 text-xs">
          <div class="text-center text-gray-400 py-12">
            Select a conversation to begin messaging
          </div>
        </div>

        <!-- Message Input Form -->
        <form id="inbox-send-form" onsubmit="sendInboxMessage(event)" class="p-4 bg-white border-t border-gray-200 flex items-center gap-3 flex-shrink-0">
          <input type="hidden" id="inbox-current-listing-id">
          <input type="hidden" id="inbox-current-conv-id">
          <input 
            type="text" 
            id="inbox-input-text" 
            placeholder="Type your reply..." 
            required 
            autocomplete="off"
            class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600"
          >
          <button type="submit" id="inbox-send-btn" class="px-5 py-2.5 rounded-xl bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
            <span>Send</span>
          </button>
        </form>

      </div>

    </div>
  <% } else { %>
    <div class="bg-white rounded-3xl p-16 text-center border border-gray-200 space-y-4">
      <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto">
        <i data-lucide="message-circle" class="w-7 h-7"></i>
      </div>
      <h3 class="font-display font-bold text-lg text-gray-900">No Messages Yet</h3>
      <p class="text-xs text-gray-500 max-w-sm mx-auto">
        When you click "Message Seller" on any thrift listing, your direct inquiry conversation will appear here!
      </p>
      <a href="/listings" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-gray-900 text-white text-xs font-bold hover:bg-black transition-colors mt-2">
        Explore Thrift Marketplace
      </a>
    </div>
  <% } %>

</div>

<script>
  let currentListingId = '';
  let currentConvId = '';
  const currentUserId = '<%= currentUser ? currentUser._id : "" %>';
  const currentUserRole = '<%= currentUser ? currentUser.role : "" %>';
  const isAdmin = currentUserRole === 'admin';

  function showStyleswapToast(message, type = 'success') {
    let container = document.getElementById('styleswap-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'styleswap-toast-container';
      container.className = 'fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    const isSuccess = type === 'success';
    toast.className = `pointer-events-auto transform transition-all duration-300 ease-out translate-y-2 opacity-0 flex items-center gap-3 p-4 rounded-2xl shadow-xl text-xs font-bold ${
      isSuccess ? 'bg-gray-900 text-white border border-emerald-500/30' : 'bg-rose-900 text-white border border-rose-500/30'
    }`;
    
    const icon = isSuccess 
      ? `<span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 font-extrabold text-sm">✓</span>`
      : `<span class="w-6 h-6 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center flex-shrink-0 font-extrabold text-sm">✕</span>`;

    toast.innerHTML = `
      ${icon}
      <div class="flex-1">${message}</div>
    `;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  function extractCleanHexId(val) {
    if (!val) return '';
    if (typeof val === 'object') {
      if (val._id) val = val._id;
      else if (val.id) val = val.id;
    }
    const str = String(val);
    const match = str.match(/[a-f0-9]{24}/i);
    return match ? match[0] : '';
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function selectConversation(convId, listingId, itemTitle, otherName, otherAvatar) {
    currentListingId = listingId || '';
    currentConvId = convId || '';

    // Update active highlight on left items
    document.querySelectorAll('.conv-item').forEach(el => {
      if (el.dataset.convId === convId) {
        el.classList.add('bg-indigo-50/70', 'border-l-4', 'border-indigo-600');
      } else {
        el.classList.remove('bg-indigo-50/70', 'border-l-4', 'border-indigo-600');
      }
    });

    const listInput = document.getElementById('inbox-current-listing-id');
    const convInput = document.getElementById('inbox-current-conv-id');
    if (listInput) listInput.value = currentListingId;
    if (convInput) convInput.value = currentConvId;

    const nameEl = document.getElementById('inbox-header-name');
    const avatarEl = document.getElementById('inbox-header-avatar');
    const titleEl = document.getElementById('inbox-header-item-title');
    const linkEl = document.getElementById('inbox-header-item-link');

    if (nameEl) nameEl.textContent = otherName;
    if (avatarEl) avatarEl.src = otherAvatar || '/images/default-avatar.png';
    if (titleEl) titleEl.textContent = itemTitle;
    if (linkEl) {
      linkEl.href = currentListingId ? ('/listings/' + currentListingId) : '#';
      linkEl.style.display = currentListingId ? 'inline-flex' : 'none';
    }

    loadInboxMessages(currentListingId, currentConvId);
  }

  async function loadInboxMessages(listingId, convId) {
    const container = document.getElementById('inbox-messages-container');
    if (!container) return;

    const effectiveListingId = (listingId && listingId !== 'undefined') ? listingId : currentListingId;
    const effectiveConvId = (convId && convId !== 'undefined') ? convId : currentConvId;

    if (!effectiveListingId && !effectiveConvId) {
      container.innerHTML = '<div class="text-center text-gray-400 py-12">Select a conversation to begin messaging</div>';
      return;
    }

    container.innerHTML = '<div class="text-center text-gray-400 py-12"><p class="text-xs font-semibold animate-pulse">Loading conversation...</p></div>';

    let url;
    if (effectiveConvId && effectiveConvId !== 'undefined') {
      url = '/api/chat/conversation/active?conversationId=' + encodeURIComponent(effectiveConvId);
    } else if (effectiveListingId && effectiveListingId !== 'undefined') {
      url = '/api/chat/conversation/' + encodeURIComponent(effectiveListingId);
    } else {
      container.innerHTML = '<div class="text-center text-gray-400 py-12">Select a conversation to begin messaging</div>';
      return;
    }

    try {
      const response = await fetch(url, { credentials: 'same-origin' });
      const data = await response.json();

      if (!response.ok || !data.success || !data.data) {
        container.innerHTML = '<div class="text-center text-rose-500 py-6 font-semibold text-xs">Unable to load messages.</div>';
        return;
      }

      const conv = data.data;
      const messages = conv.messages || [];
      const sellerIdStr = conv.sellerId ? (conv.sellerId._id || conv.sellerId).toString() : '';
      const buyerIdStr = conv.buyerId ? (conv.buyerId._id || conv.buyerId).toString() : '';
      const isSeller = sellerIdStr === currentUserId;
      const isBuyer = buyerIdStr === currentUserId;
      const listingObjId = conv.listingId ? (conv.listingId._id || conv.listingId).toString() : '';

      if (messages.length === 0) {
        container.innerHTML = `
          <div class="text-center text-gray-400 py-12 space-y-2">
            <i data-lucide="message-square" class="w-8 h-8 mx-auto text-gray-300"></i>
            <p class="font-bold text-gray-700 text-sm">No messages yet</p>
            <p class="text-xs text-gray-400">Type a message below to discuss size, fit, courier, or pricing!</p>
          </div>
        `;
      } else {
        container.innerHTML = messages.map(msg => {
          const senderId = (msg.sender && msg.sender._id) ? msg.sender._id.toString() : (msg.sender ? msg.sender.toString() : '');
          const isMine = senderId === currentUserId;
          const time = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

          if (msg.type === 'system') {
            return `
              <div class="flex justify-center my-3">
                <div class="px-4 py-1.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-semibold text-center max-w-md border border-gray-200 shadow-2xs">
                  ${escapeHtml(msg.text)}
                </div>
              </div>
            `;
          }

          const isOffer = msg.type === 'offer' || (msg.text && (msg.text.includes('Price Offer') || msg.text.includes('Offer Accepted') || msg.text.includes('Offer Declined')));
          const isSwap = msg.type === 'swap' || (msg.text && (msg.text.includes('Swap Proposal') || msg.text.includes('Swap Accepted') || msg.text.includes('Swap Declined')));

          if (isOffer) {
            // Price Offer Card
            const status = msg.actionStatus || (msg.text.includes('Accepted') ? 'accepted' : (msg.text.includes('Declined') ? 'rejected' : 'pending'));
            const offerIdSafe = extractCleanHexId(msg.offerId) || extractCleanHexId(msg.metadata && msg.metadata.offerId) || extractCleanHexId(conv.offerId);
            const offeredPrice = (msg.metadata && msg.metadata.offeredPrice) || (msg.text.match(/₹([\d,]+)/) ? msg.text.match(/₹([\d,]+)/)[1] : '');
            const checkoutUrl = (msg.metadata && msg.metadata.checkoutUrl) || ('/checkout/' + listingObjId);
            const canAccept = (!isMine && status === 'pending') || (isSeller && status === 'pending') || isAdmin;
            const canCancel = isMine && status === 'pending';

            return `
              <div class="flex ${isMine ? 'justify-end' : 'justify-start'} w-full my-2">
                <div class="w-full max-w-md rounded-2xl p-4 shadow-xs border ${status === 'accepted' ? 'bg-emerald-50/70 border-emerald-200' : (status === 'rejected' ? 'bg-rose-50/70 border-rose-200' : 'bg-amber-50/70 border-amber-200')}">
                  <div class="flex items-center justify-between pb-2 border-b ${status === 'accepted' ? 'border-emerald-200/60' : (status === 'rejected' ? 'border-rose-200/60' : 'border-amber-200/60')}">
                    <div class="flex items-center gap-1.5 font-extrabold text-xs ${status === 'accepted' ? 'text-emerald-900' : (status === 'rejected' ? 'text-rose-900' : 'text-amber-900')}">
                      <i data-lucide="tag" class="w-3.5 h-3.5"></i>
                      <span>Price Offer ${offeredPrice ? ('₹' + offeredPrice) : ''}</span>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${status === 'accepted' ? 'bg-emerald-200 text-emerald-800' : (status === 'rejected' ? 'bg-rose-200 text-rose-800' : 'bg-amber-200 text-amber-900 animate-pulse')}">
                      ${status === 'accepted' ? '✓ Accepted' : (status === 'rejected' ? '✕ Declined' : '⏳ Pending')}
                    </span>
                  </div>

                  <p class="text-xs text-gray-800 leading-relaxed whitespace-pre-wrap mt-2.5 font-medium">${escapeHtml(msg.text)}</p>

                  ${canAccept && status === 'pending' && offerIdSafe ? `
                    <div class="mt-3.5 pt-3 border-t border-amber-200/80 flex items-center gap-2">
                      <button 
                        type="button" 
                        data-offer-id="${offerIdSafe}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'accept', this)"
                        class="flex-1 py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
                      >
                        <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                        <span>Accept Offer ${offeredPrice ? ('(₹' + offeredPrice + ')') : ''}</span>
                      </button>
                      <button 
                        type="button" 
                        data-offer-id="${offerIdSafe}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'reject', this)"
                        class="py-2 px-3.5 rounded-xl bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-xs transition-colors flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
                        <span>Decline</span>
                      </button>
                    </div>
                  ` : ''}

                  ${!canAccept && canCancel && status === 'pending' && offerIdSafe ? `
                    <div class="mt-3 pt-2.5 border-t border-amber-200/80 flex items-center justify-between">
                      <span class="text-[11px] text-amber-800 font-medium">⏳ Awaiting seller's response</span>
                      <button 
                        type="button" 
                        data-offer-id="${offerIdSafe}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'cancel', this)"
                        class="py-1.5 px-3 rounded-lg bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[11px] transition-colors flex items-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-3 h-3"></i>
                        <span>Cancel Offer</span>
                      </button>
                    </div>
                  ` : ''}

                  ${(!isSeller || isMine) && status === 'accepted' ? `
                    <div class="mt-3.5 pt-3 border-t border-emerald-200/80 flex flex-col gap-2">
                      <p class="text-[11px] font-semibold text-emerald-900">🎉 Great news! Your offer was accepted. Complete checkout now to claim it at your offered price.</p>
                      <a 
                        href="${checkoutUrl}"
                        class="w-full py-2.5 px-4 rounded-xl bg-gray-900 hover:bg-black text-white font-bold text-xs shadow-sm transition-all flex items-center justify-center gap-2 text-center cursor-pointer"
                      >
                        <i data-lucide="shopping-bag" class="w-3.5 h-3.5 text-amber-400"></i>
                        <span>Checkout Now at Offer Price →</span>
                      </a>
                    </div>
                  ` : ''}

                  ${isSeller && !isMine && status === 'accepted' ? `
                    <div class="mt-2.5 pt-2 border-t border-emerald-200/60 text-[11px] font-semibold text-emerald-800 flex items-center gap-1">
                      <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                      <span>You accepted this offer. Awaiting buyer checkout.</span>
                    </div>
                  ` : ''}

                  ${status === 'rejected' ? `
                    <div class="mt-2.5 pt-2 border-t border-rose-200/60 text-[11px] font-medium text-rose-700 flex items-center gap-1">
                      <i data-lucide="x-circle" class="w-3.5 h-3.5 text-rose-500"></i>
                      <span>This offer has been closed / declined.</span>
                    </div>
                  ` : ''}

                  <span class="block text-[9px] mt-2 text-right text-gray-400">${time}</span>
                </div>
              </div>
            `;
          }

          if (isSwap) {
            // Wardrobe Swap Proposal Card
            const meta = msg.metadata || {};
            const rawStatus = (meta.status || msg.actionStatus || '').toLowerCase();
            const status = rawStatus === 'completed' 
              ? 'completed' 
              : (rawStatus === 'accepted' 
                  ? 'accepted' 
                  : (rawStatus === 'rejected' || rawStatus === 'cancelled' 
                      ? 'rejected' 
                      : (msg.text && (msg.text.includes('Swap Accepted') || msg.text.includes('Proposal Accepted')) 
                          ? 'accepted' 
                          : (msg.text && (msg.text.includes('Swap Declined') || msg.text.includes('Proposal Declined')) 
                              ? 'rejected' 
                              : 'pending'))));

            const swapIdSafe = extractCleanHexId(meta.swapId) || extractCleanHexId(msg.swapId) || extractCleanHexId(conv.swapId);

            // Database relationships: receiverId is target listing owner who can accept; proposerId is who proposed
            const receiverIdStr = (meta.receiverId || (conv.sellerId ? (conv.sellerId._id || conv.sellerId) : '') || '').toString();
            const proposerIdStr = (meta.proposerId || (conv.buyerId ? (conv.buyerId._id || conv.buyerId) : '') || '').toString();

            const isTargetReceiver = receiverIdStr === currentUserId;
            const isProposer = proposerIdStr === currentUserId;

            // Target item owner (receiver) can accept/decline; proposer can only withdraw; admin can moderate
            const canAccept = (isTargetReceiver || isAdmin) && !isProposer && status === 'pending';
            const canWithdraw = isProposer && status === 'pending';

            const offeredTitle = meta.offeredItemTitle || 'Product A';
            const targetTitle = meta.targetItemTitle || (conv.listingId ? (conv.listingId.title || 'Product B') : 'Product B');
            const cashDiff = Number(meta.cashTopUp || 0);
            const shipments = meta.shipments || [];
            const hasDualShipments = shipments && shipments.length >= 2;
            const transId = meta.transactionId || swapIdSafe;

            return `
              <div class="flex ${isMine ? 'justify-end' : 'justify-start'} w-full my-2">
                <div class="w-full max-w-md rounded-2xl p-4 shadow-xs border ${
                  status === 'completed' ? 'bg-emerald-50/80 border-emerald-300' :
                  status === 'accepted' ? 'bg-emerald-50/70 border-emerald-200' : 
                  (status === 'rejected' ? 'bg-rose-50/70 border-rose-200' : 'bg-indigo-50/70 border-indigo-200')
                }">
                  <!-- Header -->
                  <div class="flex items-center justify-between pb-2 border-b ${
                    status === 'completed' ? 'border-emerald-200/80' :
                    status === 'accepted' ? 'border-emerald-200/60' : 
                    (status === 'rejected' ? 'border-rose-200/60' : 'border-indigo-200/60')
                  }">
                    <div class="flex items-center gap-1.5 font-extrabold text-xs ${
                      status === 'completed' || status === 'accepted' ? 'text-emerald-900' : 
                      (status === 'rejected' ? 'text-rose-900' : 'text-indigo-950')
                    }">
                      <i data-lucide="repeat" class="w-3.5 h-3.5 text-indigo-600"></i>
                      <span>Wardrobe Swap Proposal</span>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                      status === 'completed' ? 'bg-emerald-200 text-emerald-900 border border-emerald-300' :
                      status === 'accepted' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 
                      (status === 'rejected' ? 'bg-rose-100 text-rose-800 border border-rose-300' : 'bg-indigo-100 text-indigo-900 border border-indigo-300 animate-pulse')
                    }">
                      ${status === 'completed' ? '🎉 Swap Completed' : (status === 'accepted' ? '✓ Swap Accepted' : (status === 'rejected' ? '✕ Swap Declined' : '⏳ Pending'))}
                    </span>
                  </div>

                  <!-- Product A <-> Product B Exchange Items Recap -->
                  <div class="my-2.5 p-3 rounded-xl bg-white/80 border border-gray-200/70 space-y-1.5 text-xs">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Product A (Offered):</span>
                      <span class="font-bold text-gray-900 truncate max-w-[180px]">${escapeHtml(offeredTitle)}</span>
                    </div>
                    <div class="flex items-center justify-between border-t border-gray-100 pt-1.5">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-purple-600">Product B (Target):</span>
                      <span class="font-bold text-gray-900 truncate max-w-[180px]">${escapeHtml(targetTitle)}</span>
                    </div>
                    ${cashDiff > 0 ? `
                      <div class="flex items-center justify-between border-t border-gray-100 pt-1.5 text-emerald-700 font-bold text-[11px]">
                        <span>Cash Top-Up:</span>
                        <span>+ ₹${cashDiff.toLocaleString('en-IN')}</span>
                      </div>
                    ` : ''}
                  </div>

                  <p class="text-xs text-gray-800 leading-relaxed whitespace-pre-wrap font-medium">${escapeHtml(msg.text)}</p>

                  <!-- Dual Shipment Live Milestones (When Accepted or Completed) -->
                  ${(status === 'accepted' || status === 'completed') && hasDualShipments ? `
                    <div class="mt-3 p-3 rounded-xl bg-indigo-50/80 border border-indigo-100 space-y-2 text-xs">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-800 block">📦 2-Way Courier Shipments</span>
                      <div class="p-2 rounded-lg bg-white border border-indigo-100/70 space-y-0.5">
                        <div class="flex items-center justify-between font-bold text-gray-900 text-[11px]">
                          <span>Shipment A (${escapeHtml(shipments[0].itemTitle || offeredTitle)})</span>
                          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${shipments[0].status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : 'bg-indigo-100 text-indigo-800'}">${shipments[0].status || 'Confirmed'}</span>
                        </div>
                        <div class="font-mono text-[10px] text-gray-500">AWB: ${shipments[0].trackingNumber || 'Pending'}</div>
                      </div>
                      <div class="p-2 rounded-lg bg-white border border-indigo-100/70 space-y-0.5">
                        <div class="flex items-center justify-between font-bold text-gray-900 text-[11px]">
                          <span>Shipment B (${escapeHtml(shipments[1].itemTitle || targetTitle)})</span>
                          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${shipments[1].status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : 'bg-purple-100 text-purple-800'}">${shipments[1].status || 'Confirmed'}</span>
                        </div>
                        <div class="font-mono text-[10px] text-gray-500">AWB: ${shipments[1].trackingNumber || 'Pending'}</div>
                      </div>
                    </div>
                  ` : ''}

                  <!-- Pending Actions (Owner: Accept/Decline; Proposer: Withdraw) -->
                  ${canAccept && status === 'pending' && swapIdSafe ? `
                    <div class="mt-3.5 pt-3 border-t border-indigo-200/80 flex items-center gap-2">
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'accept', this)"
                        class="flex-1 py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
                      >
                        <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                        <span>Accept Swap</span>
                      </button>
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'reject', this)"
                        class="py-2 px-3.5 rounded-xl bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-xs transition-colors flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
                        <span>Decline</span>
                      </button>
                    </div>
                  ` : ''}

                  ${canWithdraw && status === 'pending' && swapIdSafe ? `
                    <div class="mt-3 pt-2.5 border-t border-indigo-200/80 flex items-center justify-between">
                      <span class="text-[11px] text-indigo-900 font-medium">⏳ Awaiting item owner's response</span>
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'cancel', this)"
                        class="py-1.5 px-3 rounded-lg bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[11px] transition-colors flex items-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-3 h-3"></i>
                        <span>Withdraw Swap</span>
                      </button>
                    </div>
                  ` : ''}

                  ${!canAccept && !canWithdraw && status === 'pending' ? `
                    <div class="mt-3 pt-2 border-t border-indigo-200/60 text-[11px] font-semibold text-indigo-900">
                      <span>⏳ Awaiting item owner's response</span>
                    </div>
                  ` : ''}

                  <!-- Completed State: '🎉 Swap Completed' and 'View Tracking' -->
                  ${status === 'completed' ? `
                    <div class="mt-3 pt-2.5 border-t border-emerald-200/70 flex items-center justify-between gap-2">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
                        <i data-lucide="check-check" class="w-3.5 h-3.5 text-emerald-600"></i> 🎉 Swap Completed
                      </span>
                      ${transId ? `
                        <a 
                          href="/checkout/success/${transId}"
                          class="py-1.5 px-3.5 rounded-xl bg-gray-900 hover:bg-black text-white font-bold text-xs flex items-center gap-1.5 shadow-xs transition-colors cursor-pointer"
                        >
                          <i data-lucide="truck" class="w-3.5 h-3.5 text-amber-400"></i>
                          <span>View Tracking</span>
                        </a>
                      ` : ''}
                    </div>
                  ` : ''}

                  <!-- Accepted State: Replaced with '✓ Swap Accepted' and 'View Tracking' -->
                  ${status === 'accepted' ? `
                    <div class="mt-3 pt-2.5 border-t border-emerald-200/70 flex items-center justify-between gap-2">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
                        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i> ✓ Swap Accepted
                      </span>
                      ${transId ? `
                        <a 
                          href="/checkout/success/${transId}"
                          class="py-1.5 px-3.5 rounded-xl bg-gray-900 hover:bg-black text-white font-bold text-xs flex items-center gap-1.5 shadow-xs transition-colors cursor-pointer"
                        >
                          <i data-lucide="truck" class="w-3.5 h-3.5 text-amber-400"></i>
                          <span>View Tracking</span>
                        </a>
                      ` : ''}
                    </div>
                  ` : ''}

                  <!-- Declined State -->
                  ${status === 'rejected' ? `
                    <div class="mt-2.5 pt-2 border-t border-rose-200/60 flex items-center gap-1 text-[11px] font-bold text-rose-700">
                      <i data-lucide="x-circle" class="w-3.5 h-3.5 text-rose-500"></i>
                      <span>✕ Swap Declined</span>
                    </div>
                  ` : ''}

                  <span class="block text-[9px] mt-2 text-right text-gray-400">${time}</span>
                </div>
              </div>
            `;
          }

          // Standard chat text message
          return `
            <div class="flex ${isMine ? 'justify-end' : 'justify-start'} my-1.5">
              <div class="max-w-[70%] rounded-2xl px-4 py-2.5 text-xs shadow-2xs ${isMine ? 'bg-gray-900 text-white rounded-br-xs' : 'bg-white border border-gray-200 text-gray-800 rounded-bl-xs'}">
                <p class="leading-relaxed whitespace-pre-wrap font-medium">${escapeHtml(msg.text)}</p>
                <span class="block text-[9px] mt-1 text-right ${isMine ? 'text-gray-300' : 'text-gray-400'}">${time}</span>
              </div>
            </div>
          `;
        }).join('');
      }

      container.scrollTop = container.scrollHeight;
      if (window.lucide) window.lucide.createIcons();
    } catch (err) {
      container.innerHTML = '<div class="text-center text-rose-500 py-6 text-xs font-semibold">Error loading conversation.</div>';
    }
  }

  // Seller/Buyer Accept/Reject Offer directly from chat card
  window.respondOfferFromChat = async function(offerId, action, btn) {
    offerId = extractCleanHexId(offerId);
    if (!offerId) {
      showStyleswapToast('Offer reference not found. Please refresh the page.', 'error');
      return;
    }
    const verb = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Cancelling...' : 'Declining...');

    const card = btn ? btn.closest('.rounded-2xl') : null;
    const allBtns = card ? Array.from(card.querySelectorAll('button')) : (btn ? [btn] : []);
    allBtns.forEach(b => {
      b.disabled = true;
      b.style.pointerEvents = 'none';
      b.classList.add('opacity-50');
    });

    if (btn) {
      const span = btn.querySelector('span');
      if (span) span.textContent = verb;
    }

    try {
      const res = await fetch(`/api/offers/${offerId}/respond`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showStyleswapToast(data.message || (action === 'accept' ? 'Offer accepted successfully!' : 'Offer declined.'), 'success');
        await loadInboxMessages(currentListingId, currentConvId);
      } else {
        showStyleswapToast(data.message || 'Failed to respond to offer', 'error');
        allBtns.forEach(b => {
          b.disabled = false;
          b.style.pointerEvents = '';
          b.classList.remove('opacity-50');
          const span = b.querySelector('span');
          if (span && b === btn) span.textContent = action === 'accept' ? 'Accept Offer' : (action === 'cancel' ? 'Cancel Offer' : 'Decline');
        });
      }
    } catch (err) {
      showStyleswapToast('Network error responding to offer', 'error');
      allBtns.forEach(b => {
        b.disabled = false;
        b.style.pointerEvents = '';
        b.classList.remove('opacity-50');
        const span = b.querySelector('span');
        if (span && b === btn) span.textContent = action === 'accept' ? 'Accept Offer' : (action === 'cancel' ? 'Cancel Offer' : 'Decline');
      });
    }
  };

  // User Accept/Reject Swap directly from chat card
  window.respondSwapFromChat = async function(swapId, action, btn) {
    swapId = extractCleanHexId(swapId);
    if (!swapId) {
      showStyleswapToast('Swap reference not found. Please refresh and try again.', 'error');
      return;
    }
    const verb = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Withdrawing...' : 'Declining...');

    const card = btn ? btn.closest('.rounded-2xl') : null;
    const allBtns = card ? Array.from(card.querySelectorAll('button')) : (btn ? [btn] : []);
    allBtns.forEach(b => {
      b.disabled = true;
      b.style.pointerEvents = 'none';
      b.classList.add('opacity-50');
    });

    if (btn) {
      const span = btn.querySelector('span');
      if (span) span.textContent = verb;
    }

    try {
      let res = await fetch(`/api/swaps/${swapId}/respond`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
      });
      let data = await res.json();

      if (!res.ok) {
        // Fallback to /transactions/:id/respond if swap was stored as exchange transaction
        res = await fetch(`/transactions/${swapId}/respond`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
        });
        data = await res.json();
      }

      if (res.ok && data.success) {
        showStyleswapToast(data.message || (action === 'accept' ? 'Swap request accepted successfully!' : 'Swap request declined.'), 'success');
        await loadInboxMessages(currentListingId, currentConvId);
      } else {
        showStyleswapToast(data.message || 'Failed to respond to swap proposal', 'error');
        allBtns.forEach(b => {
          b.disabled = false;
          b.style.pointerEvents = '';
          b.classList.remove('opacity-50');
          const span = b.querySelector('span');
          if (span && b === btn) span.textContent = action === 'accept' ? 'Accept Swap' : (action === 'cancel' ? 'Withdraw Swap' : 'Decline');
        });
      }
    } catch (err) {
      showStyleswapToast('Network error responding to swap proposal', 'error');
      allBtns.forEach(b => {
        b.disabled = false;
        b.style.pointerEvents = '';
        b.classList.remove('opacity-50');
        const span = b.querySelector('span');
        if (span && b === btn) span.textContent = action === 'accept' ? 'Accept Swap' : (action === 'cancel' ? 'Withdraw Swap' : 'Decline');
      });
    }
  };

  async function sendInboxMessage(e) {
    e.preventDefault(); // Must be FIRST — stops page refresh
    const input = document.getElementById('inbox-input-text');
    const btn = document.getElementById('inbox-send-btn');
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;

    const convInput = document.getElementById('inbox-current-conv-id');
    const listInput = document.getElementById('inbox-current-listing-id');
    // Safe selector — avoid backslash-escaped Tailwind classes which throw DOMException
    const activeEl = document.querySelector('[id^="conv-item-"]') || null;

    let effectiveConvId = currentConvId || (convInput ? convInput.value : '') || (activeEl ? activeEl.dataset.convId : '');
    let effectiveListingId = currentListingId || (listInput ? listInput.value : '') || (activeEl ? activeEl.dataset.listingId : '');

    if (!effectiveConvId && !effectiveListingId) {
      alert('Please select a conversation to reply to.');
      return;
    }

    currentConvId = effectiveConvId;
    currentListingId = effectiveListingId;

    if (btn) {
      btn.disabled = true;
      btn.classList.add('opacity-50');
    }

    try {
      const response = await fetch('/api/chat/send', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          listingId: effectiveListingId,
          conversationId: effectiveConvId,
          text: text
        })
      });
      const data = await response.json();

      if (response.ok && data.success) {
        input.value = '';
        if (data.data && data.data.conversationId) {
          currentConvId = data.data.conversationId;
          if (convInput) convInput.value = currentConvId;
        }
        await loadInboxMessages(currentListingId, currentConvId);

        // Update preview text in sidebar
        const activeCard = document.getElementById('conv-item-' + currentConvId);
        if (activeCard) {
          const preview = activeCard.querySelector('.conv-preview-text');
          if (preview) preview.textContent = text;
        }
      } else {
        alert(data.message || 'Failed to send message');
      }
    } catch (err) {
      alert('Network error sending message. Please try again.');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-50');
      }
    }
  }

  // Auto load active or first conversation if available
  document.addEventListener('DOMContentLoaded', () => {
    // Safely attach submit handler via addEventListener (not inline onsubmit)
    // so it is guaranteed to run after ALL JavaScript above has parsed
    const sendForm = document.getElementById('inbox-send-form');
    if (sendForm) {
      sendForm.removeAttribute('onsubmit'); // remove inline attr as safety net
      sendForm.addEventListener('submit', sendInboxMessage);
    }

    // Attach click handlers to all conv items using data attributes
    document.querySelectorAll('.conv-item').forEach(card => {
      card.addEventListener('click', function() {
        selectConversation(
          this.dataset.convId,
          this.dataset.listingId,
          this.dataset.itemTitle,
          this.dataset.otherName,
          this.dataset.otherAvatar
        );
      });
    });

    const activeId = '<%= activeConversationId || "" %>';
    if (activeId) {
      const activeEl = document.getElementById('conv-item-' + activeId);
      if (activeEl) {
        activeEl.click();
        return;
      }
    }
    const firstConv = document.querySelector('.conv-item');
    if (firstConv) {
      firstConv.click();
    }
  });
</script>

<%- include('../../partials/footer') %>
