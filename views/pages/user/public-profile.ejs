<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Profile Header Banner -->
  <div class="bg-white rounded-3xl p-8 border border-[#F0ECE1] shadow-sm mb-10">
    <div class="flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-6 text-center sm:text-left">
      <img src="<%= profileUser.profileImage || '/images/default-avatar.png' %>" alt="<%= profileUser.name %>" class="w-24 h-24 rounded-full object-cover border-4 border-amber-300 shadow-md">
      <div class="space-y-2 flex-1">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <h1 class="font-display text-2xl sm:text-3xl font-bold text-gray-900"><%= profileUser.name %></h1>
          <span class="inline-flex items-center text-xs font-semibold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 self-center sm:self-auto">
            <i data-lucide="shield-check" class="w-3.5 h-3.5 mr-1 text-emerald-600"></i> Verified Artisan / Collector
          </span>
        </div>
        <p class="text-xs text-gray-500">
          Member since <%= new Date(profileUser.createdAt).getFullYear() %> • Based in <%= profileUser.address?.province || 'Bangkok' %>, <%= profileUser.address?.country || 'Thailand' %>
        </p>
        <% if (profileUser.bio) { %>
          <p class="text-sm text-gray-700 max-w-2xl leading-relaxed pt-2">
            <%= profileUser.bio %>
          </p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Listings by this user -->
  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-[#F0ECE1] pb-4">
      <h2 class="font-display text-2xl font-bold text-gray-900">
        Thai Wares by <%= profileUser.name %> (<%= listings.length %>)
      </h2>
    </div>

    <% if (listings && listings.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% listings.forEach(item => { %>
          <div class="thai-card rounded-2xl overflow-hidden flex flex-col bg-white">
            <a href="/listings/<%= item._id %>" class="relative block overflow-hidden aspect-[4/3] bg-amber-50">
              <img src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" alt="<%= item.title %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
              <div class="absolute top-2.5 left-2.5">
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full shadow-xs bg-white text-gray-800">
                  <%= item.type.toUpperCase() %>
                </span>
              </div>
            </a>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-semibold text-amber-700 uppercase tracking-wider"><%= item.category ? item.category.name : 'Thai Ware' %></span>
                <h3 class="font-semibold text-gray-900 text-sm line-clamp-1 mt-1"><%= item.title %></h3>
              </div>
              <div class="flex items-center justify-between pt-3 mt-3 border-t border-gray-100">
                <span class="text-sm font-bold text-gray-900">
                  <%= item.type === 'exchange' ? 'Trade' : `฿${Number(item.price).toLocaleString()}` %>
                </span>
                <a href="/listings/<%= item._id %>" class="text-xs font-semibold text-amber-700 hover:text-amber-800">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl p-12 text-center border border-[#F0ECE1]">
        <p class="text-sm font-semibold text-gray-500">No active listings currently available from this user.</p>
      </div>
    <% } %>
  </div>

</div>

<%- include('../../partials/footer') %>
