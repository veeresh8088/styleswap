<%- include('../../partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="mb-8 pb-6 border-b border-[#F0ECE1]">
    <div class="flex items-center space-x-2 text-xs font-semibold text-gray-500 mb-2">
      <a href="/" class="hover:text-amber-700">Home</a>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      <a href="/user/dashboard" class="hover:text-amber-700">Dashboard</a>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      <span class="text-amber-800">Profile & Settings</span>
    </div>
    <h1 class="font-display text-2xl sm:text-3xl font-bold text-gray-900">Profile & Settings</h1>
  </div>

  <div class="space-y-10">
    
    <!-- 1. Profile Details Form -->
    <form action="/user/profile" method="POST" enctype="multipart/form-data" class="bg-white rounded-3xl p-6 sm:p-10 border border-[#F0ECE1] shadow-sm space-y-6">
      <h2 class="font-display text-xl font-bold text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
        <i data-lucide="user" class="w-5 h-5 text-amber-600"></i> Personal Information
      </h2>

      <!-- Avatar & Photo -->
      <div class="flex items-center space-x-6">
        <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="<%= user.name %>" class="w-20 h-20 rounded-full object-cover border-2 border-amber-300 shadow-xs">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Change Avatar</label>
          <input type="file" name="profileImage" accept="image/*" class="text-xs text-gray-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Full Name</label>
          <input type="text" name="name" value="<%= user.name %>" required class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-900">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Email Address</label>
          <input type="email" value="<%= user.email %>" disabled class="w-full bg-gray-100 border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-500 cursor-not-allowed">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Phone Number</label>
          <input type="tel" name="phone" value="<%= user.phone || '' %>" placeholder="+66 81 234 5678" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-900">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Role</label>
          <input type="text" value="<%= user.role.toUpperCase() %>" disabled class="w-full bg-gray-100 border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-500 cursor-not-allowed font-semibold">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Short Bio / Thai Craft Specialization</label>
        <textarea name="bio" rows="3" placeholder="Tell buyers and collectors about your Thai wares collection or crafting background..." class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl p-4 text-sm text-gray-900"><%= user.bio || '' %></textarea>
      </div>

      <!-- Shipping / Exchange Delivery Address -->
      <div class="pt-4 border-t border-gray-100 space-y-4">
        <h3 class="font-bold text-gray-900 text-sm">Default Shipping / Postal Address</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <input type="text" name="street" value="<%= user.address ? user.address.street : '' %>" placeholder="Street Address, Building, Apt" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2.5 px-4 text-sm">
          </div>
          <div>
            <input type="text" name="city" value="<%= user.address ? user.address.city : '' %>" placeholder="City / District" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2.5 px-4 text-sm">
          </div>
          <div>
            <input type="text" name="province" value="<%= user.address ? user.address.province : '' %>" placeholder="Province / State" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2.5 px-4 text-sm">
          </div>
          <div>
            <input type="text" name="postalCode" value="<%= user.address ? user.address.postalCode : '' %>" placeholder="Postal Code" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2.5 px-4 text-sm">
          </div>
          <div>
            <input type="text" name="country" value="<%= user.address ? user.address.country : 'Thailand' %>" placeholder="Country" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2.5 px-4 text-sm">
          </div>
        </div>
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit" class="px-8 py-3 rounded-full btn-gold text-sm font-bold shadow-md">
          Save Profile Details
        </button>
      </div>
    </form>

    <!-- 2. Change Password Form -->
    <form id="security" action="/user/change-password" method="POST" class="bg-white rounded-3xl p-6 sm:p-10 border border-[#F0ECE1] shadow-sm space-y-6">
      <h2 class="font-display text-xl font-bold text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
        <i data-lucide="lock" class="w-5 h-5 text-amber-600"></i> Change Password
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Current Password</label>
          <input type="password" name="currentPassword" required class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 px-4 text-sm">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">New Password</label>
          <input type="password" name="newPassword" required minlength="6" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 px-4 text-sm">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Confirm New Password</label>
          <input type="password" name="confirmNewPassword" required minlength="6" class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-3 px-4 text-sm">
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button type="submit" class="px-8 py-3 rounded-full bg-gray-800 hover:bg-gray-900 text-white text-sm font-bold shadow-sm transition-colors">
          Update Password
        </button>
      </div>
    </form>

  </div>
</div>

<%- include('../../partials/footer') %>
