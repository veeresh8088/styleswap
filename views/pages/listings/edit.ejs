<%- include('../../partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-xs font-semibold text-gray-500 mb-2">
      <a href="/" class="hover:text-gray-900">Home</a>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      <a href="/listings/<%= listing._id %>" class="hover:text-gray-900"><%= listing.title %></a>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      <span class="text-gray-900">Edit Item</span>
    </div>
    <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900">Edit Second-Hand Listing</h1>
    <p class="text-sm text-gray-500 mt-1">Refine your pre-loved item details, pricing in ₹, or sizing specifications.</p>
  </div>

  <!-- AI Recommendation Assistant Box -->
  <div class="bg-gradient-to-br from-indigo-50/90 via-purple-50/60 to-violet-50/80 border border-indigo-200/80 rounded-3xl p-6 shadow-xs mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-600 text-white text-xs font-bold shadow-xs">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-300"></i> AI Listing & Valuation Assistant
        </span>
        <span class="text-xs font-semibold text-indigo-800 bg-white/90 border border-indigo-200 px-2.5 py-0.5 rounded-full">
          Re-price or Polish Copy
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 mt-4">
      <div class="sm:col-span-8">
        <input 
          type="text" 
          id="ai-prompt-input" 
          placeholder="e.g. <%= listing.title %>" 
          value="<%= listing.title %>"
          class="w-full bg-white border border-indigo-200 rounded-xl py-2.5 px-4 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 shadow-xs"
        >
      </div>
      <div class="sm:col-span-4 flex items-center gap-2">
        <button 
          type="button" 
          id="ai-generate-btn" 
          class="w-full bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white text-xs sm:text-sm font-bold py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all cursor-pointer"
        >
          <i data-lucide="sparkles" class="w-4 h-4 text-amber-300"></i>
          <span>✨ Get AI Recommendations</span>
        </button>
      </div>
    </div>

    <!-- AI Loading State -->
    <div id="ai-loading-state" class="hidden mt-4 p-4 rounded-2xl bg-white/80 border border-indigo-100 flex items-center justify-center gap-3">
      <div class="w-5 h-5 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
      <span class="text-xs font-bold text-indigo-900 animate-pulse">
        Analyzing second-hand market data and valuation in ₹...
      </span>
    </div>

    <!-- AI Results Card -->
    <div id="ai-results-card" class="hidden mt-5 bg-white rounded-2xl border border-indigo-200 p-5 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-indigo-50 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="text-xs font-bold text-gray-900 uppercase tracking-wider">AI Suggestions Ready</span>
        </div>
        <button 
          type="button" 
          id="ai-apply-all-btn" 
          class="text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-1.5 rounded-lg shadow-xs flex items-center gap-1.5 transition-all cursor-pointer"
        >
          <i data-lucide="check-check" class="w-3.5 h-3.5"></i>
          Apply All to Form
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Suggested Title -->
        <div class="bg-gray-50/80 rounded-xl p-3.5 border border-gray-100 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Suggested Title</span>
            <button type="button" id="ai-apply-title-btn" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer">
              Apply <i data-lucide="arrow-down-right" class="w-3 h-3"></i>
            </button>
          </div>
          <p id="ai-preview-title" class="text-xs font-bold text-gray-900 leading-snug"></p>
        </div>

        <!-- Suggested Price in ₹ -->
        <div class="bg-gray-50/80 rounded-xl p-3.5 border border-gray-100 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Fair Resale Price (₹)</span>
            <button type="button" id="ai-apply-price-btn" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer">
              Apply <i data-lucide="arrow-down-right" class="w-3 h-3"></i>
            </button>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="ai-preview-price" class="text-xl font-extrabold text-gray-900"></span>
            <span id="ai-preview-range" class="text-[11px] text-gray-500 font-medium"></span>
          </div>
          <p id="ai-preview-tip" class="text-[11px] text-gray-500 italic"></p>
        </div>
      </div>

      <!-- Suggested Size & Description -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-gray-50/80 rounded-xl p-3.5 border border-gray-100 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Recommended Size</span>
            <button type="button" id="ai-apply-size-btn" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer">
              Select Size <i data-lucide="arrow-down-right" class="w-3 h-3"></i>
            </button>
          </div>
          <span id="ai-preview-size" class="inline-block px-3 py-1 bg-white border border-gray-200 rounded-lg text-xs font-bold text-indigo-900"></span>
        </div>

        <div class="sm:col-span-2 bg-gray-50/80 rounded-xl p-3.5 border border-gray-100 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Condition Description</span>
            <button type="button" id="ai-apply-desc-btn" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer">
              Apply <i data-lucide="arrow-down-right" class="w-3 h-3"></i>
            </button>
          </div>
          <p id="ai-preview-desc" class="text-[11px] text-gray-700 line-clamp-3 leading-relaxed whitespace-pre-line"></p>
        </div>
      </div>
    </div>
  </div>

  <form id="listing-form" action="/listings/<%= listing._id %>/edit" method="POST" enctype="multipart/form-data" class="bg-white rounded-3xl p-6 sm:p-10 border border-gray-200 shadow-sm space-y-8">
    
    <!-- Current Photos -->
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Current Photos</label>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-4">
        <% listing.images.forEach((img, idx) => { %>
          <div class="relative group rounded-xl overflow-hidden aspect-square border border-gray-200 bg-gray-100">
            <img src="<%= img %>" alt="Photo <%= idx + 1 %>" class="w-full h-full object-cover">
          </div>
        <% }) %>
      </div>

      <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Add More Photos (Optional)</label>
      <input 
        type="file" 
        name="images" 
        id="images-input" 
        multiple 
        accept="image/*"
        class="w-full text-xs text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-gray-100 file:text-gray-900 hover:file:bg-gray-200"
      >
      <div id="image-preview-container" class="grid grid-cols-2 sm:grid-cols-5 gap-3 mt-4"></div>
    </div>

    <!-- Title & Category -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="sm:col-span-2">
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Item Title</label>
          <button 
            type="button" 
            class="ai-quick-btn text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer"
            data-target="title"
          >
            <i data-lucide="sparkles" class="w-3 h-3"></i> AI Suggest Title
          </button>
        </div>
        <input 
          type="text" 
          name="title" 
          id="listing-title-input"
          required 
          value="<%= listing.title %>"
          class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-900 font-bold focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
        >
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Category</label>
        <select name="category" id="listing-category-select" required class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-3 text-sm">
          <% categories.forEach(cat => { %>
            <option value="<%= cat._id %>" data-name="<%= cat.name %>" <%= listing.category.toString() === cat._id.toString() ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Condition</label>
        <select name="condition" id="listing-condition-select" required class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-3 text-sm">
          <% conditions.forEach(cond => { %>
            <option value="<%= cond %>" <%= listing.condition === cond ? 'selected' : '' %>><%= cond %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Dedicated Size & Measurements Section (Separate Section) -->
    <div class="pt-6 border-t border-gray-200 space-y-5 bg-gray-50/60 -mx-6 sm:-mx-10 px-6 sm:px-10 py-6 rounded-2xl border-y border-gray-200/80">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-gray-900 flex items-center gap-2">
            <i data-lucide="ruler" class="w-4 h-4 text-indigo-600"></i>
            Item Size & Body Fit Measurements <span class="text-rose-500">*</span>
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">
            Click a standard size tag or adjust custom flat measurements below.
          </p>
        </div>
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-full w-fit">
          <i data-lucide="tag" class="w-3 h-3"></i> Current Size: <%= listing.size || 'M' %>
        </span>
      </div>

      <!-- Quick Size Select Pills -->
      <div class="space-y-3">
        <!-- Tops -->
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 block mb-1.5">Tops, Tees & Jackets:</span>
          <div class="flex flex-wrap gap-2">
            <% sizes.TOPS.forEach(s => { %>
              <button 
                type="button" 
                class="size-pill px-3.5 py-1.5 rounded-xl border <%= (listing.size === s) ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-200 bg-white text-gray-700' %> text-xs font-bold hover:border-gray-900 transition-all cursor-pointer" 
                data-size="<%= s %>"
              >
                <%= s %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Bottoms -->
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 block mb-1.5">Bottoms & Waist (Inches):</span>
          <div class="flex flex-wrap gap-2">
            <% sizes.BOTTOMS.forEach(s => { %>
              <button 
                type="button" 
                class="size-pill px-3.5 py-1.5 rounded-xl border <%= (listing.size === s || listing.size === 'Waist ' + s) ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-200 bg-white text-gray-700' %> text-xs font-bold hover:border-gray-900 transition-all cursor-pointer" 
                data-size="<%= s %>"
              >
                Waist <%= s %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Footwear -->
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 block mb-1.5">Kicks & Shoes (UK / India Size):</span>
          <div class="flex flex-wrap gap-2">
            <% sizes.FOOTWEAR.forEach(s => { %>
              <button 
                type="button" 
                class="size-pill px-3.5 py-1.5 rounded-xl border <%= (listing.size === s) ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-200 bg-white text-gray-700' %> text-xs font-bold hover:border-gray-900 transition-all cursor-pointer" 
                data-size="<%= s %>"
              >
                <%= s %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Accessories & Universal -->
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 block mb-1.5">Accessories & Bags:</span>
          <div class="flex flex-wrap gap-2">
            <% sizes.ACCESSORIES.forEach(s => { %>
              <button 
                type="button" 
                class="size-pill px-3.5 py-1.5 rounded-xl border <%= (listing.size === s) ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-200 bg-white text-gray-700' %> text-xs font-bold hover:border-gray-900 transition-all cursor-pointer" 
                data-size="<%= s %>"
              >
                <%= s %>
              </button>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Size Value Input & Flat Measurements -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
            Selected Size Tag <span class="text-rose-500">*</span>
          </label>
          <input 
            type="text" 
            name="size" 
            id="listing-size-input" 
            required 
            value="<%= listing.size || 'M' %>"
            placeholder="e.g. M, Waist 32, UK 9, or Free Size" 
            class="w-full bg-white border border-gray-200 rounded-xl py-3 px-4 text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
          >
        </div>

        <div class="sm:col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
            Flat Lay Measurements (Optional)
          </label>
          <input 
            type="text" 
            name="measurements" 
            id="listing-measurements-input" 
            value="<%= listing.measurements || '' %>"
            placeholder="e.g. Pit-to-pit: 21 inches, Length: 28 inches, Waist: 32 inches" 
            class="w-full bg-white border border-gray-200 rounded-xl py-3 px-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
          >
        </div>
      </div>
    </div>

    <!-- Type, Price in ₹ & Location -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-gray-100">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Listing Intent</label>
        <select name="type" id="listing-type-select" required class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-3 text-sm font-bold">
          <option value="sell" <%= listing.type === 'sell' ? 'selected' : '' %>>Sell Only</option>
          <option value="exchange" <%= listing.type === 'exchange' ? 'selected' : '' %>>Exchange Only</option>
          <option value="both" <%= listing.type === 'both' ? 'selected' : '' %>>Both (Sell or Swap)</option>
        </select>
      </div>

      <div id="price-input-container">
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Price in ₹ (Rupees)</label>
          <button 
            type="button" 
            class="ai-quick-btn text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer"
            data-target="price"
          >
            <i data-lucide="sparkles" class="w-3 h-3"></i> AI Price
          </button>
        </div>
        <div class="relative">
          <input 
            type="number" 
            name="price" 
            id="listing-price-input"
            value="<%= listing.price %>" 
            min="0"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 pl-8 pr-3 text-sm font-bold text-gray-900"
          >
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-bold">₹</span>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Location</label>
        <input 
          type="text" 
          name="location" 
          value="<%= listing.location %>"
          class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-4 text-sm"
        >
      </div>
    </div>

    <!-- Exchange Preferences -->
    <div id="exchange-pref-container" class="<%= listing.type === 'sell' ? 'hidden' : '' %>">
      <label class="block text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1.5">Swap Wishlist</label>
      <input 
        type="text" 
        name="exchangePreferences" 
        value="<%= listing.exchangePreferences || '' %>"
        class="w-full bg-indigo-50/40 border border-indigo-200 rounded-xl py-3 px-4 text-sm"
      >
    </div>

    <!-- Description -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Second-Hand Condition & Fit</label>
        <button 
          type="button" 
          class="ai-quick-btn text-[11px] font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 cursor-pointer"
          data-target="description"
        >
          <i data-lucide="sparkles" class="w-3 h-3"></i> AI Generate Description
        </button>
      </div>
      <textarea 
        name="description" 
        id="listing-desc-input"
        rows="6" 
        required 
        class="w-full bg-gray-50 border border-gray-200 rounded-2xl p-4 text-sm leading-relaxed"
      ><%= listing.description %></textarea>
    </div>

    <!-- Submit -->
    <div class="pt-6 border-t border-gray-100 flex items-center justify-end space-x-4">
      <a href="/listings/<%= listing._id %>" class="px-6 py-3 rounded-full border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50">Cancel</a>
      <button type="submit" class="px-8 py-3 rounded-full bg-gray-900 hover:bg-black text-white text-sm font-bold shadow-md">Save Changes</button>
    </div>

  </form>

</div>

<%- include('../../partials/footer') %>
