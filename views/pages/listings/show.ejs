<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs font-semibold text-gray-500 mb-6">
    <a href="/" class="hover:text-gray-900">Home</a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <a href="/listings" class="hover:text-gray-900">Thrift Market</a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <a href="/listings?category=<%= listing.category.slug %>" class="hover:text-gray-900"><%= listing.category.name %></a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <span class="text-gray-900 truncate max-w-[200px]"><%= listing.title %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- Image Gallery (Left Column) -->
    <div class="lg:col-span-7 space-y-4">
      <div class="bg-white rounded-3xl p-3 border border-gray-200 shadow-xs overflow-hidden">
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100">
          <img 
            id="main-product-image"
            src="<%= listing.images && listing.images.length > 0 ? listing.images[0] : '/images/placeholder-item.jpg' %>" 
            alt="<%= listing.title %>" 
            class="w-full h-full object-cover"
            onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
          >

          <!-- Listing Status Overlay -->
          <% if (listing.status !== 'approved') { %>
            <div class="absolute top-4 right-4 bg-rose-600 text-white font-bold text-xs px-3 py-1.5 rounded-full uppercase tracking-wider shadow">
              <%= listing.status %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Thumbnail Selector -->
      <% if (listing.images && listing.images.length > 1) { %>
        <div class="flex items-center space-x-3 overflow-x-auto pb-2">
          <% listing.images.forEach((img, idx) => { %>
            <button 
              type="button" 
              onclick="document.getElementById('main-product-image').src='<%= img %>'"
              class="w-20 h-20 flex-shrink-0 rounded-xl overflow-hidden border-2 border-gray-200 hover:border-gray-900 focus:border-gray-900 transition-all bg-gray-100"
            >
              <img src="<%= img %>" alt="Thumbnail <%= idx + 1 %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Product Info & Action Box (Right Column) -->
    <div class="lg:col-span-5 space-y-6">
      
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs space-y-6">
        
        <!-- Header & Badges -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-700 bg-gray-100 px-3 py-1 rounded-full">
              <%= listing.category.name %>
            </span>
            <div class="flex items-center space-x-2">
              <span class="text-xs font-bold text-indigo-900 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-full flex items-center gap-1">
                <i data-lucide="ruler" class="w-3 h-3 text-indigo-600"></i> <%= listing.size || 'Free Size' %>
              </span>
              <span class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                <%= listing.condition %>
              </span>
              <span class="text-xs text-gray-400 flex items-center gap-1">
                <i data-lucide="eye" class="w-3.5 h-3.5"></i> <%= listing.viewsCount || 0 %>
              </span>
            </div>
          </div>

          <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900 leading-snug">
            <%= listing.title %>
          </h1>

          <div class="flex items-center text-xs text-gray-500 space-x-4">
            <span class="flex items-center gap-1">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-gray-500"></i> <%= listing.location || 'India' %>
            </span>
            <span>•</span>
            <span>Listed <%= new Date(listing.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          </div>
        </div>

        <!-- Size & Fit Specifications Card -->
        <div class="p-4 rounded-2xl bg-indigo-50/50 border border-indigo-100/80 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-900">
              <i data-lucide="ruler" class="w-4 h-4 text-indigo-600"></i>
              <span>Size & Fit Details</span>
            </div>
            <span class="px-3 py-1 rounded-lg bg-white border border-indigo-200 text-xs font-extrabold text-indigo-950 shadow-2xs">
              <%= listing.size || 'Free Size / Standard' %>
            </span>
          </div>
          <% if (listing.measurements) { %>
            <div class="text-xs text-gray-800 bg-white/90 p-2.5 rounded-xl border border-indigo-100 leading-relaxed font-mono">
              <span class="font-bold block text-[10px] uppercase tracking-wider text-indigo-600 mb-0.5">Flat-Lay Measurements:</span>
              <%= listing.measurements %>
            </div>
          <% } %>
        </div>

        <!-- Pricing & Exchange Availability Box -->
        <div class="p-5 rounded-2xl bg-gray-50 border border-gray-200 space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs text-gray-500 block font-medium">Price in Indian Rupees</span>
              <% if (listing.type === 'exchange') { %>
                <span class="text-2xl font-bold text-indigo-700">Open for Swap Only</span>
              <% } else { %>
                <span class="text-3xl font-extrabold text-gray-900">₹<%= Number(listing.price).toLocaleString('en-IN') %></span>
                <% if (listing.type === 'both') { %>
                  <span class="text-xs text-indigo-700 font-bold ml-2">(or Open for Swap)</span>
                <% } %>
              <% } %>
            </div>

            <!-- Badges -->
            <% if (listing.type === 'exchange') { %>
              <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">Trade Only</span>
            <% } else if (listing.type === 'both') { %>
              <span class="bg-gray-900 text-white text-xs font-bold px-3 py-1 rounded-full">Buy / Swap</span>
            <% } else { %>
              <span class="bg-gray-200 text-gray-800 text-xs font-bold px-3 py-1 rounded-full">For Sale</span>
            <% } %>
          </div>

          <% if (listing.exchangePreferences) { %>
            <div class="pt-3 border-t border-gray-200 text-xs text-gray-700">
              <span class="font-bold text-gray-900 block mb-1">Seller's Swap Wishlist:</span>
              <p class="italic text-gray-600">"<%= listing.exchangePreferences %>"</p>
            </div>
          <% } %>
        </div>

        <!-- Action CTAs -->
        <div class="space-y-3 pt-2">
          <% if (!isOwner) { %>
            <% if (listing.status === 'approved') { %>
              
              <!-- Offer Status Badge if Buyer already submitted an offer -->
              <% if (typeof userActiveOffer !== 'undefined' && userActiveOffer) { %>
                <div class="p-3 rounded-2xl border text-xs font-semibold flex items-center justify-between <%= userActiveOffer.status === 'accepted' ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : (userActiveOffer.status === 'rejected' ? 'bg-rose-50 border-rose-200 text-rose-900' : 'bg-amber-50 border-amber-200 text-amber-900') %>">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full <%= userActiveOffer.status === 'accepted' ? 'bg-emerald-500' : (userActiveOffer.status === 'rejected' ? 'bg-rose-500' : 'bg-amber-500 animate-pulse') %>"></span>
                    <span>Your Offer: <strong>₹<%= Number(userActiveOffer.offeredPrice).toLocaleString('en-IN') %></strong></span>
                  </div>
                  <span class="font-bold uppercase tracking-wider text-[10px] px-2 py-0.5 rounded-full <%= userActiveOffer.status === 'accepted' ? 'bg-emerald-200 text-emerald-800' : (userActiveOffer.status === 'rejected' ? 'bg-rose-200 text-rose-800' : 'bg-amber-200 text-amber-800') %>">
                    <%= userActiveOffer.status === 'accepted' ? 'Offer Accepted' : (userActiveOffer.status === 'rejected' ? 'Offer Rejected' : 'Offer Pending') %>
                  </span>
                </div>
              <% } %>

              <!-- Buy Direct & Add to Bag Buttons -->
              <% if (listing.type === 'sell' || listing.type === 'both') { %>
                <% const buyPrice = (typeof userActiveOffer !== 'undefined' && userActiveOffer && userActiveOffer.status === 'accepted') ? userActiveOffer.offeredPrice : listing.price; %>
                <% if (currentUser) { %>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <a 
                      href="/checkout/<%= listing._id %>"
                      class="w-full py-3.5 px-3 rounded-2xl bg-gray-900 hover:bg-black text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all"
                    >
                      <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
                      <span>Buy Direct (₹<%= Number(buyPrice).toLocaleString('en-IN') %>)</span>
                    </a>

                    <form action="/cart/add/<%= listing._id %>" method="POST" class="w-full">
                      <button 
                        type="submit" 
                        class="w-full py-3.5 px-3 rounded-2xl bg-indigo-50 border-2 border-indigo-200 hover:bg-indigo-100 text-indigo-950 text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all cursor-pointer shadow-xs"
                      >
                        <i data-lucide="shopping-bag" class="w-4 h-4 text-indigo-600"></i>
                        <span>Add to Bag</span>
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <a 
                      href="/auth/login?redirect=/checkout/<%= listing._id %>" 
                      class="w-full py-3.5 px-4 rounded-2xl bg-gray-900 hover:bg-black text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2"
                    >
                      <i data-lucide="log-in" class="w-4 h-4"></i>
                      <span>Sign in to Buy</span>
                    </a>
                    <a 
                      href="/auth/login?redirect=/listings/<%= listing._id %>" 
                      class="w-full py-3.5 px-4 rounded-2xl bg-indigo-50 border-2 border-indigo-200 hover:bg-indigo-100 text-indigo-950 text-xs sm:text-sm font-bold flex items-center justify-center gap-2"
                    >
                      <i data-lucide="shopping-bag" class="w-4 h-4 text-indigo-600"></i>
                      <span>Add to Bag</span>
                    </a>
                  </div>
                <% } %>
              <% } %>

              <!-- Dual Communication Buttons: Message Seller & Make an Offer -->
              <div class="grid grid-cols-2 gap-2.5">
                <% if (currentUser) { %>
                  <!-- Message Seller Button (Direct page + modal) -->
                  <div class="relative flex">
                    <button 
                      type="button" 
                      onclick="openChatModal()"
                      class="flex-1 py-2.5 pl-3 pr-2 rounded-l-2xl bg-white border border-gray-300 hover:bg-gray-50 text-gray-900 text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 shadow-2xs transition-colors cursor-pointer"
                    >
                      <i data-lucide="message-circle" class="w-4 h-4 text-indigo-600"></i>
                      <span>Message</span>
                    </button>
                    <a 
                      href="/messages/<%= listing._id %>"
                      title="Open Dedicated Full Chat Page"
                      class="py-2.5 px-2.5 rounded-r-2xl bg-gray-50 border-y border-r border-gray-300 hover:bg-gray-100 text-gray-600 flex items-center justify-center text-xs"
                    >
                      <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>

                  <!-- Make an Offer Button (Direct page + modal) -->
                  <div class="relative flex">
                    <button 
                      type="button" 
                      onclick="openOfferModal()"
                      class="flex-1 py-2.5 pl-3 pr-2 rounded-l-2xl bg-amber-50 border border-amber-200 hover:bg-amber-100 text-amber-900 text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 shadow-2xs transition-colors cursor-pointer"
                    >
                      <i data-lucide="tag" class="w-4 h-4 text-amber-600"></i>
                      <span>Make Offer</span>
                    </button>
                    <a 
                      href="/listings/<%= listing._id %>/offer"
                      title="Open Dedicated Offer Page"
                      class="py-2.5 px-2.5 rounded-r-2xl bg-amber-100/70 border-y border-r border-amber-200 hover:bg-amber-200 text-amber-800 flex items-center justify-center text-xs"
                    >
                      <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>
                <% } else { %>
                  <a 
                    href="/auth/login?redirect=/messages/<%= listing._id %>"
                    class="w-full py-2.5 px-3 rounded-2xl bg-white border border-gray-300 hover:bg-gray-50 text-gray-900 text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 shadow-2xs transition-colors cursor-pointer"
                  >
                    <i data-lucide="message-circle" class="w-4 h-4 text-indigo-600"></i>
                    <span>Message Seller</span>
                  </a>
                  <a 
                    href="/auth/login?redirect=/listings/<%= listing._id %>/offer"
                    class="w-full py-2.5 px-3 rounded-2xl bg-amber-50 border border-amber-200 hover:bg-amber-100 text-amber-900 text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 shadow-2xs transition-colors cursor-pointer"
                  >
                    <i data-lucide="tag" class="w-4 h-4 text-amber-600"></i>
                    <span>Make an Offer</span>
                  </a>
                <% } %>
              </div>

              <!-- Propose Exchange / Barter Button (Direct page + modal) -->
              <% if (currentUser) { %>
                <div class="flex items-center gap-2">
                  <a 
                    href="/listings/<%= listing._id %>/swap"
                    class="flex-1 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-colors shadow-xs hover:shadow cursor-pointer"
                  >
                    <i data-lucide="repeat" class="w-4 h-4"></i>
                    <span>Propose Item Swap / Barter</span>
                  </a>
                  <button 
                    type="button" 
                    onclick="openModal('exchange-modal')"
                    title="Quick Swap Modal"
                    class="py-3.5 px-3.5 rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 transition-colors cursor-pointer"
                  >
                    <i data-lucide="layers" class="w-4 h-4"></i>
                  </button>
                </div>
              <% } else { %>
                <a 
                  href="/auth/login?redirect=/listings/<%= listing._id %>/swap" 
                  class="w-full py-3.5 rounded-2xl bg-indigo-50 border-2 border-indigo-200 hover:bg-indigo-100 text-indigo-900 text-base font-bold flex items-center justify-center gap-2 transition-colors shadow-xs hover:shadow cursor-pointer"
                >
                  <i data-lucide="repeat" class="w-5 h-5 text-indigo-600"></i>
                  Propose Item Swap / Barter
                </a>
              <% } %>

              <!-- Cash Buy Option for Exchange-Only Listings -->
              <% if (listing.type === 'exchange') { %>
                <% if (currentUser) { %>
                  <a 
                    href="/checkout/<%= listing._id %>"
                    class="w-full py-3 rounded-2xl bg-emerald-50 border border-emerald-300 hover:bg-emerald-100 text-emerald-950 text-sm font-bold flex items-center justify-center gap-2 transition-colors"
                  >
                    <i data-lucide="banknote" class="w-4 h-4 text-emerald-700"></i>
                    Make Instant Cash Purchase (₹<%= Number(listing.price).toLocaleString('en-IN') %>)
                  </a>
                <% } else { %>
                  <a 
                    href="/auth/login?redirect=/checkout/<%= listing._id %>"
                    class="w-full py-3 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-950 text-sm font-bold flex items-center justify-center gap-2"
                  >
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    Sign in to Buy with Cash (₹<%= Number(listing.price).toLocaleString('en-IN') %>)
                  </a>
                <% } %>
              <% } %>

            <% } else { %>
              <div class="p-4 rounded-2xl bg-gray-100 text-center text-gray-500 font-semibold text-sm">
                This item is <%= listing.status %> and no longer available.
              </div>
            <% } %>

          <% } else { %>
            <!-- Owner Control Panel -->
            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-200 space-y-4">
              <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1">
                  <i data-lucide="user-check" class="w-4 h-4 text-emerald-600"></i> You own this listing
                </p>
                <span class="text-[11px] font-bold text-indigo-700">Seller Dashboard</span>
              </div>
              <div class="flex items-center gap-3">
                <a href="/listings/<%= listing._id %>/edit" class="flex-1 py-2 text-center bg-white border border-gray-300 rounded-xl text-xs font-bold text-gray-900 hover:bg-gray-100 transition-colors">
                  Edit Item
                </a>
                <form action="/listings/<%= listing._id %>/delete" method="POST" class="flex-1" onsubmit="return confirm('Delete this listing?');">
                  <button type="submit" class="w-full py-2 bg-rose-50 border border-rose-200 rounded-xl text-xs font-bold text-rose-700 hover:bg-rose-100 transition-colors">
                    Delete
                  </button>
                </form>
              </div>

              <!-- Pending Offers for Seller -->
              <% if (typeof sellerIncomingOffers !== 'undefined' && sellerIncomingOffers.length > 0) { %>
                <div class="pt-3 border-t border-gray-200 space-y-2.5">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-gray-600 block">Pending Price Offers (<%= sellerIncomingOffers.length %>)</span>
                  <% sellerIncomingOffers.forEach(off => { %>
                    <div class="bg-white p-3 rounded-xl border border-gray-200 space-y-2 text-xs" id="offer-card-<%= off._id %>">
                      <div class="flex items-center justify-between">
                        <span class="font-bold text-gray-900"><%= off.buyerId ? off.buyerId.name : 'Buyer' %></span>
                        <span class="font-extrabold text-emerald-700 text-sm">₹<%= Number(off.offeredPrice).toLocaleString('en-IN') %></span>
                      </div>
                      <% if (off.message) { %>
                        <p class="text-gray-500 italic text-[11px]">"<%= off.message %>"</p>
                      <% } %>
                      <div class="flex items-center justify-end gap-2 pt-1">
                        <button type="button" onclick="respondToOfferAction('<%= off._id %>', 'reject')" class="px-3 py-1 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-[11px] font-bold">Reject</button>
                        <button type="button" onclick="respondToOfferAction('<%= off._id %>', 'accept')" class="px-3.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold shadow-2xs">Accept Offer</button>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <!-- Pending Swaps for Seller -->
              <% if (typeof sellerIncomingSwaps !== 'undefined' && sellerIncomingSwaps.length > 0) { %>
                <div class="pt-3 border-t border-gray-200 space-y-2.5">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 block">Pending Swap Requests (<%= sellerIncomingSwaps.length %>)</span>
                  <% sellerIncomingSwaps.forEach(swp => { %>
                    <div class="bg-white p-3 rounded-xl border border-gray-200 space-y-2 text-xs" id="swap-card-<%= swp._id %>">
                      <div class="flex items-center space-x-2.5">
                        <img src="<%= swp.offeredListingId && swp.offeredListingId.images ? swp.offeredListingId.images[0] : '/images/placeholder-item.jpg' %>" class="w-10 h-10 rounded-lg object-cover">
                        <div class="flex-1 min-w-0">
                          <p class="font-bold text-gray-900 truncate"><%= swp.offeredListingId ? swp.offeredListingId.title : 'Item' %></p>
                          <p class="text-[10px] text-gray-500">From: <%= swp.proposerId ? swp.proposerId.name : 'User' %></p>
                        </div>
                        <% if (swp.cashTopUp > 0) { %>
                          <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">+₹<%= swp.cashTopUp %></span>
                        <% } %>
                      </div>
                      <div class="flex items-center justify-end gap-1.5 pt-1">
                        <button type="button" onclick="respondToSwapAction('<%= swp._id %>', 'reject')" class="px-2.5 py-1 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-[11px] font-bold">Reject</button>
                        <button type="button" onclick="openCounterSwapModal('<%= swp._id %>', '<%= swp.proposerId ? swp.proposerId.name : 'User' %>')" class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-800 hover:bg-indigo-100 text-[11px] font-bold">Counter</button>
                        <button type="button" onclick="respondToSwapAction('<%= swp._id %>', 'accept')" class="px-3 py-1 rounded-lg bg-gray-900 hover:bg-black text-white text-[11px] font-bold">Accept Swap</button>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>


        <!-- Seller Profile Card -->
        <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <img src="<%= listing.sellerId.profileImage || '/images/default-avatar.png' %>" alt="<%= listing.sellerId.name %>" class="w-12 h-12 rounded-full object-cover border border-gray-200">
            <div>
              <h4 class="text-sm font-bold text-gray-900"><%= (listing.sellerId && listing.sellerId.name) ? listing.sellerId.name : 'Styleswap Verified Member' %></h4>
              <p class="text-xs text-gray-500"><%= listing.location || 'India' %></p>
            </div>
          </div>
          <% if (listing.sellerId && listing.sellerId._id) { %>
            <a href="/user/<%= listing.sellerId._id %>/profile" class="text-xs font-bold text-gray-900 hover:text-black border border-gray-200 px-3 py-1.5 rounded-lg hover:bg-gray-50 transition-colors">
              View Closet
            </a>
          <% } %>
        </div>

      </div>

    </div>

    <!-- Full Description Section -->
    <div class="lg:col-span-12">
      <div class="bg-white rounded-3xl p-8 border border-gray-200 shadow-xs space-y-6">
        <h3 class="font-display text-xl font-bold text-gray-900 border-b border-gray-100 pb-4">
          Second-Hand Condition & Fit Details
        </h3>
        <div class="prose max-w-none text-gray-700 text-sm sm:text-base leading-relaxed whitespace-pre-line">
          <%= listing.description %>
        </div>
      </div>
    </div>

  </div>

  <!-- Related Listings in Same Category -->
  <% if (relatedListings && relatedListings.length > 0) { %>
    <div class="mt-16 pt-12 border-t border-gray-200">
      <h3 class="font-display text-2xl font-bold text-gray-900 mb-8">Related Items in <%= listing.category.name %></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% relatedListings.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden flex flex-col group hover:shadow-md transition-all">
            <a href="/listings/<%= item._id %>" class="relative block overflow-hidden aspect-[4/3] bg-gray-100">
              <img 
                src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" 
                alt="<%= item.title %>" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
              >
            </a>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <a href="/listings/<%= item._id %>" class="font-bold text-gray-900 text-sm hover:text-indigo-600 transition-colors line-clamp-1">
                <%= item.title %>
              </a>
              <div class="flex items-center justify-between pt-2 mt-2 border-t border-gray-100">
                <span class="text-sm font-extrabold text-gray-900">₹<%= Number(item.price).toLocaleString('en-IN') %></span>
                <a href="/listings/<%= item._id %>" class="text-xs font-semibold text-gray-700 hover:text-black">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>

<!-- 1. BUY CONFIRMATION MODAL -->
<% if (currentUser && !isOwner) { %>
  <div id="buy-modal" class="hidden fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-200 animate-in fade-in zoom-in-95 duration-200">
      
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <h3 class="font-display font-bold text-xl text-gray-900 flex items-center gap-2">
          <i data-lucide="shopping-bag" class="w-5 h-5 text-gray-900"></i> Checkout Order
        </h3>
        <button type="button" onclick="closeModal('buy-modal')" class="text-gray-400 hover:text-gray-600 p-1">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form action="/transactions/buy" method="POST" class="mt-5 space-y-4">
        <input type="hidden" name="listingId" value="<%= listing._id %>">

        <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-gray-500">Selected Item</p>
            <p class="font-bold text-gray-900 text-sm"><%= listing.title %></p>
          </div>
          <span class="text-xl font-extrabold text-gray-900">₹<%= Number(listing.price).toLocaleString('en-IN') %></span>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Delivery Address in India</label>
          <textarea 
            name="deliveryAddress" 
            rows="3" 
            required
            class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
            placeholder="Recipient Name, House/Flat No, Street, Landmark, City, State, PIN Code, Phone..."
          ><%= currentUser.formattedAddress || '' %></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Note to Seller (Optional)</label>
          <input 
            type="text" 
            name="notes" 
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm"
            placeholder="Courier preferences, packaging notes..."
          >
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3">
          <button type="button" onclick="closeModal('buy-modal')" class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gray-900 hover:bg-black text-white text-sm font-bold shadow-md">
            Complete Order (₹<%= Number(listing.price).toLocaleString('en-IN') %>)
          </button>
