    </div>
  </div>
<% } %>

<!-- 2. PROPOSE EXCHANGE MODAL -->
<% if (currentUser && !isOwner) { %>
  <div id="exchange-modal" class="hidden fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-gray-200 animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] flex flex-col">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 border-b border-gray-100 flex-shrink-0">
        <div>
          <h3 class="font-display font-bold text-xl text-gray-900 flex items-center gap-2">
            <i data-lucide="repeat" class="w-5 h-5 text-indigo-600"></i> Propose Wardrobe Swap
          </h3>
          <p class="text-xs text-gray-500 mt-1">Trading for: <span class="font-bold text-gray-900">"<%= listing.title %>"</span> (<%= listing.size || 'Standard' %>)</p>
        </div>
        <button type="button" onclick="closeModal('exchange-modal')" class="text-gray-400 hover:text-gray-600 p-1.5 rounded-full hover:bg-gray-100 transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Mode Switcher Tabs (if user has existing items) -->
      <% const hasItems = userExchangeableItems && userExchangeableItems.length > 0; %>
      <div class="flex items-center space-x-2 pt-3 pb-1 border-b border-gray-100 flex-shrink-0">
        <% if (hasItems) { %>
          <button 
            type="button" 
            id="tab-btn-closet" 
            onclick="switchSwapTab('closet')"
            class="px-4 py-2 text-xs font-bold rounded-xl bg-indigo-50 text-indigo-900 border border-indigo-200 transition-all flex items-center gap-1.5"
          >
            <i data-lucide="shirt" class="w-3.5 h-3.5 text-indigo-600"></i>
            From My Wardrobe (<%= userExchangeableItems.length %>)
          </button>
        <% } %>
        <button 
          type="button" 
          id="tab-btn-quick" 
          onclick="switchSwapTab('quick')"
          class="px-4 py-2 text-xs font-bold rounded-xl <%= hasItems ? 'bg-gray-50 text-gray-600 border border-transparent hover:bg-gray-100' : 'bg-indigo-50 text-indigo-900 border border-indigo-200' %> transition-all flex items-center gap-1.5"
        >
          <i data-lucide="plus-circle" class="w-3.5 h-3.5 text-indigo-600"></i>
          <%= hasItems ? 'Offer Another Item from Closet' : 'Offer Item from Your Closet' %>
        </button>
      </div>

      <!-- Form Container -->
      <form action="/transactions/exchange" method="POST" id="swap-proposal-form" class="mt-4 space-y-4 flex-1 overflow-y-auto pr-1">
        <input type="hidden" name="listingId" value="<%= listing._id %>">
        <input type="hidden" name="exchangeItemId" id="selected-exchange-item-id" value="">

        <!-- PANE 1: Choose From Existing Wardrobe (if user has items) -->
        <% if (hasItems) { %>
          <div id="pane-swap-closet" class="space-y-3">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">
                1. Select Item to Barter:
              </label>
              <span id="selected-item-indicator" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> Selected
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-52 overflow-y-auto p-1 border border-gray-100 rounded-2xl bg-gray-50/50">
              <% userExchangeableItems.forEach(myItem => { %>
                <div 
                  id="card-item-<%= myItem._id %>"
                  data-item-id="<%= myItem._id %>"
                  data-item-title="<%= (myItem.title || '').replace(/"/g, '&quot;') %>"
                  onclick="selectExchangeItem(this)"
                  class="exchange-select-card cursor-pointer p-3 rounded-2xl border border-gray-200 bg-white hover:border-indigo-400 hover:shadow-xs flex items-center space-x-3 transition-all relative group"
                >
                  <img 
                    src="<%= myItem.images && myItem.images.length > 0 ? myItem.images[0] : '/images/placeholder-item.jpg' %>" 
                    alt="<%= myItem.title %>" 
                    class="w-14 h-14 rounded-xl object-cover flex-shrink-0 border border-gray-200" 
                    onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
                  >
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-gray-900 truncate group-hover:text-indigo-600 transition-colors"><%= myItem.title %></p>
                    <p class="text-[11px] text-gray-500"><%= myItem.size || 'Standard' %> • <%= myItem.condition %></p>
                    <p class="text-xs font-extrabold text-gray-900 mt-0.5">Value: ₹<%= Number(myItem.price).toLocaleString('en-IN') %></p>
                  </div>
                  <div class="selection-check hidden absolute top-2 right-2 w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center shadow-xs">
                    <i data-lucide="check" class="w-3 h-3"></i>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- PANE 2: Quick Offer Form (for users without items OR wishing to offer unlisted piece) -->
        <div id="pane-swap-quick" class="<%= hasItems ? 'hidden' : '' %> space-y-3">
          <div class="bg-indigo-50/70 p-3.5 rounded-2xl border border-indigo-100 flex items-start gap-2.5">
            <i data-lucide="sparkles" class="w-4 h-4 text-indigo-600 mt-0.5 flex-shrink-0"></i>
            <p class="text-xs text-indigo-950 leading-relaxed">
              Describe the pre-loved garment or footwear you want to offer in trade. We will automatically create the item in your wardrobe and send the barter offer!
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Item Title / Name <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              name="offerTitle" 
              id="offer-title-input"
              placeholder="e.g. Vintage Levi's 501 Straight Jeans (Waist 32) or Oversized Hoodie..." 
              oninput="checkQuickOfferValidity()"
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
            >
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Category</label>
              <select name="offerCategory" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= (listing.category && cat._id.toString() === (listing.category._id || listing.category).toString()) ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }) %>
                <% } else if (listing.category) { %>
                  <option value="<%= listing.category._id || listing.category %>"><%= listing.category.name || 'Category' %></option>
                <% } %>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Size</label>
              <select name="offerSize" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                <option value="S">S</option>
                <option value="M" selected>M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="30">Waist 30</option>
                <option value="32">Waist 32</option>
                <option value="34">Waist 34</option>
                <option value="UK 8">UK 8</option>
                <option value="UK 9">UK 9</option>
                <option value="UK 10">UK 10</option>
                <option value="Free Size / Standard">Free Size / Standard</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Condition</label>
              <select name="offerCondition" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                <option value="Like New (Barely Worn)">Like New</option>
                <option value="Gently Used (Good Condition)" selected>Gently Used</option>
                <option value="Thrifted / Vintage Fade">Thrifted / Vintage</option>
                <option value="Well Worn (Minor Flaws)">Well Worn</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Estimated Item Valuation (₹)</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-500">₹</span>
              <input 
                type="number" 
                name="offerPrice" 
                id="exchange-item-valuation"
                min="0"
                placeholder="<%= listing.price || 999 %>" 
                class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-8 pr-3.5 py-2 text-xs font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
              >
            </div>
          </div>
        </div>

        <!-- Cash Difference / Top-Up (₹) (Common to both modes) -->
        <div class="bg-indigo-50/60 p-4 rounded-2xl border border-indigo-100 space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold uppercase tracking-wider text-indigo-950 flex items-center gap-1.5">
              <i data-lucide="banknote" class="w-4 h-4 text-emerald-600"></i>
              Add Cash Difference / Top-Up (₹)
            </label>
            <span class="text-[10px] font-bold text-indigo-700 bg-white px-2 py-0.5 rounded-full border border-indigo-200">Optional</span>
          </div>
          <p class="text-[11px] text-gray-600">
            Offering a lower value item? Add extra cash in ₹ to balance the exchange.
          </p>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-gray-500">₹</span>
            <input 
              type="number" 
              name="cashTopUp" 
              id="cash-topup-input"
              min="0" 
              step="50"
              placeholder="0 (Pure Item Barter)" 
              class="w-full bg-white border border-gray-200 rounded-xl pl-8 pr-4 py-2.5 text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
            >
          </div>
          <div class="flex items-center gap-2 pt-0.5">
            <span class="text-[11px] font-semibold text-gray-500">Quick add:</span>
            <button type="button" onclick="document.getElementById('cash-topup-input').value = 200" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-gray-100">+₹200</button>
            <button type="button" onclick="document.getElementById('cash-topup-input').value = 500" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-gray-100">+₹500</button>
            <button type="button" onclick="document.getElementById('cash-topup-input').value = 1000" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-gray-100">+₹1,000</button>
            <button type="button" onclick="document.getElementById('cash-topup-input').value = ''" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-white border border-gray-200 text-gray-400 hover:text-gray-600">Clear</button>
          </div>
        </div>

        <!-- Note to Owner -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Note to Owner (Optional)</label>
          <textarea 
            name="notes" 
            rows="2" 
            class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
            placeholder="Tell the seller why this is a great swap, fit/sizing details, courier preferences..."
          ></textarea>
        </div>

        <!-- Actions -->
        <div class="pt-3 flex items-center justify-end space-x-3 flex-shrink-0 border-t border-gray-100">
          <button type="button" onclick="closeModal('exchange-modal')" class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50">
            Cancel
          </button>
          <button 
            id="submit-exchange-btn" 
            type="submit" 
            <%= hasItems ? 'disabled' : 'disabled' %>
            class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-bold shadow-md transition-colors flex items-center gap-1.5"
          >
            <i data-lucide="repeat" class="w-4 h-4"></i>
            <span id="submit-exchange-btn-text">Send Swap Offer</span>
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- Swap Modal Script -->
  <script>
    // Tab Switcher between Closet Items & Quick Offer
    window.switchSwapTab = function(mode) {
      const paneCloset = document.getElementById('pane-swap-closet');
      const paneQuick = document.getElementById('pane-swap-quick');
      const btnCloset = document.getElementById('tab-btn-closet');
      const btnQuick = document.getElementById('tab-btn-quick');
      const hiddenItemId = document.getElementById('selected-exchange-item-id');
      const submitBtn = document.getElementById('submit-exchange-btn');
      const submitBtnText = document.getElementById('submit-exchange-btn-text');

      if (mode === 'closet' && paneCloset) {
        paneCloset.classList.remove('hidden');
        if (paneQuick) paneQuick.classList.add('hidden');
        if (btnCloset) {
          btnCloset.className = 'px-4 py-2 text-xs font-bold rounded-xl bg-indigo-50 text-indigo-900 border border-indigo-200 transition-all flex items-center gap-1.5';
        }
        if (btnQuick) {
          btnQuick.className = 'px-4 py-2 text-xs font-bold rounded-xl bg-gray-50 text-gray-600 border border-transparent hover:bg-gray-100 transition-all flex items-center gap-1.5';
        }
        // Check if an item is currently selected
        if (hiddenItemId && hiddenItemId.value) {
          if (submitBtn) submitBtn.disabled = false;
        } else {
          if (submitBtn) submitBtn.disabled = true;
          if (submitBtnText) submitBtnText.textContent = 'Select an Item to Swap';
        }
      } else if (mode === 'quick' && paneQuick) {
        paneQuick.classList.remove('hidden');
        if (paneCloset) paneCloset.classList.add('hidden');
        if (btnQuick) {
          btnQuick.className = 'px-4 py-2 text-xs font-bold rounded-xl bg-indigo-50 text-indigo-900 border border-indigo-200 transition-all flex items-center gap-1.5';
        }
        if (btnCloset) {
          btnCloset.className = 'px-4 py-2 text-xs font-bold rounded-xl bg-gray-50 text-gray-600 border border-transparent hover:bg-gray-100 transition-all flex items-center gap-1.5';
        }
        checkQuickOfferValidity();
      }
      if (window.lucide) window.lucide.createIcons();
    };

    // Item Selection Handler
    window.selectExchangeItem = function(cardEl) {
      if (!cardEl) return;
      const itemId = cardEl.getAttribute('data-item-id');
      const itemTitle = cardEl.getAttribute('data-item-title') || '';

      // Remove active state from all cards
      document.querySelectorAll('.exchange-select-card').forEach(function(c) {
        c.classList.remove('border-indigo-600', 'ring-2', 'ring-indigo-500/30', 'bg-indigo-50/50');
        c.classList.add('border-gray-200', 'bg-white');
        const checkIcon = c.querySelector('.selection-check');
        if (checkIcon) checkIcon.classList.add('hidden');
      });

      // Highlight selected card
      cardEl.classList.remove('border-gray-200', 'bg-white');
      cardEl.classList.add('border-indigo-600', 'ring-2', 'ring-indigo-500/30', 'bg-indigo-50/50');
      const checkIcon = cardEl.querySelector('.selection-check');
      if (checkIcon) checkIcon.classList.remove('hidden');

      // Update hidden input
      const hiddenInput = document.getElementById('selected-exchange-item-id');
      if (hiddenInput) {
        hiddenInput.value = itemId;
      }

      // Show indicator badge
      const indicator = document.getElementById('selected-item-indicator');
      if (indicator) indicator.classList.remove('hidden');

      // Enable submit button
      const submitBtn = document.getElementById('submit-exchange-btn');
      const submitBtnText = document.getElementById('submit-exchange-btn-text');
      if (submitBtn) {
        submitBtn.disabled = false;
        if (submitBtnText) {
          submitBtnText.textContent = itemTitle ? 'Send Swap Offer with "' + itemTitle.slice(0, 20) + '..."' : 'Send Swap Offer';
        }
      }
      if (window.lucide) window.lucide.createIcons();
    };

    // Quick Offer Input Validation
    window.checkQuickOfferValidity = function() {
      const titleInput = document.getElementById('offer-title-input');
      const submitBtn = document.getElementById('submit-exchange-btn');
      const submitBtnText = document.getElementById('submit-exchange-btn-text');

      if (titleInput && titleInput.value.trim().length >= 3) {
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnText) submitBtnText.textContent = 'Send Swap Offer';
      } else {
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Enter Item Title';
      }
    };
  </script>
<% } %>

<!-- 3. PRODUCT-LINKED CHAT MODAL (FEATURE 2) -->
<% if (currentUser) { %>
  <div id="chat-modal" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-lg w-full h-[580px] flex flex-col shadow-2xl border border-gray-200 overflow-hidden animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Chat Header -->
      <div class="p-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between flex-shrink-0">
        <div class="flex items-center space-x-3">
          <img src="<%= isOwner ? '/images/default-avatar.png' : (listing.sellerId && listing.sellerId.profileImage ? listing.sellerId.profileImage : '/images/default-avatar.png') %>" class="w-10 h-10 rounded-full object-cover border border-gray-200" alt="">
