          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Chat Messages Scrollable Box -->
      <div id="chat-messages-container" class="flex-1 p-4 overflow-y-auto space-y-3 bg-gray-50/50 text-xs">
        <div class="text-center text-gray-400 text-[11px] py-4" id="chat-loading-notice">
          Loading conversation...
        </div>
      </div>

      <!-- Chat Input Footer -->
      <form id="chat-send-form" onsubmit="sendChatMessage(event)" class="p-3 bg-white border-t border-gray-200 flex items-center gap-2 flex-shrink-0">
        <input 
          type="text" 
          id="chat-input-text" 
          placeholder="Type your message about this piece..." 
          required 
          autocomplete="off"
          class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-xs text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600"
        >
        <button type="submit" id="chat-send-btn" class="p-2.5 rounded-xl bg-gray-900 hover:bg-black text-white shadow-xs transition-colors">
          <i data-lucide="send" class="w-4 h-4"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- 4. MAKE AN OFFER MODAL (FEATURE 2) -->
  <div id="offer-modal" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-gray-200 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center">
            <i data-lucide="tag" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="font-display font-extrabold text-lg text-gray-900">Make an Offer</h3>
            <p class="text-[11px] text-gray-500">Negotiate a fair pre-loved price in ₹</p>
          </div>
        </div>
        <button type="button" onclick="closeModal('offer-modal')" class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="submit-offer-form" onsubmit="submitPriceOffer(event)" class="mt-5 space-y-4">
        <!-- Item Asking Price Callout -->
        <div class="p-3.5 rounded-2xl bg-gray-50 border border-gray-200 flex items-center justify-between">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 block">Product Asking Price</span>
            <p class="text-xs font-bold text-gray-900 truncate max-w-[200px]"><%= listing.title %></p>
          </div>
          <span class="text-xl font-extrabold text-gray-900">₹<%= Number(listing.price).toLocaleString('en-IN') %></span>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Your Offer Price *</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-extrabold text-gray-500">₹</span>
            <input 
              type="number" 
              id="offer-price-input" 
              name="offeredPrice" 
              required 
              min="1" 
              max="<%= listing.price || 999999 %>"
              value="<%= Math.round((listing.price || 500) * 0.85) %>"
              placeholder="e.g. 900"
              class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-8 pr-3.5 py-2.5 text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-600"
            >
          </div>
          <p class="text-[11px] text-gray-400 mt-1">Suggested counter: ~10% to 20% below asking price</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Note to Seller (Optional)</label>
          <input 
            type="text" 
            id="offer-message-input" 
            name="message" 
            placeholder="e.g. Ready to purchase right now if accepted!"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
          >
        </div>

        <div id="offer-feedback" class="hidden p-3 rounded-xl text-xs font-bold"></div>

        <div class="pt-2 flex items-center justify-end space-x-2">
          <button type="button" onclick="closeModal('offer-modal')" class="px-4 py-2.5 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition-colors">
            Cancel
          </button>
          <button type="submit" id="offer-submit-btn" class="px-6 py-2.5 rounded-xl bg-gray-900 hover:bg-black text-white text-xs font-bold shadow-md transition-colors">
            Send Offer
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 5. SELLER COUNTER SWAP MODAL -->
  <div id="counter-swap-modal" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-gray-200 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <h3 class="font-display font-extrabold text-lg text-gray-900">Make Counter Swap Offer</h3>
        <button type="button" onclick="closeModal('counter-swap-modal')" class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="counter-swap-form" onsubmit="submitCounterSwap(event)" class="mt-4 space-y-4">
        <input type="hidden" id="counter-swap-id" name="swapId">

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Request Additional Cash Top-Up (₹)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-500">₹</span>
            <input 
              type="number" 
              id="counter-cash-input" 
              name="counterCashTopUp" 
              min="0" 
              value="200" 
              class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-8 pr-3.5 py-2 text-xs font-bold"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Counter Note</label>
          <input 
            type="text" 
            id="counter-note-input" 
            name="counterNote" 
            placeholder="e.g. Love the hoodie, can you add ₹200 top-up to balance value?" 
            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs"
          >
        </div>

        <div id="counter-feedback" class="hidden p-3 rounded-xl text-xs font-bold"></div>

        <div class="pt-2 flex items-center justify-end space-x-2">
          <button type="button" onclick="closeModal('counter-swap-modal')" class="px-4 py-2 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600">Cancel</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-xs">Send Counter Offer</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<script>
  // Global Safe Modal Helpers
  window.openModal = function(id) {
    const el = document.getElementById(id);
    if (el) {
      el.classList.remove('hidden');
      el.classList.add('flex');
      el.style.setProperty('display', 'flex', 'important');
      document.body.style.overflow = 'hidden';
      if (window.lucide) window.lucide.createIcons();
    } else {
      console.warn('Modal element not found for id:', id);
    }
  };

  window.closeModal = function(id) {
    const el = document.getElementById(id);
    if (el) {
      el.classList.add('hidden');
      el.classList.remove('flex');
      el.style.setProperty('display', 'none', 'important');
      document.body.style.overflow = 'auto';
    }
  };

  // Close modals when user clicks outside the modal dialog on the dark backdrop
  document.addEventListener('click', function(e) {
    if (e.target && e.target.id && ['chat-modal', 'offer-modal', 'exchange-modal', 'buy-modal', 'counter-swap-modal'].includes(e.target.id)) {
      window.closeModal(e.target.id);
    }
  });

  // Close modals on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      ['chat-modal', 'offer-modal', 'exchange-modal', 'buy-modal', 'counter-swap-modal'].forEach(function(mId) {
        window.closeModal(mId);
      });
    }
  });

  // Chat Integration
  let chatConversationId = '';

  window.openChatModal = function() {
    window.openModal('chat-modal');
    window.loadChatMessages();
  };

  window.loadChatMessages = async function() {
    const container = document.getElementById('chat-messages-container');
    if (!container) return;

    const listingId = '<%= listing._id %>';
    const currentUserId = '<%= currentUser ? currentUser._id : "" %>';

    try {
      const response = await fetch('/api/chat/conversation/' + listingId);
      const data = await response.json();

      if (!response.ok || !data.success) {
        container.innerHTML = '<div class="text-center text-rose-500 py-4 font-semibold">Unable to load chat: ' + (data.message || 'Error') + '</div>';
        return;
      }

      const conv = data.data || {};
      chatConversationId = conv._id || '';
      const messages = conv.messages || [];
      const sellerIdStr = conv.sellerId ? (conv.sellerId._id || conv.sellerId).toString() : '';
      const isSeller = sellerIdStr === currentUserId;

      if (messages.length === 0) {
        container.innerHTML = `
          <div class="text-center text-gray-400 py-8 space-y-1">
            <i data-lucide="message-square" class="w-8 h-8 mx-auto text-gray-300"></i>
            <p class="font-bold text-gray-600">No messages yet</p>
            <p class="text-[11px]">Say hi and ask any question about size, fit, fabric, or pickup!</p>
          </div>
        `;
      } else {
        container.innerHTML = messages.map(msg => {
          const senderId = (msg.sender && msg.sender._id) ? msg.sender._id.toString() : (msg.sender ? msg.sender.toString() : '');
          const isMine = senderId === currentUserId;
          const senderName = isMine ? 'You' : (msg.sender && msg.sender.name ? msg.sender.name : 'Seller');
          const time = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

          const isOffer = msg.type === 'offer' || (msg.text && (msg.text.includes('Price Offer') || msg.text.includes('Offer Accepted') || msg.text.includes('Offer Declined')));
          const isSwap = msg.type === 'swap' || (msg.text && (msg.text.includes('Swap Proposal') || msg.text.includes('Swap Accepted') || msg.text.includes('Swap Declined')));

          if (isOffer) {
            const status = msg.actionStatus || (msg.text.includes('Accepted') ? 'accepted' : (msg.text.includes('Declined') ? 'rejected' : 'pending'));
            const offerId = msg.offerId || '';
            const offeredPrice = (msg.metadata && msg.metadata.offeredPrice) || (msg.text.match(/₹([\d,]+)/) ? msg.text.match(/₹([\d,]+)/)[1] : '');
            const checkoutUrl = (msg.metadata && msg.metadata.checkoutUrl) || ('/checkout/' + listingId);

            return `
              <div class="w-full my-2">
                <div class="rounded-2xl p-3 text-xs shadow-2xs border ${status === 'accepted' ? 'bg-emerald-50/80 border-emerald-200' : (status === 'rejected' ? 'bg-rose-50/80 border-rose-200' : 'bg-amber-50/80 border-amber-200')}">
                  <div class="flex items-center justify-between pb-1.5 border-b ${status === 'accepted' ? 'border-emerald-200/60' : (status === 'rejected' ? 'border-rose-200/60' : 'border-amber-200/60')}">
                    <span class="font-extrabold flex items-center gap-1 ${status === 'accepted' ? 'text-emerald-900' : (status === 'rejected' ? 'text-rose-900' : 'text-amber-900')}">
                      <i data-lucide="tag" class="w-3 h-3"></i> Price Offer ${offeredPrice ? ('₹' + offeredPrice) : ''}
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider ${status === 'accepted' ? 'bg-emerald-200 text-emerald-800' : (status === 'rejected' ? 'bg-rose-200 text-rose-800' : 'bg-amber-200 text-amber-900 animate-pulse')}">
                      ${status === 'accepted' ? '✓ Accepted' : (status === 'rejected' ? '✕ Declined' : '⏳ Pending')}
                    </span>
                  </div>

                  <p class="mt-2 text-gray-800 leading-relaxed font-medium whitespace-pre-wrap">${msg.text}</p>

                  ${isSeller && status === 'pending' && offerId ? `
                    <div class="mt-2.5 pt-2 border-t border-amber-200/60 flex items-center gap-2">
                      <button 
                        type="button" 
                        data-offer-id="${offerId.replace(/[^a-f0-9]/gi, '')}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'accept', this)"
                        class="flex-1 py-1.5 px-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-2xs flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="check" class="w-3 h-3"></i> <span>Accept</span>
                      </button>
                      <button 
                        type="button" 
                        data-offer-id="${offerId.replace(/[^a-f0-9]/gi, '')}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'reject', this)"
                        class="py-1.5 px-2.5 rounded-xl bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[11px] flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-3 h-3"></i> <span>Decline</span>
                      </button>
                    </div>
                  ` : ''}

                  ${!isSeller && status === 'pending' && offerId ? `
                    <div class="mt-2 pt-2 border-t border-amber-200/60 flex items-center justify-between">
                      <span class="text-[10px] text-amber-800 font-medium">⏳ Pending seller review</span>
                      <button 
                        type="button" 
                        data-offer-id="${offerId.replace(/[^a-f0-9]/gi, '')}"
                        onclick="respondOfferFromChat(this.dataset.offerId, 'cancel', this)"
                        class="py-1 px-2.5 rounded-lg bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[10px] flex items-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-2.5 h-2.5"></i> <span>Cancel</span>
                      </button>
                    </div>
                  ` : ''}

                  ${!isSeller && status === 'accepted' ? `
                    <div class="mt-2.5 pt-2 border-t border-emerald-200/60">
                      <a 
                        href="${checkoutUrl}"
                        class="w-full py-2 px-3 rounded-xl bg-gray-900 hover:bg-black text-white font-bold text-[11px] flex items-center justify-center gap-1.5 shadow-2xs cursor-pointer text-center"
                      >
                        <i data-lucide="shopping-bag" class="w-3 h-3 text-amber-400"></i> Checkout at Offer Price →
                      </a>
                    </div>
                  ` : ''}

                  ${status === 'rejected' ? `
                    <div class="mt-2 pt-1.5 border-t border-rose-200/60 text-[10px] font-medium text-rose-700 flex items-center gap-1">
                      <i data-lucide="x-circle" class="w-3 h-3 text-rose-500"></i>
                      <span>This offer was closed / declined.</span>
                    </div>
                  ` : ''}

                  <span class="block text-[9px] mt-1.5 text-right text-gray-400">${time}</span>
                </div>
              </div>
            `;
          }

          if (isSwap) {
            const status = msg.actionStatus || (msg.text.includes('Accepted') ? 'accepted' : (msg.text.includes('Declined') ? 'rejected' : 'pending'));
            const swapId = msg.swapId ? (msg.swapId._id ? String(msg.swapId._id) : String(msg.swapId)) : '';
            const swapIdSafe = swapId.replace(/[^a-f0-9]/gi, '');

            return `
              <div class="w-full my-2">
                <div class="rounded-2xl p-3 text-xs shadow-2xs border ${status === 'accepted' ? 'bg-emerald-50/80 border-emerald-200' : (status === 'rejected' ? 'bg-rose-50/80 border-rose-200' : 'bg-indigo-50/80 border-indigo-200')}">
                  <div class="flex items-center justify-between pb-1.5 border-b ${status === 'accepted' ? 'border-emerald-200/60' : (status === 'rejected' ? 'border-rose-200/60' : 'border-indigo-200/60')}">
                    <span class="font-extrabold flex items-center gap-1 ${status === 'accepted' ? 'text-emerald-900' : (status === 'rejected' ? 'text-rose-900' : 'text-indigo-950')}">
                      <i data-lucide="repeat" class="w-3 h-3 text-indigo-600"></i> Swap Proposal
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider ${status === 'accepted' ? 'bg-emerald-200 text-emerald-800' : (status === 'rejected' ? 'bg-rose-200 text-rose-800' : 'bg-indigo-200 text-indigo-900 animate-pulse')}">
                      ${status === 'accepted' ? '✓ Agreed' : (status === 'rejected' ? '✕ Declined' : '⏳ Pending')}
                    </span>
                  </div>

                  <p class="mt-2 text-gray-800 leading-relaxed font-medium whitespace-pre-wrap">${msg.text}</p>

                  ${isSeller && status === 'pending' && swapIdSafe ? `
                    <div class="mt-2.5 pt-2 border-t border-indigo-200/60 flex items-center gap-2">
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'accept', this)"
                        class="flex-1 py-1.5 px-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-[11px] shadow-2xs flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="check" class="w-3 h-3"></i> <span>Accept Swap</span>
                      </button>
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'reject', this)"
                        class="py-1.5 px-2.5 rounded-xl bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[11px] flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-3 h-3"></i> <span>Decline</span>
                      </button>
                    </div>
                  ` : ''}

                  ${!isSeller && status === 'pending' && swapIdSafe ? `
                    <div class="mt-2 pt-2 border-t border-indigo-200/60 flex items-center justify-between">
                      <span class="text-[10px] text-indigo-900 font-medium">⏳ Pending owner agreement</span>
                      <button 
                        type="button" 
                        data-swap-id="${swapIdSafe}"
                        onclick="respondSwapFromChat(this.dataset.swapId, 'cancel', this)"
                        class="py-1 px-2.5 rounded-lg bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[10px] flex items-center gap-1 cursor-pointer"
                      >
                        <i data-lucide="x" class="w-2.5 h-2.5"></i> <span>Withdraw</span>
                      </button>
                    </div>
                  ` : ''}

                  ${status === 'rejected' ? `
                    <div class="mt-2 pt-1.5 border-t border-rose-200/60 text-[10px] font-medium text-rose-700 flex items-center gap-1">
                      <i data-lucide="x-circle" class="w-3 h-3 text-rose-500"></i>
                      <span>This swap proposal was declined / closed.</span>
                    </div>
                  ` : ''}

                  <span class="block text-[9px] mt-1.5 text-right text-gray-400">${time}</span>
                </div>
              </div>
            `;
          }

          return `
            <div class="flex flex-col ${isMine ? 'items-end' : 'items-start'} my-1">
              <div class="max-w-[80%] rounded-2xl px-3.5 py-2.5 shadow-2xs ${
                isMine ? 'bg-indigo-600 text-white rounded-br-none' : 'bg-white border border-gray-200 text-gray-900 rounded-bl-none'
              }">
                <p class="text-[10px] font-bold ${isMine ? 'text-indigo-200' : 'text-gray-400'} mb-0.5">${senderName}</p>
                <p class="text-xs leading-relaxed break-words font-medium">${msg.text}</p>
                <p class="text-[9px] text-right mt-1 ${isMine ? 'text-indigo-200' : 'text-gray-400'}">${time}</p>
              </div>
            </div>
          `;
        }).join('');
      }

      container.scrollTop = container.scrollHeight;
      if (window.lucide) window.lucide.createIcons();

    } catch (err) {
      container.innerHTML = '<div class="text-center text-rose-500 py-4 font-semibold">Network error loading chat</div>';
    }
  };

  window.sendChatMessage = async function(e) {
    e.preventDefault();
    const input = document.getElementById('chat-input-text');
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;

    const listingId = '<%= listing._id %>';
    const btn = document.getElementById('chat-send-btn');
    if (btn) btn.disabled = true;

    try {
      const response = await fetch('/api/chat/send', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({ listingId, conversationId: chatConversationId, text })
      });
      const data = await response.json();

      if (response.ok && data.success) {
        input.value = '';
        if (data.data && data.data.conversationId) {
          chatConversationId = data.data.conversationId;
        }
        await loadChatMessages();
      } else {
        alert(data.message || 'Failed to send message');
      }
    } catch (err) {
      alert('Network error sending message');
    } finally {
      if (btn) btn.disabled = false;
    }
  };

  // Direct In-Chat Action Handlers
  window.respondOfferFromChat = async function(offerId, action, btn) {
    if (!offerId || offerId === 'null') {
      alert('Offer reference not found.');
      return;
    }
    const verb = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Cancelling...' : 'Declining...');

    if (btn) {
      btn.disabled = true;
      btn.classList.add('opacity-50');
      const span = btn.querySelector('span');
      if (span) span.textContent = verb;
    }

    try {
      const res = await fetch(`/api/offers/${offerId}/respond`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        await loadChatMessages();
      } else {
        alert(data.message || 'Failed to respond to offer');
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-50');
          const span = btn.querySelector('span');
          if (span) span.textContent = action === 'accept' ? 'Accept' : (action === 'cancel' ? 'Cancel' : 'Decline');
        }
      }
    } catch (err) {
      alert('Network error responding to offer');
      if (btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-50');
        const span = btn.querySelector('span');
        if (span) span.textContent = action === 'accept' ? 'Accept' : (action === 'cancel' ? 'Cancel' : 'Decline');
      }
    }
  };

  window.respondSwapFromChat = async function(swapId, action, btn) {
    if (!swapId || !/^[a-f0-9]{24}$/i.test(swapId)) {
      alert('Swap proposal reference not found.');
      return;
    }
    const verb = action === 'accept' ? 'Accepting...' : (action === 'cancel' ? 'Withdrawing...' : 'Declining...');

    if (btn) {
      btn.disabled = true;
      btn.classList.add('opacity-50');
      const span = btn.querySelector('span');
      if (span) span.textContent = verb;
    }

    try {
      let res = await fetch(`/api/swaps/${swapId}/respond`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
      });
      let data = await res.json();

      if (!res.ok) {
        res = await fetch(`/transactions/${swapId}/respond`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ action: action === 'cancel' ? 'reject' : action })
        });
        data = await res.json();
      }

      if (res.ok && data.success) {
        await loadChatMessages();
      } else {
        alert(data.message || 'Failed to respond to swap proposal');
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-50');
          const span = btn.querySelector('span');
          if (span) span.textContent = action === 'accept' ? 'Accept Swap' : (action === 'cancel' ? 'Withdraw' : 'Decline');
        }
      }
    } catch (err) {
      alert('Network error responding to swap proposal');
      if (btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-50');
        const span = btn.querySelector('span');
        if (span) span.textContent = action === 'accept' ? 'Accept Swap' : (action === 'cancel' ? 'Withdraw' : 'Decline');
      }
    }
  };

  // Price Offer Integration
  window.openOfferModal = function() {
    openModal('offer-modal');
  };

  window.submitPriceOffer = async function(e) {
    e.preventDefault();
    const listingId = '<%= listing._id %>';
    const priceInput = document.getElementById('offer-price-input');
    const msgInput = document.getElementById('offer-message-input');
    const feedback = document.getElementById('offer-feedback');
    const btn = document.getElementById('offer-submit-btn');

    if (!priceInput || !priceInput.value) return;
    const offeredPrice = priceInput.value;
    const message = msgInput ? msgInput.value : '';

    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Submitting Offer...';
    }

    try {
      const response = await fetch('/api/offers', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({ listingId, offeredPrice, message })
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Failed to submit offer');
      }

      if (feedback) {
        feedback.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 block';
        feedback.textContent = '✓ ' + data.message;
      }

      setTimeout(() => {
        closeModal('offer-modal');
        window.location.reload();
      }, 1200);

    } catch (err) {
      if (feedback) {
        feedback.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 block';
        feedback.textContent = 'Error: ' + err.message;
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Send Offer';
      }
    }
  };

  // Seller Respond to Offer
  window.respondToOfferAction = async function(offerId, action) {
    if (!confirm('Are you sure you want to ' + action + ' this offer?')) return;

    try {
      const response = await fetch('/api/offers/' + offerId + '/respond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      const data = await response.json();

      if (response.ok && data.success) {
        alert(data.message);
        window.location.reload();
      } else {
        alert(data.message || 'Error processing response');
      }
    } catch (err) {
      alert('Network error responding to offer');
    }
  };

  // Seller Respond to Swap
  window.respondToSwapAction = async function(swapId, action) {
    if (action === 'accept' && !confirm('Accept this wardrobe swap? Both items will be reserved and an exchange delivery will be scheduled.')) return;
    if (action === 'reject' && !confirm('Decline this swap offer?')) return;

    try {
      const response = await fetch('/api/swaps/' + swapId + '/respond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      const data = await response.json();

      if (response.ok && data.success) {
        alert(data.message);
        window.location.reload();
      } else {
        alert(data.message || 'Error responding to swap');
      }
    } catch (err) {
      alert('Network error responding to swap');
    }
  };

  window.openCounterSwapModal = function(swapId, proposerName) {
    const input = document.getElementById('counter-swap-id');
    if (input) input.value = swapId;
    openModal('counter-swap-modal');
  };

  window.submitCounterSwap = async function(e) {
    e.preventDefault();
    const swapIdEl = document.getElementById('counter-swap-id');
    const cashInput = document.getElementById('counter-cash-input');
    const noteInput = document.getElementById('counter-note-input');
    const feedback = document.getElementById('counter-feedback');

    const swapId = swapIdEl ? swapIdEl.value : '';
    const counterCashTopUp = cashInput ? cashInput.value : 0;
    const counterNote = noteInput ? noteInput.value : '';

    try {
      const response = await fetch('/api/swaps/' + swapId + '/respond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'counter',
          counterCashTopUp,
          counterNote
        })
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Failed to submit counter offer');
      }

      if (feedback) {
        feedback.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 block';
        feedback.textContent = '✓ Counter offer sent!';
      }

      setTimeout(() => {
        closeModal('counter-swap-modal');
        window.location.reload();
      }, 1000);

    } catch (err) {
      if (feedback) {
        feedback.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 block';
        feedback.textContent = 'Error: ' + err.message;
      }
    }
  };
</script>

<%- include('../../partials/footer') %>
