<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Breadcrumb & Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-6 border-b border-gray-200 gap-4">
    <div>
      <div class="flex items-center space-x-2 text-xs font-semibold text-gray-500 mb-1">
        <a href="/" class="hover:text-gray-900">Home</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-gray-900">Second-Hand Catalog</span>
        <% if (selectedCategory) { %>
          <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
          <span class="text-gray-900 font-bold"><%= selectedCategory.name %></span>
        <% } %>
      </div>
      <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900">
        <%= selectedCategory ? selectedCategory.name : 'All Second-Hand & Thrift Wares in India' %>
      </h1>
      <p class="text-xs sm:text-sm text-gray-500 mt-1">
        Showing <span class="font-bold text-gray-900"><%= pagination.total %></span> verified pre-loved items in <strong class="text-gray-900">Indian Rupees (₹)</strong>
      </p>
    </div>

    <!-- Top Action / Create Listing -->
    <div>
      <a href="/listings/create" class="inline-flex items-center px-5 py-2.5 rounded-full bg-gray-900 hover:bg-black text-white text-sm font-semibold shadow-xs">
        <i data-lucide="plus-circle" class="w-4 h-4 mr-2 text-amber-400"></i>
        List Pre-Loved Item
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <!-- Filter Sidebar -->
    <div class="lg:col-span-1">
      <form action="/listings" method="GET" class="bg-white p-6 rounded-3xl border border-gray-200 shadow-xs space-y-6 sticky top-28">
        
        <!-- Search Keyword -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Search Items</label>
          <div class="relative">
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="e.g. vintage denim, oversized hoodie, sneakers..." 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 pl-9 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900"
            >
            <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          </div>
        </div>

        <!-- Categories Filter -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Thrift Category</label>
          <select name="category" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900">
            <option value="all">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.slug %>" <%= (query.category === cat.slug || query.category === cat._id.toString()) ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Listing Type Filter -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Listing Type</label>
          <div class="space-y-2 text-sm text-gray-700">
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="type" value="all" <%= (!query.type || query.type === 'all') ? 'checked' : '' %> class="text-gray-900 focus:ring-gray-900">
              <span>All Items</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="type" value="sell" <%= query.type === 'sell' ? 'checked' : '' %> class="text-gray-900 focus:ring-gray-900">
              <span>Buy Direct (Cash in ₹)</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input type="radio" name="type" value="exchange" <%= query.type === 'exchange' ? 'checked' : '' %> class="text-gray-900 focus:ring-gray-900">
              <span>Item Swap / Barter</span>
            </label>
          </div>
        </div>

        <!-- Condition Filter -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Second-Hand Condition</label>
          <select name="condition" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900">
            <option value="all">Any Condition</option>
            <% conditions.forEach(cond => { %>
              <option value="<%= cond %>" <%= query.condition === cond ? 'selected' : '' %>><%= cond %></option>
            <% }) %>
          </select>
        </div>

        <!-- Size Filter -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Size</label>
          <select name="size" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900">
            <option value="all">Any Size</option>
            <% sizes.forEach(sz => { %>
              <option value="<%= sz %>" <%= query.size === sz ? 'selected' : '' %>><%= sz %></option>
            <% }) %>
          </select>
        </div>

        <!-- Price Range (₹) -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Price Range in ₹ (Rupees)</label>
          <div class="grid grid-cols-2 gap-2">
            <input 
              type="number" 
              name="minPrice" 
              placeholder="Min ₹" 
              value="<%= query.minPrice || '' %>"
              class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm"
            >
            <input 
              type="number" 
              name="maxPrice" 
              placeholder="Max ₹" 
              value="<%= query.maxPrice || '' %>"
              class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm"
            >
          </div>
        </div>

        <!-- Sort by -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Sort By</label>
          <select name="sort" class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900">
            <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest Drops</option>
            <option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High (₹)</option>
            <option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low (₹)</option>
            <option value="popular" <%= query.sort === 'popular' ? 'selected' : '' %>>Most Viewed</option>
          </select>
        </div>

        <!-- Apply & Reset Buttons -->
        <div class="pt-2 space-y-2">
          <button type="submit" class="w-full py-2.5 rounded-xl bg-gray-900 hover:bg-black text-white text-sm font-bold shadow-xs">
            Apply Filters
          </button>
          <a href="/listings" class="block text-center text-xs font-semibold text-gray-500 hover:text-gray-900 py-1">
            Reset Filters
          </a>
        </div>

      </form>
    </div>

    <!-- Product Grid -->
    <div class="lg:col-span-3">
      <% if (listings && listings.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          <% listings.forEach(item => { %>
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden flex flex-col group hover:shadow-lg transition-all">
              
              <!-- Image -->
              <a href="/listings/<%= item._id %>" class="relative block overflow-hidden aspect-[4/3] min-h-[220px] bg-gray-100">
                <img 
                  src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" 
                  alt="<%= item.title %>" 
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
                >
                <!-- Type Badge -->
                <div class="absolute top-3 left-3">
                  <% if (item.type === 'exchange') { %>
                    <span class="bg-indigo-600 text-white text-xs font-bold px-2.5 py-0.5 rounded-full shadow-xs flex items-center gap-1">
                      <i data-lucide="repeat" class="w-3 h-3"></i> Trade
                    </span>
                  <% } else if (item.type === 'both') { %>
                    <span class="bg-gray-900 text-white text-xs font-bold px-2.5 py-0.5 rounded-full shadow-xs flex items-center gap-1">
                      <i data-lucide="sparkles" class="w-3 h-3 text-amber-400"></i> Buy / Swap
                    </span>
                  <% } else { %>
                    <span class="bg-white text-gray-900 border border-gray-200 text-xs font-bold px-2.5 py-0.5 rounded-full shadow-xs flex items-center gap-1">
                      <i data-lucide="tag" class="w-3 h-3"></i> Buy Now
                    </span>
                  <% } %>
                </div>

                <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur text-gray-900 text-[10px] font-bold px-2 py-0.5 rounded shadow-xs flex items-center gap-1">
                  <i data-lucide="ruler" class="w-2.5 h-2.5 text-indigo-600"></i> <%= item.size || 'Standard' %>
                </div>
                <div class="absolute bottom-3 right-3 bg-black/75 backdrop-blur text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-xs">
                  <%= item.condition %>
                </div>
              </a>

              <!-- Card Info -->
              <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                <div>
                  <div class="flex items-center justify-between text-xs text-gray-500 font-bold mb-1">
                    <span><%= item.category ? item.category.name : 'Pre-Loved' %></span>
                    <span class="text-gray-400 font-normal"><%= item.location || 'India' %></span>
                  </div>
                  <a href="/listings/<%= item._id %>" class="font-bold text-gray-900 text-base hover:text-indigo-600 transition-colors line-clamp-1">
                    <%= item.title %>
                  </a>
                  <p class="text-xs text-gray-500 line-clamp-2 mt-1 leading-relaxed">
                    <%= item.description %>
                  </p>
                </div>

                <!-- Price in Rupees and Seller -->
                <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
                  <div>
                    <% if (item.type === 'exchange') { %>
                      <span class="text-sm font-bold text-indigo-700">Open for Trade</span>
                    <% } else { %>
                      <span class="text-lg font-extrabold text-gray-900">₹<%= Number(item.price).toLocaleString('en-IN') %></span>
                      <% if (item.type === 'both') { %>
                        <span class="text-[10px] text-gray-400 block font-normal">or Swap</span>
                      <% } %>
                    <% } %>
                  </div>

                  <a href="/listings/<%= item._id %>" class="text-xs font-bold text-gray-900 bg-gray-100 hover:bg-gray-200 px-3.5 py-2 rounded-xl transition-colors">
                    View Details
                  </a>
                </div>

              </div>

            </div>
          <% }) %>
        </div>

        <%- include('../../partials/pagination') %>

      <% } else { %>
        <div class="bg-white rounded-3xl p-12 text-center border border-gray-200 shadow-xs">
          <div class="w-16 h-16 rounded-2xl bg-gray-100 text-gray-600 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="package-search" class="w-8 h-8"></i>
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-2">No Second-Hand Wares Found</h3>
          <p class="text-sm text-gray-500 max-w-sm mx-auto mb-6">
            We couldn't find any items matching your filters. Try clearing search keywords or adjusting your price in ₹.
          </p>
          <a href="/listings" class="inline-flex items-center px-6 py-2.5 rounded-full bg-gray-900 text-white text-sm font-semibold">
            Clear Filters
          </a>
        </div>
      <% } %>
    </div>

  </div>

</div>

<%- include('../../partials/footer') %>
