<!-- How Second-Hand Wardrobe Exchange Works -->
<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-14">
    <span class="text-xs font-bold uppercase tracking-widest text-indigo-600">Zero Cash Needed</span>
    <h2 class="font-display text-3xl font-extrabold text-gray-900 mt-2">How Wardrobe Trading Works</h2>
    <p class="text-sm text-gray-600 mt-2">Trade pre-owned jackets, sneakers, and modern western wear with thrifters across India in three easy steps.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-xs text-center">
      <div class="w-14 h-14 rounded-2xl bg-gray-100 text-gray-900 flex items-center justify-center mx-auto mb-5 font-display font-extrabold text-xl">
        1
      </div>
      <h3 class="font-bold text-gray-900 text-lg mb-2">List From Your Closet</h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Upload photos of your pre-loved jeans, hoodies, or sneakers and set a price in ₹ or mark it for "Exchange".
      </p>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-xs text-center">
      <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-5 font-display font-extrabold text-xl">
        2
      </div>
      <h3 class="font-bold text-gray-900 text-lg mb-2">Propose an Item Swap</h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Found something you love? Click "Propose Swap" and select one item from your own wardrobe to trade.
      </p>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-xs text-center">
      <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-5 font-display font-extrabold text-xl">
        3
      </div>
      <h3 class="font-bold text-gray-900 text-lg mb-2">Ship Across India</h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Once accepted, both items are marked as exchanged. Ship via local courier (Delhivery, BlueDart, India Post) with tracking.
      </p>
    </div>
  </div>
</section>

<!-- Call to Action Banner -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
  <div class="bg-gray-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="space-y-3 text-center md:text-left max-w-xl">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold">Have Pre-Owned Clothes Sitting Unworn?</h2>
      <p class="text-gray-300 text-sm leading-relaxed">
        Turn your unworn western clothes into extra cash in Rupees (₹) or trade them for fresh thrift pieces. Listing takes under 2 minutes.
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/listings/create" class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-white text-gray-900 text-sm font-bold shadow hover:bg-gray-100 transition-colors">
        <i data-lucide="plus-circle" class="w-4 h-4 mr-2 text-indigo-600"></i>
        Post an Item Now
      </a>
      <a href="/auth/register" class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-gray-800 border border-gray-700 text-white text-sm font-bold hover:bg-gray-700 transition-colors">
        Create Free Account
      </a>
    </div>
  </div>
</section>

