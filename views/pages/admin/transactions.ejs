<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex flex-col lg:flex-row gap-8">
    <%- include('../../partials/admin-sidebar') %>

    <div class="flex-1 space-y-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-200 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Audit Trail</span>
          <h1 class="font-display text-2xl font-extrabold text-gray-900">Transactions & Swaps (<%= total %>)</h1>
        </div>

        <a href="/admin/export/transactions" class="px-3.5 py-2 rounded-xl bg-white border border-gray-200 text-xs font-bold text-gray-700 hover:bg-gray-50 flex items-center gap-1.5 self-start sm:self-auto">
          <i data-lucide="download" class="w-3.5 h-3.5"></i> Export Transactions CSV
        </a>
      </div>

      <!-- Filters -->
      <form action="/admin/transactions" method="GET" class="bg-white p-4 rounded-2xl border border-gray-200 flex flex-col sm:flex-row gap-3">
        <select name="type" class="bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-xs">
          <option value="all">All Types</option>
          <option value="purchase" <%= query.type === 'purchase' ? 'selected' : '' %>>Direct Purchase (₹)</option>
          <option value="exchange" <%= query.type === 'exchange' ? 'selected' : '' %>>Item Barter</option>
        </select>

        <select name="status" class="bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-xs">
          <option value="all">All Statuses</option>
          <option value="completed" <%= query.status === 'completed' ? 'selected' : '' %>>Completed / Accepted</option>
          <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="rejected" <%= query.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>

        <button type="submit" class="px-5 py-2 rounded-xl bg-gray-900 text-white text-xs font-bold">Filter</button>
      </form>

      <!-- Transactions Table -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-gray-50 text-gray-700 font-bold border-b border-gray-200 uppercase tracking-wider text-[10px]">
              <tr>
                <th class="py-3.5 px-4">Ref ID</th>
                <th class="py-3.5 px-4">Type</th>
                <th class="py-3.5 px-4">Target Item</th>
                <th class="py-3.5 px-4">Buyer / Trader</th>
                <th class="py-3.5 px-4">Seller</th>
                <th class="py-3.5 px-4">Amount / Trade</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (transactions && transactions.length > 0) { %>
                <% transactions.forEach(t => { %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-3.5 px-4 font-mono font-bold text-gray-900">
                      #<%= t._id.toString().slice(-6).toUpperCase() %>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-block px-2 py-0.5 rounded font-bold uppercase text-[10px] <%= t.type === 'exchange' ? 'bg-indigo-100 text-indigo-800' : 'bg-emerald-100 text-emerald-800' %>">
                        <%= t.type %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4">
                      <p class="font-bold text-gray-900 truncate max-w-[150px]"><%= t.listingId ? t.listingId.title : 'Item' %></p>
                    </td>
                    <td class="py-3.5 px-4 text-gray-700 font-medium">
                      <%= t.buyerId ? t.buyerId.name : 'Unknown' %>
                    </td>
                    <td class="py-3.5 px-4 text-gray-700">
                      <%= t.sellerId ? t.sellerId.name : 'Unknown' %>
                    </td>
                    <td class="py-3.5 px-4 font-bold text-gray-900">
                      <% if (t.type === 'purchase') { %>
                        ₹<%= Number(t.amount || 0).toLocaleString('en-IN') %>
                      <% } else { %>
                        <span class="text-xs text-indigo-700 font-medium truncate max-w-[120px] block">
                          Trade: <%= t.exchangeItemId ? t.exchangeItemId.title : 'Item' %>
                        </span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-block px-2.5 py-0.5 rounded-full font-bold text-[10px] uppercase
                        <%= t.status === 'completed' || t.status === 'accepted' ? 'bg-emerald-100 text-emerald-800' : '' %>
                        <%= t.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                        <%= t.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                      ">
                        <%= t.status %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-gray-400">
                      <%= new Date(t.createdAt).toLocaleDateString('en-IN') %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="py-8 text-center text-gray-500">No transactions recorded yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('../../partials/pagination') %>

    </div>
  </div>

</div>

<%- include('../../partials/footer') %>
