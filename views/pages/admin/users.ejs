<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex flex-col lg:flex-row gap-8">
    <%- include('../../partials/admin-sidebar') %>

    <div class="flex-1 space-y-6">
      
      <!-- Top Title & Search -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-[#F0ECE1] gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Platform Management</span>
          <h1 class="font-display text-2xl font-bold text-gray-900">User Management (<%= total %>)</h1>
        </div>

        <a href="/admin/export/users" class="px-3.5 py-2 rounded-xl bg-white border border-gray-200 text-xs font-bold text-gray-700 hover:bg-gray-50 flex items-center gap-1.5 self-start sm:self-auto">
          <i data-lucide="download" class="w-3.5 h-3.5"></i> Export Users CSV
        </a>
      </div>

      <!-- Search Filter Bar -->
      <form action="/admin/users" method="GET" class="bg-white p-4 rounded-2xl border border-[#F0ECE1] flex flex-col sm:flex-row gap-3">
        <div class="flex-1 relative">
          <input 
            type="text" 
            name="search" 
            value="<%= query.search || '' %>" 
            placeholder="Search by name, email, or phone..." 
            class="w-full bg-[#FAF8F5] border border-gray-200 rounded-xl py-2 pl-9 pr-3 text-xs"
          >
          <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
        </div>

        <select name="status" class="bg-[#FAF8F5] border border-gray-200 rounded-xl py-2 px-3 text-xs">
          <option value="all">All Statuses</option>
          <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="banned" <%= query.status === 'banned' ? 'selected' : '' %>>Banned</option>
        </select>

        <button type="submit" class="px-5 py-2 rounded-xl btn-gold text-xs font-bold">
          Search
        </button>
      </form>

      <!-- Users Table -->
      <div class="bg-white rounded-3xl border border-[#F0ECE1] shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-[#FAF8F5] text-gray-700 font-bold border-b border-gray-200 uppercase tracking-wider text-[10px]">
              <tr>
                <th class="py-3.5 px-4">User</th>
                <th class="py-3.5 px-4">Phone</th>
                <th class="py-3.5 px-4">Role</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4">Joined</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (users && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr class="hover:bg-amber-50/30 transition-colors">
                    <td class="py-3.5 px-4">
                      <div class="flex items-center space-x-3">
                        <img src="<%= u.profileImage || '/images/default-avatar.png' %>" alt="" class="w-8 h-8 rounded-full object-cover border border-amber-300">
                        <div>
                          <p class="font-bold text-gray-900"><%= u.name %></p>
                          <p class="text-gray-400"><%= u.email %></p>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4 text-gray-600"><%= u.phone || '-' %></td>
                    <td class="py-3.5 px-4">
                      <span class="inline-block px-2.5 py-0.5 rounded-full font-bold uppercase text-[10px] <%= u.role === 'admin' ? 'bg-amber-100 text-amber-800' : 'bg-gray-100 text-gray-700' %>">
                        <%= u.role %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-block px-2.5 py-0.5 rounded-full font-bold text-[10px] <%= u.isBanned ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800' %>">
                        <%= u.isBanned ? 'Banned' : 'Active' %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-gray-500"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end space-x-2">
                        <a href="/user/<%= u._id %>/profile" target="_blank" class="p-1.5 rounded-lg text-gray-500 hover:text-amber-700 hover:bg-amber-50" title="View Profile">
                          <i data-lucide="external-link" class="w-4 h-4"></i>
                        </a>

                        <% if (u._id.toString() !== currentUser._id.toString()) { %>
                          <form action="/admin/users/<%= u._id %>/ban" method="POST" onsubmit="return confirm('Are you sure you want to <%= u.isBanned ? 'unban' : 'ban' %> this user?');">
                            <button type="submit" class="px-2.5 py-1 rounded-lg text-[11px] font-bold <%= u.isBanned ? 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'bg-rose-50 text-rose-700 hover:bg-rose-100' %>">
                              <%= u.isBanned ? 'Unban' : 'Ban' %>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-gray-500">No users found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('../../partials/pagination') %>

    </div>
  </div>

</div>

<%- include('../../partials/footer') %>
