<%- include('../../partials/header') %>

<!-- Chart.js CDN for Admin Analytics -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex flex-col lg:flex-row gap-8">
    
    <!-- Admin Sidebar Navigation -->
    <%- include('../../partials/admin-sidebar') %>

    <!-- Admin Main Dashboard Content -->
    <div class="flex-1 space-y-8">
      
      <!-- Top Title & Quick Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-200 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Platform Control</span>
          <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900">Admin Control Center (India)</h1>
        </div>

        <div class="flex items-center space-x-2">
          <a href="/admin/export/transactions" class="px-3.5 py-2 rounded-xl bg-white border border-gray-200 text-xs font-bold text-gray-700 hover:bg-gray-50 flex items-center gap-1.5">
            <i data-lucide="download" class="w-3.5 h-3.5"></i> Export Report
          </a>
          <a href="/admin/listings" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition-colors">
            <i data-lucide="check-square" class="w-3.5 h-3.5"></i> Manage Listings
          </a>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Users</span>
            <div class="w-8 h-8 rounded-lg bg-gray-100 text-gray-700 flex items-center justify-center">
              <i data-lucide="users" class="w-4 h-4"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold font-display text-gray-900"><%= stats.totalUsers %></p>
          <a href="/admin/users" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 block">Manage Users →</a>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Active Wares</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
              <i data-lucide="tag" class="w-4 h-4"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold font-display text-emerald-700"><%= stats.approvedListings %></p>
          <a href="/admin/listings?status=approved" class="text-xs font-bold text-emerald-700 block">View Approved →</a>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-rose-600 uppercase tracking-wider">Pending Review</span>
            <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-700 flex items-center justify-center">
              <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold font-display text-rose-600"><%= stats.pendingListings %></p>
          <a href="/admin/listings?status=pending" class="text-xs font-bold text-rose-600 block">Review Queue →</a>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Platform Volume</span>
            <div class="w-8 h-8 rounded-lg bg-gray-100 text-gray-700 flex items-center justify-center">
              <i data-lucide="indian-rupee" class="w-4 h-4"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold font-display text-gray-900">₹<%= Number(stats.totalGMV).toLocaleString('en-IN') %></p>
          <p class="text-[11px] text-gray-400 font-medium"><%= stats.totalTransactions %> total operations</p>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-xs space-y-4">
          <h3 class="font-display font-bold text-gray-900 text-base flex items-center gap-2">
            <i data-lucide="pie-chart" class="w-4 h-4 text-indigo-600"></i> Listings by Thrift Category
          </h3>
          <div class="h-60 relative">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-xs space-y-4">
          <h3 class="font-display font-bold text-gray-900 text-base flex items-center gap-2">
            <i data-lucide="bar-chart-2" class="w-4 h-4 text-emerald-600"></i> Transactions (Buy vs Swap)
          </h3>
          <div class="h-60 relative">
            <canvas id="transactionChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Recent Pending Approvals Moderation Section -->
      <% if (recentPendingListings && recentPendingListings.length > 0) { %>
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <h3 class="font-display font-bold text-gray-900 text-base flex items-center gap-2">
              <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600"></i> Listings Requiring Moderation
            </h3>
            <a href="/admin/listings?status=pending" class="text-xs font-bold text-indigo-600">View All (<%= recentPendingListings.length %>)</a>
          </div>

          <div class="divide-y divide-gray-100">
            <% recentPendingListings.forEach(item => { %>
              <div class="py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div class="flex items-center space-x-3">
                  <img src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-12 h-12 rounded-xl object-cover" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                  <div>
                    <h4 class="text-sm font-bold text-gray-900"><%= item.title %></h4>
                    <p class="text-xs text-gray-500">By <%= item.sellerId ? item.sellerId.name : 'Unknown' %> • <%= item.category ? item.category.name : '' %></p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <form action="/admin/listings/<%= item._id %>/approve" method="POST">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-xs font-bold hover:bg-emerald-100">
                      Approve
                    </button>
                  </form>
                  <form action="/admin/listings/<%= item._id %>/reject" method="POST">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 text-rose-700 text-xs font-bold hover:bg-rose-100">
                      Reject
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Recent Platform Activity -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Recent Users -->
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
          <h3 class="font-display font-bold text-gray-900 text-base flex items-center justify-between">
            <span>Recent Registrations</span>
            <a href="/admin/users" class="text-xs font-bold text-indigo-600">View All</a>
          </h3>
          <div class="divide-y divide-gray-100 text-xs">
            <% recentUsers.forEach(u => { %>
              <div class="py-2.5 flex items-center justify-between">
                <div class="flex items-center space-x-2.5">
                  <img src="<%= u.profileImage || '/images/default-avatar.png' %>" alt="" class="w-7 h-7 rounded-full object-cover">
                  <div>
                    <p class="font-bold text-gray-900"><%= u.name %></p>
                    <p class="text-gray-400"><%= u.email %></p>
                  </div>
                </div>
                <span class="text-gray-400"><%= new Date(u.createdAt).toLocaleDateString('en-IN') %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Recent Transactions in Rupees -->
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-xs space-y-4">
          <h3 class="font-display font-bold text-gray-900 text-base flex items-center justify-between">
            <span>Recent Transactions</span>
            <a href="/admin/transactions" class="text-xs font-bold text-indigo-600">View All</a>
          </h3>
          <div class="divide-y divide-gray-100 text-xs">
            <% recentTransactions.forEach(t => { %>
              <div class="py-2.5 flex items-center justify-between">
                <div>
                  <p class="font-bold text-gray-900"><%= t.listingId ? t.listingId.title : 'Item' %></p>
                  <p class="text-gray-400"><%= t.type.toUpperCase() %> • By <%= t.buyerId ? t.buyerId.name : 'Unknown' %></p>
                </div>
                <span class="font-extrabold text-emerald-700">₹<%= Number(t.amount || 0).toLocaleString('en-IN') %></span>
              </div>
            <% }) %>
          </div>
        </div>

      </div>

    </div>

  </div>

</div>

<!-- Chart Initialization Script -->
<script src="/js/admin-charts.js"></script>
<script>
  const catLabels = <%- JSON.stringify(categoryStats.map(c => c.name)) %>;
  const catData = <%- JSON.stringify(categoryStats.map(c => c.count)) %>;
  const transStats = {
    purchases: <%= stats.purchaseTransactions %>,
    exchanges: <%= stats.exchangeTransactions %>
  };
  initAdminCharts(catLabels, catData, transStats);
</script>

<%- include('../../partials/footer') %>
