<%- include('../../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex flex-col lg:flex-row gap-8">
    <%- include('../../partials/admin-sidebar') %>

    <div class="flex-1 space-y-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-200 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Moderation</span>
          <h1 class="font-display text-2xl font-extrabold text-gray-900">Listing Moderation (<%= total %>)</h1>
        </div>

        <div class="flex items-center space-x-2">
          <a href="/admin/export/listings" class="px-3.5 py-2 rounded-xl bg-white border border-gray-200 text-xs font-bold text-gray-700 hover:bg-gray-50 flex items-center gap-1.5">
            <i data-lucide="download" class="w-3.5 h-3.5"></i> Export Listings CSV
          </a>
        </div>
      </div>

      <!-- Filter Controls -->
      <form action="/admin/listings" method="GET" class="bg-white p-4 rounded-2xl border border-gray-200 flex flex-col sm:flex-row gap-3">
        <div class="flex-1 relative">
          <input 
            type="text" 
            name="search" 
            value="<%= query.search || '' %>" 
            placeholder="Search listings..." 
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-2 pl-9 pr-3 text-xs"
          >
          <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
        </div>

        <select name="status" class="bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-xs">
          <option value="all">All Statuses</option>
          <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending Review</option>
          <option value="approved" <%= query.status === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="rejected" <%= query.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          <option value="sold" <%= query.status === 'sold' ? 'selected' : '' %>>Sold</option>
          <option value="exchanged" <%= query.status === 'exchanged' ? 'selected' : '' %>>Exchanged</option>
        </select>

        <select name="category" class="bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-xs">
          <option value="all">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat._id %>" <%= query.category === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>

        <button type="submit" class="px-5 py-2 rounded-xl bg-gray-900 text-white text-xs font-bold">Filter</button>
      </form>

      <!-- Listings Table -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-gray-50 text-gray-700 font-bold border-b border-gray-200 uppercase tracking-wider text-[10px]">
              <tr>
                <th class="py-3.5 px-4">Item Details</th>
                <th class="py-3.5 px-4">Seller</th>
                <th class="py-3.5 px-4">Category</th>
                <th class="py-3.5 px-4">Type / Price</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (listings && listings.length > 0) { %>
                <% listings.forEach(item => { %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-3.5 px-4">
                      <div class="flex items-center space-x-3">
                        <img src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder-item.jpg' %>" alt="" class="w-12 h-12 rounded-xl object-cover border border-gray-200" onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';">
                        <div class="max-w-xs">
                          <span class="font-bold text-gray-900 truncate block" title="<%= item.title %>">
                            <%= item.title %>
                          </span>
                          <span class="text-[10px] text-gray-400"><%= item.condition %> • <%= item.location || 'India' %></span>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4">
                      <p class="font-semibold text-gray-800"><%= item.sellerId ? item.sellerId.name : 'Unknown' %></p>
                      <p class="text-[10px] text-gray-400"><%= item.sellerId ? item.sellerId.email : '' %></p>
                    </td>
                    <td class="py-3.5 px-4 text-gray-600 font-medium"><%= item.category ? item.category.name : '-' %></td>
                    <td class="py-3.5 px-4">
                      <span class="font-extrabold text-gray-900 block">
                        <%= item.type === 'exchange' ? 'Trade' : `₹${Number(item.price).toLocaleString('en-IN')}` %>
                      </span>
                      <span class="text-[10px] font-bold text-gray-500 uppercase"><%= item.type %></span>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="inline-block px-2.5 py-0.5 rounded-full font-bold text-[10px] uppercase
                        <%= item.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : '' %>
                        <%= item.status === 'pending' ? 'bg-amber-100 text-amber-800' : '' %>
                        <%= item.status === 'rejected' ? 'bg-rose-100 text-rose-800' : '' %>
                        <%= item.status === 'sold' ? 'bg-gray-800 text-white' : '' %>
                        <%= item.status === 'exchanged' ? 'bg-purple-100 text-purple-800' : '' %>
                      ">
                        <%= item.status %>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end space-x-1.5">
                        <% if (item.status === 'pending' || item.status === 'rejected') { %>
                          <form action="/admin/listings/<%= item._id %>/approve" method="POST">
                            <button type="submit" class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 font-bold hover:bg-emerald-100">
                              Approve
                            </button>
                          </form>
                        <% } %>
                        <% if (item.status === 'pending' || item.status === 'approved') { %>
                          <form action="/admin/listings/<%= item._id %>/reject" method="POST">
                            <button type="submit" class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 font-bold hover:bg-gray-200">
                              Reject
                            </button>
                          </form>
                        <% } %>
                        <a href="/listings/<%= item._id %>/edit" class="p-1.5 rounded-lg text-gray-500 hover:text-black">
                          <i data-lucide="edit-3" class="w-4 h-4"></i>
                        </a>
                        <form action="/admin/listings/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this listing permanently?');">
                          <button type="submit" class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-gray-500">No listings found matching criteria.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('../../partials/pagination') %>

    </div>
  </div>

</div>

<%- include('../../partials/footer') %>
