<%- include('../../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-indigo-100 shadow-xl space-y-6 relative overflow-hidden">
    
    <!-- Top Decorative Accent -->
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-600 via-amber-500 to-indigo-700"></div>

    <div class="text-center space-y-2 pt-2">
      <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-700 flex items-center justify-center mx-auto shadow-xs">
        <i data-lucide="shield-check" class="w-7 h-7"></i>
      </div>
      <div class="inline-block px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-800 text-[11px] font-extrabold uppercase tracking-wider">
        Restricted Access
      </div>
      <h1 class="font-display text-2xl font-extrabold text-gray-900">Admin Control Center</h1>
      <p class="text-xs sm:text-sm text-gray-500">Sign in to manage platform portfolio, listings, users & transactions</p>
    </div>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Admin Email Address</label>
        <div class="relative">
          <input 
            type="email" 
            name="email" 
            id="admin-email"
            required 
            placeholder="admin@smartware.com"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600"
          >
          <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Admin Password</label>
        </div>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            id="admin-password"
            required 
            placeholder="••••••••"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 pl-10 pr-4 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600"
          >
          <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        </div>
      </div>

      <button type="submit" class="w-full py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-md hover:shadow-indigo-600/25 hover:shadow-lg transition-all mt-2 flex items-center justify-center gap-2">
        <i data-lucide="key" class="w-4 h-4"></i>
        <span>Sign In to Admin Portal</span>
      </button>
    </form>

    <div class="pt-4 border-t border-gray-100 text-center text-xs text-gray-400">
      Authorized personnel only. All access attempts are logged.
    </div>

  </div>

  <!-- Return Link -->
  <div class="mt-6 text-center text-xs sm:text-sm text-gray-500">
    <a href="/auth/login" class="text-gray-600 hover:text-indigo-600 font-semibold inline-flex items-center gap-1.5 transition-colors">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Return to Customer Sign In
    </a>
  </div>
</div>

<%- include('../../partials/footer') %>
