<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

  <!-- Checkout Header & Breadcrumbs -->
  <div class="mb-8">
    <nav class="flex items-center space-x-2 text-xs text-gray-500 font-medium mb-3">
      <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/listings" class="hover:text-gray-900 transition-colors">Marketplace</a>
      <span>/</span>
      <% if (isSwapCheckout) { %>
        <span class="text-gray-900 font-semibold">Swap Courier & Assurance Checkout</span>
      <% } else { %>
        <a href="/listings/<%= listing._id %>" class="hover:text-gray-900 transition-colors truncate max-w-[150px] sm:max-w-xs"><%= listing.title %></a>
        <span>/</span>
        <span class="text-gray-900 font-semibold">Checkout</span>
      <% } %>
    </nav>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
          <% if (isSwapCheckout) { %>
            <i data-lucide="repeat" class="w-7 h-7 text-indigo-600"></i>
            Swap Courier & Top-Up Checkout
          <% } else { %>
            <i data-lucide="shield-check" class="w-7 h-7 text-emerald-600"></i>
            Secure Order Checkout
          <% } %>
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Insured pan-India thrift delivery & 24-hour buyer protection guarantee
        </p>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold">
        <i data-lucide="lock" class="w-3.5 h-3.5 text-emerald-600"></i>
        256-Bit SSL Encrypted Payment
      </div>
    </div>
  </div>

  <form id="checkout-form" action="<%= isSwapCheckout ? '/checkout/swap/' + swapTransaction._id : '/checkout/' + listing._id %>" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT COLUMN: Address & Payment Methods (7 cols) -->
    <div class="lg:col-span-7 space-y-6">

      <!-- 1. Delivery Address Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-extrabold flex items-center justify-center">1</span>
            Shipping & Doorstep Delivery Address (India)
          </h2>
          <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Pan-India Delivery</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Recipient Full Name *</label>
            <input 
              type="text" 
              name="fullName" 
              required 
              value="<%= currentUser ? currentUser.name : '' %>" 
              placeholder="e.g. Arjun Patel" 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            >
          </div>

          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Contact Mobile Number *</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-500">+91</span>
              <input 
                type="tel" 
                name="phone" 
                required 
                maxlength="10"
                value="<%= currentUser && currentUser.phone ? currentUser.phone.replace('+91', '').trim() : '9876543210' %>" 
                placeholder="98765 43210" 
                class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-12 pr-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
              >
            </div>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Flat, House No, Building, Street, Area *</label>
            <textarea 
              name="deliveryAddress" 
              rows="2" 
              required 
              placeholder="e.g. Flat 402, Green Glen Layout, Bellandur OR Sector 15, Near Metro..." 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            ><%= currentUser && currentUser.address ? currentUser.address : (currentUser && currentUser.formattedAddress ? currentUser.formattedAddress : 'B-402, Silver Birch Apts, Outer Ring Road') %></textarea>
          </div>

          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">City / Town *</label>
            <input 
              type="text" 
              name="city" 
              required 
              value="<%= currentUser && currentUser.city ? currentUser.city : 'Bengaluru' %>" 
              placeholder="e.g. Bengaluru, Mumbai, Delhi" 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            >
          </div>

          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">State *</label>
            <select 
              name="state" 
              required 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            >
              <% const states = ['Karnataka', 'Maharashtra', 'Delhi NCR', 'Gujarat', 'Telangana', 'Tamil Nadu', 'West Bengal', 'Rajasthan', 'Uttar Pradesh', 'Kerala', 'Punjab', 'Haryana', 'Madhya Pradesh', 'Goa', 'Chandigarh', 'Other']; %>
              <% states.forEach(st => { %>
                <option value="<%= st %>" <%= (currentUser && currentUser.state === st) || st === 'Karnataka' ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>

          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">PIN Code (6 Digits) *</label>
            <input 
              type="text" 
              name="pincode" 
              required 
              maxlength="6"
              value="<%= currentUser && currentUser.pincode ? currentUser.pincode : '560103' %>" 
              placeholder="e.g. 560103" 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            >
          </div>

          <div class="sm:col-span-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Delivery Instructions (Optional)</label>
            <input 
              type="text" 
              name="notes" 
              placeholder="e.g. Call before delivery / Leave at gate" 
              class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
            >
          </div>
        </div>
      </div>

      <!-- 2. Payment Method Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xs space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-extrabold flex items-center justify-center">2</span>
            Select Payment Method
          </h2>
          <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full flex items-center gap-1">
            <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> Instant & Insured
          </span>
        </div>

        <!-- Payment Method Tabs -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <label class="payment-option-tab cursor-pointer rounded-2xl p-3 border-2 border-gray-900 bg-gray-900 text-white flex flex-col items-center justify-center text-center transition-all" data-method="UPI">
            <input type="radio" name="paymentMethod" value="UPI" checked class="sr-only">
            <span class="text-lg font-extrabold tracking-tight">UPI</span>
            <span class="text-[10px] opacity-80 mt-0.5 font-medium">GPay / PhonePe / Paytm</span>
          </label>

          <label class="payment-option-tab cursor-pointer rounded-2xl p-3 border-2 border-gray-200 bg-gray-50 hover:bg-white text-gray-900 flex flex-col items-center justify-center text-center transition-all" data-method="Card">
            <input type="radio" name="paymentMethod" value="Card" class="sr-only">
            <span class="text-sm font-extrabold">Cards</span>
            <span class="text-[10px] text-gray-500 mt-0.5 font-medium">RuPay / Visa / Master</span>
          </label>

          <label class="payment-option-tab cursor-pointer rounded-2xl p-3 border-2 border-gray-200 bg-gray-50 hover:bg-white text-gray-900 flex flex-col items-center justify-center text-center transition-all" data-method="NetBanking">
            <input type="radio" name="paymentMethod" value="NetBanking" class="sr-only">
            <span class="text-sm font-extrabold">NetBanking</span>
            <span class="text-[10px] text-gray-500 mt-0.5 font-medium">SBI / HDFC / ICICI</span>
          </label>

          <label class="payment-option-tab cursor-pointer rounded-2xl p-3 border-2 border-gray-200 bg-gray-50 hover:bg-white text-gray-900 flex flex-col items-center justify-center text-center transition-all" data-method="COD">
            <input type="radio" name="paymentMethod" value="COD" class="sr-only">
            <span class="text-sm font-extrabold">COD</span>
            <span class="text-[10px] text-gray-500 mt-0.5 font-medium">Thrift Escrow</span>
          </label>
        </div>

        <!-- 1. UPI Payment Panel -->
        <div id="panel-UPI" class="payment-panel space-y-4">
          <div class="bg-gradient-to-br from-indigo-50/70 to-purple-50/50 rounded-2xl p-4 sm:p-5 border border-indigo-100 flex flex-col sm:flex-row items-center gap-5">
            <!-- Dynamic QR Code -->
            <div class="bg-white p-3 rounded-2xl border border-indigo-100 shadow-sm flex flex-col items-center flex-shrink-0">
              <div class="w-32 h-32 bg-white rounded-xl flex items-center justify-center relative border border-gray-100 p-1">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=upi%3A%2F%2Fpay%3Fpa%3Dstyleswap%40icici%26pn%3DStyleswap%2BIndia%26am%3D<%= totalAmount %>%26cu%3DINR" alt="UPI QR Code" class="w-full h-full object-contain rounded-lg">
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="w-7 h-7 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-[10px] font-extrabold text-indigo-700">₹</span>
                </div>
              </div>
              <span class="text-[11px] font-bold text-gray-600 mt-1.5 flex items-center gap-1">
                <i data-lucide="scan-line" class="w-3.5 h-3.5 text-indigo-600"></i> Scan to Pay ₹<%= Number(totalAmount).toLocaleString('en-IN') %>
              </span>
            </div>

            <!-- UPI Apps & VPA Input -->
            <div class="flex-1 space-y-3 w-full">
              <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
                <span>Supported UPI Apps:</span>
                <span class="px-2 py-0.5 bg-white rounded-md text-[10px] font-bold border border-gray-200 text-blue-600">GPay</span>
                <span class="px-2 py-0.5 bg-white rounded-md text-[10px] font-bold border border-gray-200 text-purple-600">PhonePe</span>
                <span class="px-2 py-0.5 bg-white rounded-md text-[10px] font-bold border border-gray-200 text-sky-600">Paytm</span>
                <span class="px-2 py-0.5 bg-white rounded-md text-[10px] font-bold border border-gray-200 text-orange-600">BHIM</span>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Or Enter UPI ID / VPA</label>
                <div class="flex gap-2">
                  <input 
                    type="text" 
                    id="upi-id-input"
                    name="upiId" 
                    placeholder="username@okhdfcbank" 
                    class="flex-1 bg-white border border-gray-200 rounded-xl px-3.5 py-2 text-sm focus:outline-none focus:border-indigo-600"
                  >
                  <button type="button" onclick="verifyUpi()" class="px-4 py-2 bg-indigo-50 border border-indigo-200 rounded-xl text-xs font-bold text-indigo-700 hover:bg-indigo-100 transition-colors">
                    Verify
                  </button>
                </div>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  <button type="button" onclick="fillUpiSuffix('@okhdfcbank')" class="text-[10px] font-bold px-2 py-0.5 bg-white rounded-md border border-gray-200 text-gray-600 hover:border-indigo-600">@okhdfcbank</button>
                  <button type="button" onclick="fillUpiSuffix('@okaxis')" class="text-[10px] font-bold px-2 py-0.5 bg-white rounded-md border border-gray-200 text-gray-600 hover:border-indigo-600">@okaxis</button>
                  <button type="button" onclick="fillUpiSuffix('@ybl')" class="text-[10px] font-bold px-2 py-0.5 bg-white rounded-md border border-gray-200 text-gray-600 hover:border-indigo-600">@ybl</button>
                  <button type="button" onclick="fillUpiSuffix('@paytm')" class="text-[10px] font-bold px-2 py-0.5 bg-white rounded-md border border-gray-200 text-gray-600 hover:border-indigo-600">@paytm</button>
                </div>
                <p id="upi-verify-feedback" class="text-[11px] text-emerald-600 font-semibold mt-1 hidden"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Cards Panel -->
        <div id="panel-Card" class="payment-panel hidden space-y-4">
          <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200 space-y-3.5">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Card Number (RuPay, Visa, Mastercard)</label>
              <div class="flex items-center gap-1.5">
                <span class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-[10px] font-extrabold text-blue-700">RuPay</span>
                <span class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-[10px] font-extrabold text-indigo-700">VISA</span>
                <span class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-[10px] font-extrabold text-red-600">Mastercard</span>
              </div>
            </div>
            <input 
              type="text" 
              name="cardNumber"
              maxlength="19"
              placeholder="4532 •••• •••• 8910" 
              class="w-full bg-white border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm font-mono tracking-wider focus:outline-none focus:border-gray-900"
            >
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <div class="col-span-2 sm:col-span-1">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1">Cardholder Name</label>
                <input 
                  type="text" 
                  name="cardName"
                  placeholder="Name on card" 
                  class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-gray-900"
                >
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1">Expiry</label>
                <input 
                  type="text" 
                  name="cardExpiry"
                  maxlength="5"
                  placeholder="MM / YY" 
                  class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm text-center font-mono focus:outline-none focus:border-gray-900"
                >
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mb-1">CVV</label>
                <input 
                  type="password" 
                  name="cardCvv"
                  maxlength="3"
                  placeholder="•••" 
                  class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm text-center font-mono focus:outline-none focus:border-gray-900"
                >
              </div>
            </div>
          </div>
        </div>

        <!-- 3. NetBanking Panel -->
        <div id="panel-NetBanking" class="payment-panel hidden space-y-4">
          <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200 space-y-3">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Select Bank</label>
            <div class="grid grid-cols-3 gap-2">
              <% const banks = ['SBI', 'HDFC Bank', 'ICICI Bank', 'Axis Bank', 'Kotak', 'PNB']; %>
              <% banks.forEach((b, idx) => { %>
                <label class="p-2.5 rounded-xl border border-gray-200 bg-white hover:border-gray-900 cursor-pointer flex items-center justify-center text-xs font-bold text-gray-800 text-center">
                  <input type="radio" name="bankName" value="<%= b %>" <%= idx === 0 ? 'checked' : '' %> class="mr-1.5">
                  <%= b %>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- 4. Cash on Delivery (COD) Panel -->
        <div id="panel-COD" class="payment-panel hidden space-y-4">
          <div class="bg-amber-50/80 rounded-2xl p-5 border border-amber-200 text-amber-900 space-y-2">
            <div class="flex items-center gap-2 font-bold text-sm text-amber-950">
              <i data-lucide="banknote" class="w-5 h-5 text-amber-700"></i>
              Cash / UPI on Delivery with 24-Hour Thrift Inspection
            </div>
            <p class="text-xs leading-relaxed text-amber-800">
              Pay in cash or via UPI QR to our delivery courier partner once your package arrives at your doorstep. You get full 24 hours under Styleswap Escrow Protection to check the item condition and fit.
            </p>
          </div>
        </div>

        <!-- Order Guarantee Checkbox -->
        <div class="pt-2">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" required checked class="mt-0.5 rounded border-gray-300 text-gray-900 focus:ring-gray-900">
            <span class="text-xs text-gray-600 leading-relaxed">
              I acknowledge this is a curated second-hand/thrift exchange item verified by Styleswap, covered by 24-hour buyer protection and free doorstep pickup for verified condition mismatches.
            </span>
          </label>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          id="pay-button"
          class="w-full py-4 rounded-2xl bg-gray-900 hover:bg-black text-white text-base font-extrabold flex items-center justify-center gap-2 shadow-lg hover:shadow-xl transition-all"
        >
          <i data-lucide="lock" class="w-5 h-5 text-emerald-400"></i>
          <% if (isSwapCheckout) { %>
            Pay ₹<%= Number(totalAmount).toLocaleString('en-IN') %> & Dispatch Swap Courier
          <% } else { %>
            Pay ₹<%= Number(totalAmount).toLocaleString('en-IN') %> & Confirm Order
          <% } %>
        </button>

        <div class="flex items-center justify-center gap-6 text-xs text-gray-500 pt-1">
          <span class="flex items-center gap-1"><i data-lucide="truck" class="w-4 h-4 text-gray-400"></i> Delivery via Delhivery/BlueDart</span>
          <span class="flex items-center gap-1"><i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i> 100% Escrow Insured</span>
        </div>

      </div>

    </div>

    <!-- RIGHT COLUMN: Order Summary & Item Review (5 cols) -->
    <div class="lg:col-span-5 space-y-6">

      <!-- Item Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-200 shadow-xs space-y-5 sticky top-24">
        
        <h3 class="font-display text-lg font-bold text-gray-900 pb-3 border-b border-gray-100 flex items-center justify-between">
          <span>Order Summary</span>
          <span class="text-xs font-semibold text-gray-500"><%= isSwapCheckout ? '1 Wardrobe Swap' : '1 Item' %></span>
        </h3>

        <% if (isSwapCheckout && swapTransaction) { %>
          <!-- Swap Pair Summary -->
          <div class="space-y-3">
            <div class="p-3.5 bg-indigo-50/70 rounded-2xl border border-indigo-100 flex items-center space-x-3.5">
              <div class="w-16 h-16 rounded-xl overflow-hidden bg-white flex-shrink-0 border border-indigo-100">
                <img 
                  src="<%= swapTransaction.listingId && swapTransaction.listingId.images ? swapTransaction.listingId.images[0] : '/images/placeholder-item.jpg' %>" 
                  alt="" 
                  class="w-full h-full object-cover"
                  onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
                >
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-extrabold uppercase tracking-wider text-indigo-700 block">Item You Receive</span>
                <p class="text-xs font-bold text-gray-900 truncate"><%= swapTransaction.listingId ? swapTransaction.listingId.title : 'Listing' %></p>
                <p class="text-[11px] text-gray-500">Seller: <%= swapTransaction.sellerId ? swapTransaction.sellerId.name : 'Member' %></p>
              </div>
            </div>

            <div class="flex items-center justify-center">
              <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-800 flex items-center justify-center -my-1 border-2 border-white shadow-xs">
                <i data-lucide="repeat" class="w-4 h-4"></i>
              </div>
            </div>

            <div class="p-3.5 bg-gray-50 rounded-2xl border border-gray-200 flex items-center space-x-3.5">
              <div class="w-16 h-16 rounded-xl overflow-hidden bg-white flex-shrink-0 border border-gray-200">
                <img 
                  src="<%= swapTransaction.exchangeItemId && swapTransaction.exchangeItemId.images ? swapTransaction.exchangeItemId.images[0] : '/images/placeholder-item.jpg' %>" 
                  alt="" 
                  class="w-full h-full object-cover"
                  onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
                >
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-extrabold uppercase tracking-wider text-gray-500 block">Item You Dispatch</span>
                <p class="text-xs font-bold text-gray-900 truncate"><%= swapTransaction.exchangeItemId ? swapTransaction.exchangeItemId.title : 'Listing' %></p>
                <p class="text-[11px] text-gray-500">From your wardrobe collection</p>
              </div>
            </div>
          </div>

        <% } else if (listing) { %>
          <!-- Direct Buy Single Item -->
          <div class="flex items-start space-x-4">
            <div class="w-20 h-20 rounded-2xl overflow-hidden bg-gray-100 flex-shrink-0 border border-gray-200">
              <img 
                src="<%= listing.images && listing.images.length > 0 ? listing.images[0] : '/images/placeholder-item.jpg' %>" 
                alt="<%= listing.title %>" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null;this.src='/images/placeholder-item.jpg';"
              >
            </div>
            <div class="flex-1 min-w-0">
              <span class="text-[11px] font-bold text-indigo-600 uppercase tracking-wider block"><%= listing.category ? listing.category.name : 'Thrift' %></span>
              <h4 class="text-sm font-bold text-gray-900 truncate"><%= listing.title %></h4>
              <p class="text-xs text-gray-500 mt-0.5">Size: <span class="font-semibold text-gray-800"><%= listing.size %></span> • <%= listing.condition %></p>
              <p class="text-xs text-gray-500 mt-0.5 flex items-center gap-1">
                <i data-lucide="map-pin" class="w-3 h-3 text-gray-400"></i>
                <%= listing.location || 'India' %> • <%= listing.sellerId ? listing.sellerId.name : 'Seller' %>
              </p>
            </div>
          </div>
        <% } %>

        <!-- Price Breakdown in ₹ -->
        <div class="pt-4 border-t border-gray-100 space-y-2.5 text-sm">
          <div class="flex items-center justify-between text-gray-600">
            <span><%= isSwapCheckout ? 'Cash Top-up Balance' : 'Item Resale Price' %></span>
            <span class="font-semibold text-gray-900">₹<%= Number(itemPrice).toLocaleString('en-IN') %></span>
          </div>

          <div class="flex items-center justify-between text-gray-600">
            <span class="flex items-center gap-1">
              <%= isSwapCheckout ? 'Doorstep Swap Pickup & Drop' : 'Express Delivery across India' %>
              <i data-lucide="info" class="w-3.5 h-3.5 text-gray-400" title="Insured tracked courier"></i>
            </span>
            <% if (shippingFee === 0) { %>
              <span class="font-bold text-emerald-600 uppercase text-xs tracking-wider">FREE</span>
            <% } else { %>
              <span class="font-semibold text-gray-900">₹<%= Number(shippingFee).toLocaleString('en-IN') %></span>
            <% } %>
          </div>

          <div class="flex items-center justify-between text-gray-600">
            <span class="flex items-center gap-1">
              Styleswap Thrift Protection
              <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i>
            </span>
            <span class="font-semibold text-gray-900">₹<%= Number(protectionFee).toLocaleString('en-IN') %></span>
          </div>

          <div class="pt-3 border-t border-gray-200 flex items-center justify-between">
            <div>
              <span class="text-base font-extrabold text-gray-900 block">Total Amount</span>
              <span class="text-[11px] text-gray-500">Includes all Indian taxes & GST</span>
            </div>
            <span class="text-2xl font-black text-gray-900">₹<%= Number(totalAmount).toLocaleString('en-IN') %></span>
          </div>
        </div>

        <!-- Estimated Delivery Banner -->
        <div class="p-3.5 rounded-2xl bg-gray-50 border border-gray-200 flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-white border border-gray-200 flex items-center justify-center text-gray-700 flex-shrink-0">
            <i data-lucide="calendar-check" class="w-5 h-5 text-indigo-600"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-900">Estimated Doorstep Delivery</p>
            <p class="text-xs text-gray-500"><%= new Date(estimatedDelivery).toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></p>
          </div>
        </div>

        <!-- Sustainability Impact -->
        <div class="p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-100 flex items-center space-x-3 text-emerald-900">
          <i data-lucide="leaf" class="w-5 h-5 text-emerald-600 flex-shrink-0"></i>
          <p class="text-[11px] font-medium leading-tight">
            By shopping pre-loved on Styleswap, you divert <strong>~2.4 kg</strong> of textile waste and save <strong>~7,000L</strong> of water!
          </p>
        </div>

      </div>

    </div>

  </form>

</div>

<script>
  // Payment tab switching
  const tabs = document.querySelectorAll('.payment-option-tab');
  const panels = document.querySelectorAll('.payment-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const method = tab.getAttribute('data-method');

      // Update tab styles
      tabs.forEach(t => {
        t.classList.remove('bg-gray-900', 'text-white', 'border-gray-900');
        t.classList.add('bg-gray-50', 'text-gray-900', 'border-gray-200');
        const radio = t.querySelector('input[type="radio"]');
        if (radio) radio.checked = false;
      });

      tab.classList.remove('bg-gray-50', 'border-gray-200');
      tab.classList.add('bg-gray-900', 'text-white', 'border-gray-900');
      const activeRadio = tab.querySelector('input[type="radio"]');
      if (activeRadio) activeRadio.checked = true;

      // Update panels
      panels.forEach(p => p.classList.add('hidden'));
      const activePanel = document.getElementById('panel-' + method);
      if (activePanel) activePanel.classList.remove('hidden');

      // Update button text for COD
      const payButton = document.getElementById('pay-button');
      if (payButton) {
        if (method === 'COD') {
          payButton.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 text-amber-400"></i> Place Cash on Delivery Order (₹<%= Number(totalAmount).toLocaleString("en-IN") %>)';
        } else {
          payButton.innerHTML = '<i data-lucide="lock" class="w-5 h-5 text-emerald-400"></i> Pay ₹<%= Number(totalAmount).toLocaleString("en-IN") %> & Confirm Order';
        }
        lucide.createIcons();
      }
    });
  });

  function fillUpiSuffix(suffix) {
    const input = document.getElementById('upi-id-input');
    const parts = (input.value || '').split('@');
    input.value = (parts[0] || 'user') + suffix;
  }

  function verifyUpi() {
    const input = document.getElementById('upi-id-input');
    const feedback = document.getElementById('upi-verify-feedback');
    if (!input.value || !input.value.includes('@')) {
      alert('Please enter a valid UPI ID (e.g. mobile@okhdfcbank)');
      return;
    }
    feedback.classList.remove('hidden');
    feedback.innerText = '✓ Verified: ' + input.value + ' (UPI Autopay Ready)';
  }
</script>

<%- include('../partials/footer') %>
