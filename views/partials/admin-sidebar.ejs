<aside class="w-full lg:w-64 bg-white rounded-3xl border border-[#F0ECE1] p-5 shadow-sm space-y-6 flex-shrink-0">
  <div class="flex items-center space-x-3 pb-4 border-b border-gray-100">
    <div class="w-9 h-9 rounded-xl bg-amber-600 flex items-center justify-center text-white">
      <i data-lucide="shield-alert" class="w-5 h-5"></i>
    </div>
    <div>
      <h2 class="font-bold text-gray-900 text-sm">Admin Portal</h2>
      <p class="text-xs text-amber-700 font-semibold">Moderation & Controls</p>
    </div>
  </div>

  <nav class="space-y-1">
    <a href="/admin/dashboard" class="flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition-colors <%= (typeof title !== 'undefined' && title.includes('Control Center')) ? 'bg-amber-100/70 text-amber-900 font-semibold' : 'text-gray-600 hover:bg-amber-50 hover:text-amber-800' %>">
      <i data-lucide="bar-chart-3" class="w-4 h-4 mr-3 text-amber-600"></i>
      Analytics & Overview
    </a>

    <a href="/admin/listings" class="flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition-colors <%= (typeof title !== 'undefined' && title.includes('Listing Moderation')) ? 'bg-amber-100/70 text-amber-900 font-semibold' : 'text-gray-600 hover:bg-amber-50 hover:text-amber-800' %>">
      <i data-lucide="check-square" class="w-4 h-4 mr-3 text-amber-600"></i>
      Listing Moderation
    </a>

    <a href="/admin/users" class="flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition-colors <%= (typeof title !== 'undefined' && title.includes('User Management')) ? 'bg-amber-100/70 text-amber-900 font-semibold' : 'text-gray-600 hover:bg-amber-50 hover:text-amber-800' %>">
      <i data-lucide="users" class="w-4 h-4 mr-3 text-amber-600"></i>
      User Management
    </a>

    <a href="/admin/categories" class="flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition-colors <%= (typeof title !== 'undefined' && title.includes('Category Management')) ? 'bg-amber-100/70 text-amber-900 font-semibold' : 'text-gray-600 hover:bg-amber-50 hover:text-amber-800' %>">
      <i data-lucide="folder-tree" class="w-4 h-4 mr-3 text-amber-600"></i>
      Categories
    </a>

    <a href="/admin/transactions" class="flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition-colors <%= (typeof title !== 'undefined' && title.includes('Transactions')) ? 'bg-amber-100/70 text-amber-900 font-semibold' : 'text-gray-600 hover:bg-amber-50 hover:text-amber-800' %>">
      <i data-lucide="receipt" class="w-4 h-4 mr-3 text-amber-600"></i>
      Transactions & Trades
    </a>
  </nav>

  <div class="pt-4 border-t border-gray-100 space-y-3">
    <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider px-3.5">Export Reports (CSV)</p>
    <div class="space-y-1 text-xs">
      <a href="/admin/export/users" class="flex items-center justify-between px-3.5 py-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors">
        <span>Users Database</span>
        <i data-lucide="download" class="w-3.5 h-3.5 text-gray-400"></i>
      </a>
      <a href="/admin/export/listings" class="flex items-center justify-between px-3.5 py-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors">
        <span>Listings Report</span>
        <i data-lucide="download" class="w-3.5 h-3.5 text-gray-400"></i>
      </a>
      <a href="/admin/export/transactions" class="flex items-center justify-between px-3.5 py-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors">
        <span>Transactions Log</span>
        <i data-lucide="download" class="w-3.5 h-3.5 text-gray-400"></i>
      </a>
    </div>
  </div>

  <div class="pt-4 border-t border-gray-100">
    <a href="/" class="flex items-center px-3.5 py-2 text-xs font-semibold text-gray-500 hover:text-amber-700">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-2"></i>
      Back to Marketplace
    </a>
  </div>
</aside>
