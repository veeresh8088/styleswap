<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center space-x-8">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-11 h-11 rounded-xl bg-gray-900 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform duration-200">
            <i data-lucide="repeat" class="w-6 h-6 text-amber-400"></i>
          </div>
          <div>
            <span class="font-display font-extrabold text-xl tracking-tight text-gray-900 block leading-tight">Styleswap</span>
            <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-700 block">India's Second-Hand & Thrift Exchange</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center space-x-6">
          <a href="/listings" class="text-sm font-semibold text-gray-700 hover:text-gray-900 transition-colors flex items-center gap-1.5">
            <i data-lucide="grid" class="w-4 h-4 text-gray-500"></i>
            Thrift Collection
          </a>
          <a href="/listings?type=exchange" class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition-colors flex items-center gap-1.5">
            <i data-lucide="shuffle" class="w-4 h-4 text-indigo-600"></i>
            Swap & Trade
          </a>
          <a href="/about" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
            How It Works
          </a>
        </nav>
      </div>

      <!-- Quick Search Bar -->
      <div class="hidden lg:flex flex-1 max-w-md mx-8">
        <form action="/listings" method="GET" class="w-full relative">
          <input 
            type="text" 
            name="search" 
            placeholder="Search thrifted Levi's, hoodies, sneakers, jackets in ₹..." 
            value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
            class="w-full bg-gray-50 border border-gray-200 rounded-full py-2.5 pl-11 pr-4 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900/10 focus:border-gray-900 transition-all"
          >
          <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </div>
        </form>
      </div>

      <!-- User Auth & Action Buttons -->
      <div class="flex items-center space-x-4">
        <!-- List Item CTA -->
        <a href="/listings/create" class="hidden sm:inline-flex items-center space-x-2 bg-gray-900 hover:bg-black text-white text-sm font-semibold px-4 py-2.5 rounded-full shadow-xs hover:shadow transition-all duration-200">
          <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i>
          <span>+ Sell or Swap Item</span>
        </a>

        <% if (currentUser) { %>
          <!-- User Dropdown Menu -->
          <div class="relative">
            <button id="user-menu-btn" type="button" class="flex items-center space-x-2.5 p-1.5 rounded-full hover:bg-gray-100 border border-gray-200 transition-colors focus:outline-none">
              <img src="<%= currentUser.profileImage || '/images/default-avatar.png' %>" alt="<%= currentUser.name %>" class="w-8 h-8 rounded-full object-cover border border-gray-300">
              <span class="hidden md:inline-block text-sm font-semibold text-gray-800 max-w-[120px] truncate"><%= currentUser.name %></span>
              <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400"></i>
            </button>

            <!-- Dropdown Menu Box -->
            <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-60 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
              <div class="px-4 py-2.5 border-b border-gray-100">
                <p class="text-[10px] text-gray-400 uppercase tracking-wider font-bold">Signed in as</p>
                <p class="text-sm font-bold text-gray-900 truncate"><%= currentUser.email %></p>
                <% if (currentUser.role === 'admin') { %>
                  <span class="inline-flex items-center px-2 py-0.5 mt-1 rounded text-xs font-semibold bg-gray-100 text-gray-800">
                    <i data-lucide="shield-check" class="w-3 h-3 mr-1"></i> Administrator
                  </span>
                <% } %>
              </div>

              <div class="py-1">
                <a href="/user/dashboard" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors font-medium">
                  <i data-lucide="layout-dashboard" class="w-4 h-4 mr-3 text-gray-500"></i>
                  My Dashboard
                </a>
                <a href="/user/dashboard#listings" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors font-medium">
                  <i data-lucide="tag" class="w-4 h-4 mr-3 text-gray-500"></i>
                  My Wardrobe Listings
                </a>
                <a href="/user/dashboard#exchanges" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors font-medium">
                  <i data-lucide="repeat" class="w-4 h-4 mr-3 text-indigo-600"></i>
                  Swap Proposals
                </a>
                <a href="/user/profile" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors font-medium">
                  <i data-lucide="user-cog" class="w-4 h-4 mr-3 text-gray-500"></i>
                  Profile & Address
                </a>
              </div>

              <% if (currentUser.role === 'admin') { %>
                <div class="border-t border-gray-100 py-1 bg-gray-50/80">
                  <a href="/admin" class="flex items-center px-4 py-2 text-sm font-bold text-gray-900 hover:bg-gray-100 transition-colors">
                    <i data-lucide="shield" class="w-4 h-4 mr-3 text-amber-600"></i>
                    Admin Portal
                  </a>
                </div>
              <% } %>

              <div class="border-t border-gray-100 pt-1">
                <a href="/auth/logout" class="flex items-center px-4 py-2 text-sm text-rose-600 hover:bg-rose-50 transition-colors font-medium">
                  <i data-lucide="log-out" class="w-4 h-4 mr-3"></i>
                  Sign Out
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- Guest Login / Sign Up -->
          <div class="flex items-center space-x-2">
            <a href="/auth/login" class="text-sm font-semibold text-gray-700 hover:text-gray-900 px-3.5 py-2 rounded-lg hover:bg-gray-100 transition-colors">
              Sign In
            </a>
            <a href="/auth/register" class="text-sm font-semibold text-gray-900 border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-full shadow-xs transition-colors">
              Join Free
            </a>
          </div>
        <% } %>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" type="button" class="md:hidden p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white px-4 pt-3 pb-5 space-y-3">
    <form action="/listings" method="GET" class="w-full relative mb-3">
      <input 
        type="text" 
        name="search" 
        placeholder="Search thrifted jeans, hoodies, sneakers in ₹..." 
        class="w-full bg-gray-50 border border-gray-200 rounded-full py-2 pl-10 pr-4 text-sm text-gray-900"
      >
      <div class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
        <i data-lucide="search" class="w-4 h-4"></i>
      </div>
    </form>
    <a href="/listings" class="block text-sm font-medium text-gray-700 hover:text-gray-900 py-1">Thrift Collection</a>
    <a href="/listings?type=exchange" class="block text-sm font-medium text-gray-700 hover:text-indigo-600 py-1">Swap & Trade Hub</a>
    <a href="/listings/create" class="block text-sm font-semibold text-gray-900 py-1">+ Sell or Swap an Item</a>
    <a href="/about" class="block text-sm font-medium text-gray-700 hover:text-gray-900 py-1">How It Works</a>
  </div>
</header>
