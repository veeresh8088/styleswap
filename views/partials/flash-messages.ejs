<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash-alert flex items-center justify-between p-4 mb-4 text-sm font-medium text-emerald-900 bg-emerald-50 border border-emerald-200 rounded-2xl shadow-sm transition-opacity duration-300">
      <div class="flex items-center space-x-3">
        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 flex-shrink-0"></i>
        <span><%= success %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash-alert flex items-center justify-between p-4 mb-4 text-sm font-medium text-rose-900 bg-rose-50 border border-rose-200 rounded-2xl shadow-sm transition-opacity duration-300">
      <div class="flex items-center space-x-3">
        <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <% if (typeof info !== 'undefined' && info && info.length > 0) { %>
    <div class="flash-alert flex items-center justify-between p-4 mb-4 text-sm font-medium text-amber-900 bg-amber-50 border border-amber-200 rounded-2xl shadow-sm transition-opacity duration-300">
      <div class="flex items-center space-x-3">
        <i data-lucide="info" class="w-5 h-5 text-amber-600 flex-shrink-0"></i>
        <span><%= info %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-amber-500 hover:text-amber-700 p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>
</div>
