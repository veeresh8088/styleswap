<%- include('partials/header') %>

<div class="max-w-3xl mx-auto px-4 py-20 text-center">
  <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-amber-50 border-2 border-amber-200 text-amber-600 mb-8 shadow-sm">
    <% if (statusCode === 404) { %>
      <i data-lucide="map-pin-off" class="w-12 h-12 text-amber-600"></i>
    <% } else if (statusCode === 403) { %>
      <i data-lucide="shield-x" class="w-12 h-12 text-rose-600"></i>
    <% } else { %>
      <i data-lucide="alert-triangle" class="w-12 h-12 text-amber-600"></i>
    <% } %>
  </div>

  <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-amber-100 text-amber-800 mb-4">
    Status <%= statusCode || 500 %>
  </span>

  <h1 class="font-display text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
    <%= typeof title !== 'undefined' ? title : 'Something went wrong' %>
  </h1>

  <p class="text-gray-600 max-w-md mx-auto mb-8 leading-relaxed">
    <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
  </p>

  <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
    <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-full btn-gold text-sm font-semibold shadow-sm">
      <i data-lucide="home" class="w-4 h-4 mr-2"></i>
      Return to Marketplace
    </a>
    <a href="/listings" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-full bg-white border border-gray-300 text-gray-700 text-sm font-semibold hover:bg-gray-50">
      <i data-lucide="compass" class="w-4 h-4 mr-2"></i>
      Browse Thai Wares
    </a>
  </div>
</div>

<%- include('partials/footer') %>
